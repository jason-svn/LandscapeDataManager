<Page
    x:Class="WWP.LandscapeDataManager.App.TreeSearcher.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:WWP.LandscapeDataManager.SharedUI"
    xmlns:local="using:WWP.LandscapeDataManager.App.TreeSearcher">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="{StaticResource LimPageMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Text="Tree Searcher" Style="{StaticResource LimPageTitleStyle}" />
                <TextBlock
                    Text="Select one or more Planting instances or types in Revit, then load them here — each distinct type becomes a row. Every row is auto-matched to the cached i-Tree species catalogue by family name first; anything unmatched can be searched and assigned manually."
                    Style="{StaticResource LimPageSubtitleStyle}" />
            </StackPanel>
            <Button Grid.Column="1" Content="Settings" Click="OpenSettings_Click" Style="{StaticResource LimSecondaryButtonStyle}" VerticalAlignment="Top" />
        </Grid>

        <Border Grid.Row="1" Margin="0,16,0,0" Style="{StaticResource LimCardStyle}">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="1" Content="Load selected trees" Click="LoadSelectedTrees_Click" Style="{StaticResource LimSecondaryButtonStyle}" />
                <Button Grid.Column="2"
                        Content="Select all trees in project"
                        Click="LoadAllTrees_Click"
                        ToolTipService.ToolTip="Loads every distinct Planting type in the project, regardless of the current Revit selection."
                        Style="{StaticResource LimSecondaryButtonStyle}" />
                <Button Grid.Column="3"
                        Content="Push codes to Airtable"
                        Click="PushSpeciesCodes_Click"
                        ToolTipService.ToolTip="Matches every Planting type with an assigned species code to its Airtable record (by Species Code, falling back to Family + Type name) and writes the code into that record's Species Code column."
                        Style="{StaticResource LimSecondaryButtonStyle}" />
                <Button Grid.Column="4"
                        x:Name="AssignAllButton"
                        Content="Assign all matched"
                        Click="AssignAll_Click"
                        IsEnabled="False"
                        Style="{StaticResource LimPrimaryButtonStyle}" />
            </Grid>
        </Border>

        <TextBlock Grid.Row="2" x:Name="RowsCountText" Margin="0,12,0,6" Style="{StaticResource LimMutedTextStyle}" />

        <!-- Selected trees: the species-matching columns sit in a swim lane behind the header and rows. -->
        <Grid Grid.Row="3" Grid.RowSpan="2">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Grid Grid.RowSpan="3" Style="{StaticResource LimTableLanesStyle}" ui:TableLanes.FollowRows="True">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="80" /><ColumnDefinition Width="110" /><ColumnDefinition Width="240" /><ColumnDefinition Width="90" /></Grid.ColumnDefinitions>
                <Border Grid.Column="2" Grid.ColumnSpan="2" Style="{StaticResource LimTableLaneStyle}" Background="{ThemeResource LimLaneBlueBrush}" />
            </Grid>
            <Grid Style="{StaticResource LimTableGroupRowStyle}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="80" /><ColumnDefinition Width="110" /><ColumnDefinition Width="240" /><ColumnDefinition Width="90" /></Grid.ColumnDefinitions>
                <TextBlock Grid.Column="2" Grid.ColumnSpan="2" Text="SPECIES MATCH" Style="{StaticResource LimTableGroupStyle}" Foreground="{ThemeResource LimLaneBlueTextBrush}" />
            </Grid>
            <Grid Grid.Row="1" Style="{StaticResource LimTableHeaderRowStyle}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="80" /><ColumnDefinition Width="110" /><ColumnDefinition Width="240" /><ColumnDefinition Width="90" /></Grid.ColumnDefinitions>
                <TextBlock Text="Family : Type" Style="{StaticResource LimTableHeaderStyle}" />
                <TextBlock Grid.Column="1" Text="Current&#x0a;code" Style="{StaticResource LimTableHeaderStyle}" />
                <TextBlock Grid.Column="2" Text="Status" Style="{StaticResource LimTableHeaderStyle}" />
                <TextBlock Grid.Column="3" Text="Species&#x0a;search by name or code" Style="{StaticResource LimTableHeaderStyle}" />
            </Grid>
            <ListView Grid.Row="2" x:Name="RowsList" ItemsSource="{x:Bind Rows}" SelectionMode="None" ItemContainerStyle="{StaticResource LimTableItemStyle}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:TreeAssignmentRow">
                        <Grid Style="{StaticResource LimTableRowStyle}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="80" /><ColumnDefinition Width="110" /><ColumnDefinition Width="240" /><ColumnDefinition Width="90" /></Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind DisplayName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind DisplayName}" />
                            <TextBlock Grid.Column="1" Text="{x:Bind CurrentSpeciesCode, Mode=OneWay}" Opacity="0.75" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2"
                                       Text="{x:Bind MatchStatus, Mode=OneWay}"
                                       Foreground="{x:Bind MatchStatusBrush, Mode=OneWay}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap" />
                            <AutoSuggestBox Grid.Column="3"
                                            Text="{x:Bind SearchQuery, Mode=TwoWay}"
                                            PlaceholderText="Search species by name or code..."
                                            ItemsSource="{x:Bind SearchResults, Mode=OneWay}"
                                            DisplayMemberPath="Display"
                                            ToolTipService.ToolTip="{x:Bind SearchQuery, Mode=OneWay}"
                                            TextChanged="RowSearchBox_TextChanged"
                                            SuggestionChosen="RowSearchBox_SuggestionChosen"
                                            QuerySubmitted="RowSearchBox_QuerySubmitted" />
                            <Button Grid.Column="4" Content="Assign" Click="RowAssign_Click" Style="{StaticResource LimSecondaryButtonStyle}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <TextBlock Grid.Row="5"
                   x:Name="StatusText"
                   Margin="0,12,0,0"
                   Text="Select trees in Revit, then click &quot;Load selected trees&quot;."
                   Style="{StaticResource LimMutedTextStyle}"
                   TextTrimming="CharacterEllipsis" />

        <TextBlock Grid.Row="6"
                   x:Name="CatalogueStatusText"
                   Margin="0,4,0,0"
                   Style="{StaticResource LimMutedTextStyle}"
                   TextTrimming="CharacterEllipsis" />

        <ProgressRing x:Name="BusyIndicator"
                      Grid.RowSpan="7"
                      Width="40"
                      Height="40"
                      IsActive="False"
                      Visibility="Collapsed"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center" />
    </Grid>
</Page>
