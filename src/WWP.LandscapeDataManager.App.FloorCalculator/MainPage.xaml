<Page
    x:Class="WWP.LandscapeDataManager.App.FloorCalculator.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WWP.LandscapeDataManager.App.FloorCalculator">

    <ScrollViewer>
        <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="{StaticResource LimPageMargin}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="500" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Spacing="4">
                <TextBlock Text="Floor Calculator" Style="{StaticResource LimPageTitleStyle}" />
                <TextBlock
                    Text="Select one or more Floor instances in Revit, then load them here. Each floor is auto-matched to the WWP landscape data sheet by family name; results are the sheet's per-square-metre coefficients times the floor's area (except the two temperature-reduction fields, which are intrinsic to the type). Click &quot;Review...&quot; on a row to check a value manually before calculating — there's no separate override parameter in Revit; editing a value here is the entire mechanism."
                    Style="{StaticResource LimPageSubtitleStyle}" />
            </StackPanel>

            <!-- Step 1: WWP landscape data sheet sync -->
            <Border Grid.Row="1" Margin="0,16,0,0" Style="{StaticResource LimCardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="STEP 1 — WWP LANDSCAPE DATA SHEET" Style="{StaticResource LimSectionHeaderStyle}" />
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <PasswordBox x:Name="ApiTokenBox" Header="Airtable personal access token" />
                        <CheckBox Grid.Column="1" x:Name="RememberTokenCheckBox" Content="Remember" IsChecked="True" VerticalAlignment="Bottom" Margin="0,0,0,8" />
                    </Grid>
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="BaseIdBox" Header="Base ID" />
                        <TextBox Grid.Column="1" x:Name="TableIdBox" Header="Table ID or name" />
                        <TextBox Grid.Column="2" x:Name="ViewIdBox" Header="View (optional)" />
                    </Grid>
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="CatalogueStatusText" VerticalAlignment="Center" Style="{StaticResource LimMutedTextStyle}" TextWrapping="Wrap" />
                        <Button Grid.Column="1" Content="Sync coefficient data" Click="Sync_Click" Style="{StaticResource LimSecondaryButtonStyle}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Step 2: load & assign -->
            <Border Grid.Row="2" Margin="0,16,0,0" Style="{StaticResource LimCardStyle}">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="STEP 2 — MATCH &amp; CALCULATE" Style="{StaticResource LimSectionHeaderStyle}" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="Load selected floors" Click="LoadSelectedFloors_Click" Style="{StaticResource LimSecondaryButtonStyle}" />
                    <Button Grid.Column="2"
                            x:Name="CalculateAllButton"
                            Content="Calculate all matched"
                            Click="CalculateAll_Click"
                            IsEnabled="False"
                            Style="{StaticResource LimPrimaryButtonStyle}" />
                </Grid>
            </Border>

            <TextBlock Grid.Row="3" x:Name="RowsCountText" Margin="0,12,0,6" Style="{StaticResource LimMutedTextStyle}" />

            <Grid Grid.Row="4" Padding="8,0" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Family Name : Type Name" Style="{StaticResource LimColumnHeaderStyle}" />
                <TextBlock Grid.Column="1" Text="Area" Style="{StaticResource LimColumnHeaderStyle}" />
                <TextBlock Grid.Column="2" Text="Status" Style="{StaticResource LimColumnHeaderStyle}" />
                <TextBlock Grid.Column="3" Text="Landscape Type" Style="{StaticResource LimColumnHeaderStyle}" />
            </Grid>

            <ListView Grid.Row="5" x:Name="RowsList" ItemsSource="{x:Bind Rows}" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:FloorAssignmentRow">
                        <Grid Padding="8,7" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="260" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind DisplayName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind DisplayName}" />
                            <TextBlock Grid.Column="1" Text="{x:Bind AreaDisplay}" Opacity="0.75" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2"
                                       Text="{x:Bind MatchStatus, Mode=OneWay}"
                                       Foreground="{x:Bind MatchStatusBrush, Mode=OneWay}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap" />
                            <AutoSuggestBox Grid.Column="3"
                                            Text="{x:Bind SearchQuery, Mode=TwoWay}"
                                            PlaceholderText="Search landscape type..."
                                            ItemsSource="{x:Bind SearchResults, Mode=OneWay}"
                                            DisplayMemberPath="Display"
                                            ToolTipService.ToolTip="{x:Bind SearchQuery, Mode=OneWay}"
                                            TextChanged="RowSearchBox_TextChanged"
                                            SuggestionChosen="RowSearchBox_SuggestionChosen"
                                            QuerySubmitted="RowSearchBox_QuerySubmitted" />
                            <Button Grid.Column="4" Content="Review..." Click="ReviewValues_Click" Style="{StaticResource LimSecondaryButtonStyle}" />
                            <Button Grid.Column="5" Content="Calculate" Click="RowCalculate_Click" Style="{StaticResource LimSecondaryButtonStyle}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock Grid.Row="6"
                       x:Name="StatusText"
                       Margin="0,12,0,0"
                       Text="Select floors in Revit, then click &quot;Load selected floors&quot;."
                       Style="{StaticResource LimMutedTextStyle}"
                       TextWrapping="Wrap" />

            <ProgressRing x:Name="BusyIndicator"
                          Grid.RowSpan="7"
                          Width="40"
                          Height="40"
                          IsActive="False"
                          Visibility="Collapsed"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />

            <ContentDialog x:Name="MetricsDialog" CloseButtonText="Done" DefaultButton="Close">
                <StackPanel Spacing="10" MinWidth="480">
                    <TextBlock
                        Text="Check &quot;Manual&quot; and type a value to use it instead of the coefficient table's number for that metric."
                        Style="{StaticResource LimMutedTextStyle}"
                        TextWrapping="Wrap" />
                    <ListView ItemsSource="{x:Bind EditingMetrics}" SelectionMode="None" MaxHeight="360">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:FloorMetricEntry">
                                <Grid Padding="4,6" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="130" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Label}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind ComputedDisplay, Mode=OneWay}" Opacity="0.75" VerticalAlignment="Center" />
                                    <CheckBox Grid.Column="2" Content="Manual" IsChecked="{x:Bind IsManual, Mode=TwoWay}" />
                                    <TextBox Grid.Column="3" Text="{x:Bind ManualValue, Mode=TwoWay}" IsEnabled="{x:Bind IsManual, Mode=OneWay}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </ContentDialog>
        </Grid>
    </ScrollViewer>
</Page>
