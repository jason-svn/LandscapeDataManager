<Page
    x:Class="WWP.LandscapeDataManager.App.FloorCalculator.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:WWP.LandscapeDataManager.SharedUI"
    xmlns:local="using:WWP.LandscapeDataManager.App.FloorCalculator">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="{StaticResource LimPageMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="Floor Calculator" Style="{StaticResource LimPageTitleStyle}" />

        <!-- Two calculators over the same floors: WWP landscape data sheet benefits, and BNG habitat units. -->
        <Pivot Grid.Row="1" x:Name="CalculatorTabs" SelectionChanged="CalculatorTabs_SelectionChanged">
            <PivotItem Header="Benefit coefficients">
                <Grid Padding="0,12,0,0" SizeChanged="CoefficientLayout_SizeChanged">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Configuration can scroll independently without consuming the result viewport. -->
                    <ScrollViewer x:Name="CoefficientSetupScroller" MaxHeight="260" HorizontalScrollBarVisibility="Auto">
                        <Grid MinWidth="1100" Width="{Binding ViewportWidth, ElementName=CoefficientSetupScroller}" Padding="0,0,20,20">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Spacing="4">
                                <TextBlock
                                    Text="Select one or more Floor instances in Revit, then load them here. Each floor is auto-matched to the WWP landscape data sheet by family name; results are the sheet's per-square-metre coefficients times the floor's area (except the two temperature-reduction fields, which are intrinsic to the type). Click &quot;Review...&quot; on a row to check a value manually before calculating — there's no separate override parameter in Revit; editing a value here is the entire mechanism."
                                    Style="{StaticResource LimPageSubtitleStyle}" />
                            </StackPanel>

                            <!-- Step 1: WWP landscape data sheet sync -->
                            <Border Grid.Row="1" Margin="0,16,0,0" Style="{StaticResource LimCardStyle}">
                                <StackPanel Spacing="10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="STEP 1 — WWP LANDSCAPE DATA SHEET" Style="{StaticResource LimSectionHeaderStyle}" VerticalAlignment="Center" />
                                        <Button Grid.Column="1" Content="Settings" Click="OpenSettings_Click" Style="{StaticResource LimSecondaryButtonStyle}" />
                                    </Grid>
                                    <TextBlock x:Name="SourceStatusText" Style="{StaticResource LimMutedTextStyle}" TextWrapping="Wrap" />
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="CatalogueStatusText" VerticalAlignment="Center" Style="{StaticResource LimMutedTextStyle}" TextWrapping="Wrap" />
                                        <Button Grid.Column="1" Content="Sync coefficient data" Click="Sync_Click" Style="{StaticResource LimSecondaryButtonStyle}" />
                                    </Grid>
                                </StackPanel>
                            </Border>



                        </Grid>
                    </ScrollViewer>

                    <!-- Step 2: load & assign -->
                    <Border Grid.Row="1" Margin="0,16,0,0" Style="{StaticResource LimCardStyle}">
                        <Grid ColumnSpacing="10" RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="STEP 2 — MATCH &amp; CALCULATE" Style="{StaticResource LimSectionHeaderStyle}" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="Load selected floors" Click="LoadSelectedFloors_Click" Style="{StaticResource LimSecondaryButtonStyle}" />
                            <Button Grid.Column="2" Content="Load all floors" Click="LoadAllFloors_Click" Style="{StaticResource LimSecondaryButtonStyle}" />
                            <Button Grid.Column="3"
                                x:Name="CalculateAllButton"
                                Content="Calculate all matched"
                                Click="CalculateAll_Click"
                                IsEnabled="False"
                                Style="{StaticResource LimPrimaryButtonStyle}" />
                            <CheckBox Grid.Row="1" Grid.ColumnSpan="3" x:Name="FillTreesCheckBox" IsChecked="True"
                                Content="Also fill trees from the sheet: estimate the ones i-Tree hasn't calculated, and add pollen for every tree"
                                ToolTipService.ToolTip="A tree with no i-Tree result (no species code, missing or invalid inputs, an API error) gets the sheet's per-tree CO₂e, oxygen, runoff, pollutants and money saved, marked Estimated. Trees with i-Tree results keep them; i-Tree replaces an estimate once the tree is calculated." />
                            <Button Grid.Row="1" Grid.Column="3" Content="Fill trees from sheet" Click="FillTrees_Click" Style="{StaticResource LimSecondaryButtonStyle}"
                                HorizontalAlignment="Stretch"
                                ToolTipService.ToolTip="Only the trees: estimate the ones i-Tree hasn't calculated, and add pollen for every tree." />
                        </Grid>
                    </Border>

                    <TextBlock Grid.Row="2" x:Name="RowsCountText" Margin="0,12,0,6" Style="{StaticResource LimMutedTextStyle}" />

                    <!-- Horizontal scrolling moves the header and rows together; ListView owns vertical scrolling. -->
                    <ScrollViewer Grid.Row="3" HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Disabled" VerticalScrollMode="Disabled">
                        <Grid MinWidth="1100">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Grid.RowSpan="2">
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <Grid Grid.RowSpan="3" Style="{StaticResource LimTableLanesStyle}" ui:TableLanes.FollowRows="True">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="80" /><ColumnDefinition Width="130" /><ColumnDefinition Width="260" /><ColumnDefinition Width="100" /><ColumnDefinition Width="100" /></Grid.ColumnDefinitions>
                                    <Border Grid.Column="2" Grid.ColumnSpan="2" Style="{StaticResource LimTableLaneStyle}" Background="{ThemeResource LimLaneBlueBrush}" />
                                </Grid>
                                <Grid Style="{StaticResource LimTableGroupRowStyle}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="80" /><ColumnDefinition Width="130" /><ColumnDefinition Width="260" /><ColumnDefinition Width="100" /><ColumnDefinition Width="100" /></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="2" Grid.ColumnSpan="2" Text="LANDSCAPE TYPE" Style="{StaticResource LimTableGroupStyle}" Foreground="{ThemeResource LimLaneBlueTextBrush}" />
                                </Grid>
                                <Grid Grid.Row="1" Style="{StaticResource LimTableHeaderRowStyle}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="80" /><ColumnDefinition Width="130" /><ColumnDefinition Width="260" /><ColumnDefinition Width="100" /><ColumnDefinition Width="100" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Family : Type" Style="{StaticResource LimTableHeaderStyle}" />
                                    <TextBlock Grid.Column="1" Text="Area&#x0a;m²" Style="{StaticResource LimTableNumberHeaderStyle}" />
                                    <TextBlock Grid.Column="2" Text="Status" Style="{StaticResource LimTableHeaderStyle}" />
                                    <TextBlock Grid.Column="3" Text="Match" Style="{StaticResource LimTableHeaderStyle}" />
                                </Grid>
                                <ListView Grid.Row="2" x:Name="RowsList" AutomationProperties.Name="Floor coefficient assignments" ItemsSource="{x:Bind Rows}" SelectionMode="None" ItemContainerStyle="{StaticResource LimTableItemStyle}">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="local:FloorAssignmentRow">
                                            <Grid Style="{StaticResource LimTableRowStyle}">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="80" /><ColumnDefinition Width="130" /><ColumnDefinition Width="260" /><ColumnDefinition Width="100" /><ColumnDefinition Width="100" /></Grid.ColumnDefinitions>
                                                <TextBlock Text="{x:Bind DisplayName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind DisplayName}" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind AreaDisplay}" TextAlignment="Right" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2"
                                                    Text="{x:Bind MatchStatus, Mode=OneWay}"
                                                    Foreground="{x:Bind MatchStatusBrush, Mode=OneWay}"
                                                    FontWeight="SemiBold"
                                                    VerticalAlignment="Center"
                                                    TextWrapping="Wrap" />
                                                <AutoSuggestBox Grid.Column="3"
                                                    Text="{x:Bind SearchQuery, Mode=TwoWay}"
                                                    PlaceholderText="Search landscape type..."
                                                    ItemsSource="{x:Bind SearchResults, Mode=OneWay}"
                                                    DisplayMemberPath="Display"
                                                    ToolTipService.ToolTip="{x:Bind SearchQuery, Mode=OneWay}"
                                                    TextChanged="RowSearchBox_TextChanged"
                                                    SuggestionChosen="RowSearchBox_SuggestionChosen"
                                                    QuerySubmitted="RowSearchBox_QuerySubmitted" />
                                                <Button Grid.Column="4" Content="Review..." Click="ReviewValues_Click" Style="{StaticResource LimSecondaryButtonStyle}" />
                                                <Button Grid.Column="5" Content="Calculate" Click="RowCalculate_Click" Style="{StaticResource LimSecondaryButtonStyle}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>

                        </Grid>
                    </ScrollViewer>

                    <TextBlock Grid.Row="4"
                        x:Name="StatusText"
                        Margin="0,12,0,0"
                        Text="Select floors in Revit, then click &quot;Load selected floors&quot;."
                        Style="{StaticResource LimMutedTextStyle}"
                        TextWrapping="Wrap" />

                    <ProgressRing x:Name="BusyIndicator"
                        Grid.RowSpan="5"
                        Width="40"
                        Height="40"
                        IsActive="False"
                        Visibility="Collapsed"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />

                    <ContentDialog x:Name="MetricsDialog" CloseButtonText="Done" DefaultButton="Close">
                        <StackPanel Spacing="10" MinWidth="480">
                            <TextBlock
                                Text="Check &quot;Manual&quot; and type a value to use it instead of the coefficient table's number for that metric."
                                Style="{StaticResource LimMutedTextStyle}"
                                TextWrapping="Wrap" />
                            <ListView ItemsSource="{x:Bind EditingMetrics}" SelectionMode="None" MaxHeight="360">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:FloorMetricEntry">
                                        <Grid Padding="4,6" ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="170" />
                                                <ColumnDefinition Width="130" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="130" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind Label}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind ComputedDisplay, Mode=OneWay}" Opacity="0.75" VerticalAlignment="Center" />
                                            <CheckBox Grid.Column="2" Content="Manual" IsChecked="{x:Bind IsManual, Mode=TwoWay}" />
                                            <TextBox Grid.Column="3" Text="{x:Bind ManualValue, Mode=TwoWay}" IsEnabled="{x:Bind IsManual, Mode=OneWay}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </ContentDialog>
                </Grid>
            </PivotItem>

            <PivotItem Header="Biodiversity (BNG)">
                <local:BngTab x:Name="BngTabContent" />
            </PivotItem>
        </Pivot>
    </Grid>
</Page>
