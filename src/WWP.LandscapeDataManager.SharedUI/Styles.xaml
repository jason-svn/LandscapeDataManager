<!--
  Shared visual language for all LIM tool windows: a calm, minimal, shadcn-inspired look
  translated to native Fluent/WinUI controls (shadcn/ui itself is a React+Tailwind web library
  and cannot run inside a WinUI3 desktop app). Neutral surfaces, one restrained accent color,
  generous whitespace, soft 1px borders instead of heavy shadows, quiet typography.

  This file is not a project — it is linked (MSBuild <Page Include=".../SharedUI/Styles.xaml"
  Link="Styles.xaml" />) into every tool exe project so there is one source of truth to edit,
  without fighting Windows App SDK's lack of reliable XAML-class-library support.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives">

    <!-- Status is always accompanied by text. Contrast themes use the user's system palette. -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="LimAccentBrush" Color="#FF00A6A6" />
            <SolidColorBrush x:Key="LimSuccessBrush" Color="#FF1A7F37" />
            <SolidColorBrush x:Key="LimWarningBrush" Color="#FF9D5300" />
            <SolidColorBrush x:Key="LimErrorBrush" Color="#FFC4262E" />
            <SolidColorBrush x:Key="LimNeutralBrush" Color="#FF616161" />
            <SolidColorBrush x:Key="LimInfoBrush" Color="#FF007F7F" />
            <SolidColorBrush x:Key="LimLaneGreenBrush" Color="#16176B2B" />
            <SolidColorBrush x:Key="LimLaneBlueBrush" Color="#162F6FB0" />
            <SolidColorBrush x:Key="LimLaneAmberBrush" Color="#1AA36A00" />
            <SolidColorBrush x:Key="LimLaneGreyBrush" Color="#12586359" />
            <SolidColorBrush x:Key="LimLaneVioletBrush" Color="#166B4FA0" />
            <SolidColorBrush x:Key="LimLaneTealBrush" Color="#16007A70" />
            <SolidColorBrush x:Key="LimLaneGreenTextBrush" Color="#FF176B2B" />
            <SolidColorBrush x:Key="LimLaneBlueTextBrush" Color="#FF2F6FB0" />
            <SolidColorBrush x:Key="LimLaneAmberTextBrush" Color="#FFA36A00" />
            <SolidColorBrush x:Key="LimLaneGreyTextBrush" Color="#FF586359" />
            <SolidColorBrush x:Key="LimLaneVioletTextBrush" Color="#FF6B4FA0" />
            <SolidColorBrush x:Key="LimLaneTealTextBrush" Color="#FF00756B" />
            <SolidColorBrush x:Key="LimTableDividerBrush" Color="#FFDDE4DA" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="LimAccentBrush" Color="#FF57D4D4" />
            <SolidColorBrush x:Key="LimSuccessBrush" Color="#FF83D99A" />
            <SolidColorBrush x:Key="LimWarningBrush" Color="#FFF4BE70" />
            <SolidColorBrush x:Key="LimErrorBrush" Color="#FFFF99A0" />
            <SolidColorBrush x:Key="LimNeutralBrush" Color="#FFC5C5C5" />
            <SolidColorBrush x:Key="LimInfoBrush" Color="#FF57D4D4" />
            <SolidColorBrush x:Key="LimLaneGreenBrush" Color="#33309A45" />
            <SolidColorBrush x:Key="LimLaneBlueBrush" Color="#333E86CC" />
            <SolidColorBrush x:Key="LimLaneAmberBrush" Color="#33C98A00" />
            <SolidColorBrush x:Key="LimLaneGreyBrush" Color="#1FB4C2B7" />
            <SolidColorBrush x:Key="LimLaneVioletBrush" Color="#338C6FD0" />
            <SolidColorBrush x:Key="LimLaneTealBrush" Color="#3330B5A8" />
            <SolidColorBrush x:Key="LimLaneGreenTextBrush" Color="#FF8EDB9B" />
            <SolidColorBrush x:Key="LimLaneBlueTextBrush" Color="#FF78B5ED" />
            <SolidColorBrush x:Key="LimLaneAmberTextBrush" Color="#FFF4BE70" />
            <SolidColorBrush x:Key="LimLaneGreyTextBrush" Color="#FFB4C2B7" />
            <SolidColorBrush x:Key="LimLaneVioletTextBrush" Color="#FFC3B1F0" />
            <SolidColorBrush x:Key="LimLaneTealTextBrush" Color="#FF7FD8CC" />
            <SolidColorBrush x:Key="LimTableDividerBrush" Color="#FF455249" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="LimAccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="LimSuccessBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="LimWarningBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="LimErrorBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="LimNeutralBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="LimInfoBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="LimLaneGreenBrush" Color="Transparent" />
            <SolidColorBrush x:Key="LimLaneBlueBrush" Color="Transparent" />
            <SolidColorBrush x:Key="LimLaneAmberBrush" Color="Transparent" />
            <SolidColorBrush x:Key="LimLaneGreyBrush" Color="Transparent" />
            <SolidColorBrush x:Key="LimLaneVioletBrush" Color="Transparent" />
            <SolidColorBrush x:Key="LimLaneTealBrush" Color="Transparent" />
            <SolidColorBrush x:Key="LimLaneGreenTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="LimLaneBlueTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="LimLaneAmberTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="LimLaneGreyTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="LimLaneVioletTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="LimLaneTealTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="LimTableDividerBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Scrollbars: a persistent, rounded handle with an 18px drag target. Keep the native
         ScrollBar parts so WinUI still owns thumb sizing, dragging, arrows, and page clicks.
         ScrollViewer continues to decide whether each axis needs a scrollbar. -->
    <x:Double x:Key="LimScrollBarSize">18</x:Double>
    <x:Double x:Key="LimScrollBarThumbMinLength">40</x:Double>
    <Thickness x:Key="LimScrollBarThumbInset">3</Thickness>
    <CornerRadius x:Key="LimScrollBarThumbCornerRadius">6</CornerRadius>

    <Style x:Key="LimScrollBarThumbStyle" TargetType="primitives:Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="primitives:Thumb">
                    <Grid Background="Transparent">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="ThumbVisual.Background" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="ThumbVisual.Background" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="ThumbVisual.Background" Value="{ThemeResource ScrollBarThumbFillDisabled}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border x:Name="ThumbVisual"
                                Margin="{StaticResource LimScrollBarThumbInset}"
                                CornerRadius="{StaticResource LimScrollBarThumbCornerRadius}"
                                Background="{ThemeResource ScrollBarThumbFill}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LimScrollBarPageButtonStyle" TargetType="primitives:RepeatButton">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="AllowFocusOnInteraction" Value="False" />
        <Setter Property="Interval" Value="50" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="primitives:RepeatButton">
                    <Grid Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LimScrollBarArrowButtonStyle" TargetType="primitives:RepeatButton"
           BasedOn="{StaticResource LimScrollBarPageButtonStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="primitives:RepeatButton">
                    <Border x:Name="ArrowBackground" Background="Transparent" CornerRadius="4">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="ArrowBackground.Background" Value="{ThemeResource ControlFillColorSecondaryBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="ArrowBackground.Background" Value="{ThemeResource ControlFillColorTertiaryBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="ArrowBackground.Opacity" Value="0.4" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          Foreground="{TemplateBinding Foreground}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="primitives:ScrollBar" BasedOn="{StaticResource DefaultScrollBarStyle}">
        <Setter Property="MinWidth" Value="{StaticResource LimScrollBarSize}" />
        <Setter Property="MinHeight" Value="{StaticResource LimScrollBarSize}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="primitives:ScrollBar">
                    <Grid x:Name="ScrollBarRoot" Background="Transparent">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="ScrollBarRoot.Opacity" Value="0.4" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <!-- All input modes keep the same visible, draggable thumb. -->
                            <VisualStateGroup x:Name="ScrollingIndicatorStates">
                                <VisualState x:Name="NoIndicator" />
                                <VisualState x:Name="TouchIndicator" />
                                <VisualState x:Name="MouseIndicator" />
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="ExpansionStates">
                                <VisualState x:Name="Collapsed" />
                                <VisualState x:Name="Expanded" />
                                <VisualState x:Name="CollapsedWithoutAnimation" />
                                <VisualState x:Name="ExpandedWithoutAnimation" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <Grid x:Name="HorizontalRoot" Height="{StaticResource LimScrollBarSize}"
                              Background="{ThemeResource ControlFillColorSecondaryBrush}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <primitives:RepeatButton x:Name="HorizontalSmallDecrease" Grid.Column="0"
                                                     Width="{StaticResource LimScrollBarSize}" Height="{StaticResource LimScrollBarSize}"
                                                     Style="{StaticResource LimScrollBarArrowButtonStyle}">
                                <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE76B;" FontSize="10" />
                            </primitives:RepeatButton>
                            <primitives:RepeatButton x:Name="HorizontalLargeDecrease" Grid.Column="1" Width="0"
                                                     Style="{StaticResource LimScrollBarPageButtonStyle}" />
                            <primitives:Thumb x:Name="HorizontalThumb" Grid.Column="2"
                                              Height="{StaticResource LimScrollBarSize}" MinWidth="{StaticResource LimScrollBarThumbMinLength}"
                                              Style="{StaticResource LimScrollBarThumbStyle}" AutomationProperties.AccessibilityView="Raw" />
                            <primitives:RepeatButton x:Name="HorizontalLargeIncrease" Grid.Column="3"
                                                     Style="{StaticResource LimScrollBarPageButtonStyle}" />
                            <primitives:RepeatButton x:Name="HorizontalSmallIncrease" Grid.Column="4"
                                                     Width="{StaticResource LimScrollBarSize}" Height="{StaticResource LimScrollBarSize}"
                                                     Style="{StaticResource LimScrollBarArrowButtonStyle}">
                                <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE76C;" FontSize="10" />
                            </primitives:RepeatButton>
                        </Grid>

                        <Grid x:Name="VerticalRoot" Width="{StaticResource LimScrollBarSize}"
                              Background="{ThemeResource ControlFillColorSecondaryBrush}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <primitives:RepeatButton x:Name="VerticalSmallDecrease" Grid.Row="0"
                                                     Width="{StaticResource LimScrollBarSize}" Height="{StaticResource LimScrollBarSize}"
                                                     Style="{StaticResource LimScrollBarArrowButtonStyle}">
                                <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE70E;" FontSize="10" />
                            </primitives:RepeatButton>
                            <primitives:RepeatButton x:Name="VerticalLargeDecrease" Grid.Row="1" Height="0"
                                                     Style="{StaticResource LimScrollBarPageButtonStyle}" />
                            <primitives:Thumb x:Name="VerticalThumb" Grid.Row="2"
                                              Width="{StaticResource LimScrollBarSize}" MinHeight="{StaticResource LimScrollBarThumbMinLength}"
                                              Style="{StaticResource LimScrollBarThumbStyle}" AutomationProperties.AccessibilityView="Raw" />
                            <primitives:RepeatButton x:Name="VerticalLargeIncrease" Grid.Row="3"
                                                     Style="{StaticResource LimScrollBarPageButtonStyle}" />
                            <primitives:RepeatButton x:Name="VerticalSmallIncrease" Grid.Row="4"
                                                     Width="{StaticResource LimScrollBarSize}" Height="{StaticResource LimScrollBarSize}"
                                                     Style="{StaticResource LimScrollBarArrowButtonStyle}">
                                <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE70D;" FontSize="10" />
                            </primitives:RepeatButton>
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Typography: one clear hierarchy, reused instead of ad-hoc FontSize/Weight per page. -->
    <Style x:Key="LimPageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="LimPageSubtitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Opacity" Value="0.7" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="LimSectionHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Opacity" Value="0.65" />
    </Style>
    <Style x:Key="LimMutedTextStyle" TargetType="TextBlock">
        <Setter Property="Opacity" Value="0.7" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="LimColumnHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Opacity" Value="0.55" />
    </Style>

    <!-- Data tables: one language in every tool. Columns that belong together sit in a vertical
         swim lane, a pale wash running behind the header and every row, with the lane's name in
         capitals above it. Each column header is its name on top and its unit or qualifier
         underneath (Text="Area&#x0a;m²"), bottom-aligned, so cells hold plain values. The lane
         grid, the two header grids and every row repeat one set of ColumnDefinitions and share
         LimTable*Style padding and spacing, so they line up exactly; the 26px right padding keeps
         an 18px gutter for the list's vertical scrollbar, which would otherwise sit on the last column. In a ListView use
         LimTableItemStyle: the default item padding (16,0,12,0) would push rows off the header. -->
    <Style x:Key="LimTableLanesStyle" TargetType="Grid">
        <Setter Property="ColumnSpacing" Value="14" />
        <Setter Property="Padding" Value="8,0,26,0" />
    </Style>
    <Style x:Key="LimTableLaneStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Margin" Value="-4,0" />
    </Style>
    <Style x:Key="LimTableGroupRowStyle" TargetType="Grid">
        <Setter Property="ColumnSpacing" Value="14" />
        <Setter Property="Padding" Value="8,10,26,0" />
    </Style>
    <Style x:Key="LimTableHeaderRowStyle" TargetType="Grid">
        <Setter Property="ColumnSpacing" Value="14" />
        <Setter Property="Padding" Value="8,6,26,8" />
    </Style>
    <Style x:Key="LimTableRowStyle" TargetType="Grid">
        <Setter Property="ColumnSpacing" Value="14" />
        <Setter Property="Padding" Value="8,7,26,7" />
        <Setter Property="BorderBrush" Value="{ThemeResource LimTableDividerBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
    </Style>
    <Style x:Key="LimTableGroupStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="100" />
        <Setter Property="Foreground" Value="{ThemeResource LimLaneGreyTextBrush}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="LimTableHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="100" />
        <Setter Property="Foreground" Value="{ThemeResource LimLaneGreyTextBrush}" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="LineHeight" Value="15" />
        <Setter Property="TextWrapping" Value="WrapWholeWords" />
    </Style>
    <Style x:Key="LimTableNumberHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource LimTableHeaderStyle}">
        <Setter Property="TextAlignment" Value="Right" />
    </Style>
    <Style x:Key="LimTableItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <!-- SelectionMode="Multiple" draws a 28px check box before each row: use LimTableCheckItemStyle
         for its items and give the lane and header grids LimTableCheckOffset (28 + 8 clearance). -->
    <Thickness x:Key="LimTableCheckOffset">36,0,0,0</Thickness>
    <Style x:Key="LimTableCheckItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource LimTableItemStyle}">
        <Setter Property="Padding" Value="8,0,0,0" />
    </Style>

    <!-- Card: the one structural container every tool uses for a grouped section. -->
    <Style x:Key="LimCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="20" />
    </Style>

    <!-- Card-shaped toggle: a filter/selector card that behaves like LimCardStyle visually but is a
         real ToggleButton, so it is keyboard-reachable, invokable with Enter/Space, and exposes a
         Toggle automation pattern — unlike a Border with a Tapped handler. -->
    <Style x:Key="LimCardToggleButtonStyle" TargetType="ToggleButton">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="10" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="CardBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="CardBorder.Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="CardBorder.Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="CardBorder.Opacity" Value="0.5" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualState x:Name="Unchecked" />
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="CardBorder.BorderBrush" Value="{ThemeResource LimAccentBrush}" />
                                        <Setter Target="CardBorder.BorderThickness" Value="2" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Buttons: exactly one primary action per screen; everything else is a plain/secondary button. -->
    <Style x:Key="LimPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="Padding" Value="20,10" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style x:Key="LimSecondaryButtonStyle" TargetType="Button">
        <Setter Property="Padding" Value="16,9" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>

    <!-- Consistent page padding so every tool's root layout looks like one family of windows. -->
    <Thickness x:Key="LimPageMargin">28,24,28,24</Thickness>
</ResourceDictionary>
