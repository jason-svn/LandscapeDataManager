<Page
    x:Class="WWP.LandscapeDataManager.App.Parameters.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:WWP.LandscapeDataManager.SharedUI"
    xmlns:models="using:WWP.LandscapeDataManager.App.Parameters">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="{StaticResource LimPageMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Text="Import Shared Parameter" Style="{StaticResource LimPageTitleStyle}" />
                <TextBlock
                    Text="Creates and validates the Project Information and Planting parameter bindings the LIM workflow needs. Safe to run again — it never duplicates a parameter, and reports anything it can't safely change."
                    Style="{StaticResource LimPageSubtitleStyle}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                <Button Content="Save shared parameter file…"
                        Click="SaveSharedParameterFile_Click"
                        Style="{StaticResource LimSecondaryButtonStyle}"
                        ToolTipService.ToolTip="Save every LIM parameter, with the same GUIDs this tool binds, as a Revit shared parameter file, to add one by hand somewhere this tool doesn't reach, such as a tag family. It doesn't need Revit or Load parameters." />
                <Button Content="Settings" Click="OpenSettings_Click" Style="{StaticResource LimSecondaryButtonStyle}" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Margin="0,20,0,0" Spacing="10">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="LoadButton"
                        Content="Load parameters"
                        Click="LoadParameters_Click"
                        HorizontalAlignment="Stretch"
                        Style="{StaticResource LimSecondaryButtonStyle}" />
                <Button x:Name="ApplyButton"
                        Grid.Column="1"
                        Content="Apply changes"
                        Click="Apply_Click"
                        IsEnabled="False"
                        HorizontalAlignment="Stretch"
                        Style="{StaticResource LimPrimaryButtonStyle}" />
            </Grid>
            <TextBlock x:Name="StatusText"
                       Text="Click Load parameters to compare this project with the parameter catalog built into this LIM version. No Revit values are touched until you click Apply."
                       Style="{StaticResource LimMutedTextStyle}" />
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,20,0,10" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource LimCardStyle}">
                <StackPanel Spacing="4">
                    <TextBlock Text="WILL CREATE" Style="{StaticResource LimSectionHeaderStyle}" />
                    <TextBlock x:Name="PendingCountText" Text="—" FontSize="22" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource LimCardStyle}">
                <StackPanel Spacing="4">
                    <TextBlock Text="CREATED" Style="{StaticResource LimSectionHeaderStyle}" />
                    <TextBlock x:Name="CreatedCountText" Text="—" FontSize="22" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource LimCardStyle}">
                <StackPanel Spacing="4">
                    <TextBlock Text="ALREADY VALID" Style="{StaticResource LimSectionHeaderStyle}" />
                    <TextBlock x:Name="ValidCountText" Text="—" FontSize="22" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
            <Border Grid.Column="3" Style="{StaticResource LimCardStyle}">
                <StackPanel Spacing="4">
                    <TextBlock Text="NEEDS ATTENTION" Style="{StaticResource LimSectionHeaderStyle}" />
                    <TextBlock x:Name="AttentionCountText" Text="—" FontSize="22" FontWeight="SemiBold" Foreground="{ThemeResource LimWarningBrush}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Parameter table: what each parameter is, then what setup did with it, each in a swim lane. -->
        <Grid Grid.Row="3" Grid.RowSpan="2">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Grid Grid.RowSpan="3" Style="{StaticResource LimTableLanesStyle}" ui:TableLanes.FollowRows="True">
                <Grid.ColumnDefinitions><ColumnDefinition Width="36" /><ColumnDefinition Width="*" /><ColumnDefinition Width="90" /><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource LimTableLaneStyle}" Background="{ThemeResource LimLaneBlueBrush}" />
                <Border Grid.Column="3" Grid.ColumnSpan="2" Style="{StaticResource LimTableLaneStyle}" Background="{ThemeResource LimLaneGreenBrush}" />
            </Grid>
            <Grid Style="{StaticResource LimTableGroupRowStyle}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="36" /><ColumnDefinition Width="*" /><ColumnDefinition Width="90" /><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Grid.Column="1" Grid.ColumnSpan="2" Text="SHARED PARAMETER" Style="{StaticResource LimTableGroupStyle}" Foreground="{ThemeResource LimLaneBlueTextBrush}" />
                <TextBlock Grid.Column="3" Grid.ColumnSpan="2" Text="RESULT" Style="{StaticResource LimTableGroupStyle}" Foreground="{ThemeResource LimLaneGreenTextBrush}" />
            </Grid>
            <Grid Grid.Row="1" Style="{StaticResource LimTableHeaderRowStyle}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="36" /><ColumnDefinition Width="*" /><ColumnDefinition Width="90" /><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Grid.Column="1" Text="Name" Style="{StaticResource LimTableHeaderStyle}" />
                <TextBlock Grid.Column="2" Text="Scope" Style="{StaticResource LimTableHeaderStyle}" />
                <TextBlock Grid.Column="3" Text="Status" Style="{StaticResource LimTableHeaderStyle}" />
                <TextBlock Grid.Column="4" Text="Message" Style="{StaticResource LimTableHeaderStyle}" />
            </Grid>
            <ListView Grid.Row="2" ItemsSource="{x:Bind ResultRows}" SelectionMode="None" ItemContainerStyle="{StaticResource LimTableItemStyle}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:SetupRow">
                        <Grid Style="{StaticResource LimTableRowStyle}" ToolTipService.ToolTip="{x:Bind Description}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="36" /><ColumnDefinition Width="*" /><ColumnDefinition Width="90" /><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <CheckBox IsChecked="{x:Bind IsIncluded, Mode=TwoWay}" MinWidth="0" />
                            <TextBlock Grid.Column="1" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{x:Bind Scope}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="{x:Bind Status, Mode=OneWay}" FontWeight="SemiBold" Foreground="{x:Bind StatusBrush, Mode=OneWay}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="4" Text="{x:Bind Message, Mode=OneWay}" Opacity="0.75" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <ProgressRing x:Name="BusyIndicator"
                      Grid.RowSpan="5"
                      Width="40"
                      Height="40"
                      IsActive="False"
                      Visibility="Collapsed"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center" />
    </Grid>
</Page>
