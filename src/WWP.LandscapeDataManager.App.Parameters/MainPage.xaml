<Page
    x:Class="WWP.LandscapeDataManager.App.Parameters.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:WWP.LandscapeDataManager.App.Parameters">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="{StaticResource LimPageMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="Shared Parameter Setup" Style="{StaticResource LimPageTitleStyle}" />
            <TextBlock
                Text="Creates and validates the Project Information and Planting parameter bindings the LIM workflow needs. Safe to run again — it never duplicates a parameter, and reports anything it can't safely change."
                Style="{StaticResource LimPageSubtitleStyle}" />
        </StackPanel>

        <Border Grid.Row="1" Margin="0,20,0,0" Style="{StaticResource LimCardStyle}">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SharedParameterFilePathBox"
                         Header="Shared parameter file"
                         PlaceholderText="Select the Revit shared parameter .txt file" />
                <Button Grid.Column="1"
                        Content="Browse..."
                        Click="BrowseSharedParameterFile_Click"
                        VerticalAlignment="Bottom"
                        Style="{StaticResource LimSecondaryButtonStyle}" />
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Margin="0,20,0,0" Spacing="10">
            <Button x:Name="RunButton"
                    Content="Check &amp; set up parameters"
                    Click="Run_Click"
                    Style="{StaticResource LimPrimaryButtonStyle}" />
            <TextBlock x:Name="StatusText"
                       Text="Select a shared parameter file, then run the check. No Revit values are changed unless a binding is missing."
                       Style="{StaticResource LimMutedTextStyle}" />
        </StackPanel>

        <Grid Grid.Row="3" Margin="0,20,0,10" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource LimCardStyle}">
                <StackPanel Spacing="4">
                    <TextBlock Text="CREATED" Style="{StaticResource LimSectionHeaderStyle}" />
                    <TextBlock x:Name="CreatedCountText" Text="—" FontSize="22" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource LimCardStyle}">
                <StackPanel Spacing="4">
                    <TextBlock Text="ALREADY VALID" Style="{StaticResource LimSectionHeaderStyle}" />
                    <TextBlock x:Name="ValidCountText" Text="—" FontSize="22" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource LimCardStyle}">
                <StackPanel Spacing="4">
                    <TextBlock Text="NEEDS ATTENTION" Style="{StaticResource LimSectionHeaderStyle}" />
                    <TextBlock x:Name="AttentionCountText" Text="—" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource LimWarningBrush}" />
                </StackPanel>
            </Border>
        </Grid>

        <ListView Grid.Row="4" ItemsSource="{x:Bind ResultRows}" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:SetupRow">
                    <Grid Padding="8,7" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind Status}" FontWeight="SemiBold" Foreground="{x:Bind StatusBrush}" />
                        <TextBlock Grid.Column="1" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="2" Text="{x:Bind Scope}" />
                        <TextBlock Grid.Column="3" Text="{x:Bind Message}" Opacity="0.75" TextWrapping="Wrap" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <ProgressRing x:Name="BusyIndicator"
                      Grid.RowSpan="5"
                      Width="40"
                      Height="40"
                      IsActive="False"
                      Visibility="Collapsed"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center" />
    </Grid>
</Page>
