<Page
    x:Class="WWP.LandscapeDataManager.App.Parameters.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:WWP.LandscapeDataManager.App.Parameters">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="{StaticResource LimPageMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="Shared Parameter Setup" Style="{StaticResource LimPageTitleStyle}" />
            <TextBlock
                Text="Creates and validates the Project Information and Planting parameter bindings the LIM workflow needs. Safe to run again — it never duplicates a parameter, and reports anything it can't safely change."
                Style="{StaticResource LimPageSubtitleStyle}" />
        </StackPanel>

        <Border Grid.Row="1" Margin="0,20,0,0" Style="{StaticResource LimCardStyle}">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SharedParameterFilePathBox"
                         Header="Shared parameter file"
                         PlaceholderText="Select the Revit shared parameter .txt file" />
                <Button Grid.Column="1"
                        Content="Browse..."
                        Click="BrowseSharedParameterFile_Click"
                        VerticalAlignment="Bottom"
                        Style="{StaticResource LimSecondaryButtonStyle}" />
                <Button Grid.Column="2"
                        Content="Import settings..."
                        Click="ImportSettings_Click"
                        VerticalAlignment="Bottom"
                        Margin="8,0,0,0"
                        Style="{StaticResource LimSecondaryButtonStyle}" />
                <Button Grid.Column="3"
                        Content="Export settings..."
                        Click="ExportSettings_Click"
                        VerticalAlignment="Bottom"
                        Margin="8,0,0,0"
                        Style="{StaticResource LimSecondaryButtonStyle}" />
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Margin="0,20,0,0" Spacing="10">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="LoadButton"
                        Content="Load parameters"
                        Click="LoadParameters_Click"
                        HorizontalAlignment="Stretch"
                        Style="{StaticResource LimSecondaryButtonStyle}" />
                <Button x:Name="ApplyButton"
                        Grid.Column="1"
                        Content="Apply changes"
                        Click="Apply_Click"
                        IsEnabled="False"
                        HorizontalAlignment="Stretch"
                        Style="{StaticResource LimPrimaryButtonStyle}" />
            </Grid>
            <TextBlock x:Name="StatusText"
                       Text="Select a shared parameter file, then click Load parameters to review what would change. No Revit values are touched until you click Apply."
                       Style="{StaticResource LimMutedTextStyle}" />
        </StackPanel>

        <Grid Grid.Row="3" Margin="0,20,0,10" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource LimCardStyle}">
                <StackPanel Spacing="4">
                    <TextBlock Text="WILL CREATE" Style="{StaticResource LimSectionHeaderStyle}" />
                    <TextBlock x:Name="PendingCountText" Text="—" FontSize="22" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource LimCardStyle}">
                <StackPanel Spacing="4">
                    <TextBlock Text="CREATED" Style="{StaticResource LimSectionHeaderStyle}" />
                    <TextBlock x:Name="CreatedCountText" Text="—" FontSize="22" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource LimCardStyle}">
                <StackPanel Spacing="4">
                    <TextBlock Text="ALREADY VALID" Style="{StaticResource LimSectionHeaderStyle}" />
                    <TextBlock x:Name="ValidCountText" Text="—" FontSize="22" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
            <Border Grid.Column="3" Style="{StaticResource LimCardStyle}">
                <StackPanel Spacing="4">
                    <TextBlock Text="NEEDS ATTENTION" Style="{StaticResource LimSectionHeaderStyle}" />
                    <TextBlock x:Name="AttentionCountText" Text="—" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource LimWarningBrush}" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="4" Padding="8,0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="36" />
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="1" Text="Status" Style="{StaticResource LimColumnHeaderStyle}" />
            <TextBlock Grid.Column="2" Text="Parameter Name" Style="{StaticResource LimColumnHeaderStyle}" />
            <TextBlock Grid.Column="3" Text="Scope" Style="{StaticResource LimColumnHeaderStyle}" />
            <TextBlock Grid.Column="4" Text="Message" Style="{StaticResource LimColumnHeaderStyle}" />
        </Grid>

        <ListView Grid.Row="5" ItemsSource="{x:Bind ResultRows}" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:SetupRow">
                    <Grid Padding="8,7" ColumnSpacing="12" ToolTipService.ToolTip="{x:Bind Description}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <CheckBox IsChecked="{x:Bind IsIncluded, Mode=TwoWay}" />
                        <TextBlock Grid.Column="1" Text="{x:Bind Status, Mode=OneWay}" FontWeight="SemiBold" Foreground="{x:Bind StatusBrush, Mode=OneWay}" />
                        <TextBlock Grid.Column="2" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="3" Text="{x:Bind Scope}" />
                        <TextBlock Grid.Column="4" Text="{x:Bind Message, Mode=OneWay}" Opacity="0.75" TextWrapping="Wrap" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <ProgressRing x:Name="BusyIndicator"
                      Grid.RowSpan="6"
                      Width="40"
                      Height="40"
                      IsActive="False"
                      Visibility="Collapsed"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center" />
    </Grid>
</Page>
