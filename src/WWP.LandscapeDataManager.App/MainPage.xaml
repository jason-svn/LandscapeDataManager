<Page
    x:Class="WWP.LandscapeDataManager.App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:WWP.LandscapeDataManager.App.Models">

    <Page.Resources>
        <Style x:Key="SummaryCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
            <Setter Property="Padding" Value="18,9" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
    </Page.Resources>

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="24,18" Background="{StaticResource EgisBlueBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2">
                    <TextBlock Text="WWP Landscape Data Manager"
                               Foreground="White"
                               FontSize="24"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Airtable synchronization, model review, calculations and quality control"
                               Foreground="#CCDDE8EE"
                               FontSize="13" />
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right" Spacing="2">
                    <TextBlock x:Name="RevitConnectionText"
                               Text="Connecting to Revit…"
                               Foreground="White"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Right" />
                    <TextBlock x:Name="DocumentText"
                               Text="No active document"
                               Foreground="#CCDDE8EE"
                               HorizontalAlignment="Right" />
                </StackPanel>
            </Grid>
        </Border>

        <InfoBar x:Name="StatusBar"
                 Grid.Row="1"
                 Margin="20,12,20,0"
                 IsOpen="False"
                 IsClosable="True" />

        <TabView Grid.Row="2" Margin="20,12,20,20" IsAddTabButtonVisible="False">
            <TabViewItem Header="Sync &amp; Review" IsClosable="False">
                <Grid Padding="4,12,4,4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="BaseIdBox"
                                 Header="Airtable base ID"
                                 PlaceholderText="app…" />
                        <TextBox x:Name="TableNameBox"
                                 Grid.Column="1"
                                 Header="Table"
                                 Text="Dataset" />
                        <ToggleSwitch x:Name="PrimaryOptionsToggle"
                                      Grid.Column="2"
                                      Header="Design options"
                                      OnContent="Primary only"
                                      OffContent="All"
                                      IsOn="True"
                                      VerticalAlignment="Bottom" />
                        <Button Grid.Column="3"
                                Content="Test connection"
                                Click="TestConnection_Click"
                                VerticalAlignment="Bottom"
                                Padding="16,9" />
                        <Button Grid.Column="4"
                                Content="Scan Revit"
                                Click="ScanRevit_Click"
                                VerticalAlignment="Bottom"
                                Padding="16,9" />
                        <Button Grid.Column="5"
                                Content="Sync &amp; scan"
                                Click="SyncAndScan_Click"
                                Style="{StaticResource PrimaryButtonStyle}"
                                VerticalAlignment="Bottom" />
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,18,0,16" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource SummaryCardStyle}">
                            <StackPanel Spacing="4">
                                <TextBlock Text="REVIT TYPES" Opacity="0.65" FontSize="11" FontWeight="SemiBold" />
                                <TextBlock x:Name="TypeCountText" Text="—" FontSize="24" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource SummaryCardStyle}">
                            <StackPanel Spacing="4">
                                <TextBlock Text="ELEMENTS" Opacity="0.65" FontSize="11" FontWeight="SemiBold" />
                                <TextBlock x:Name="ElementCountText" Text="—" FontSize="24" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource SummaryCardStyle}">
                            <StackPanel Spacing="4">
                                <TextBlock Text="FLOOR AREA" Opacity="0.65" FontSize="11" FontWeight="SemiBold" />
                                <TextBlock x:Name="FloorAreaText" Text="—" FontSize="24" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="3" Style="{StaticResource SummaryCardStyle}">
                            <StackPanel Spacing="4">
                                <TextBlock Text="NEEDS REVIEW" Opacity="0.65" FontSize="11" FontWeight="SemiBold" />
                                <TextBlock x:Name="ReviewCountText" Text="—" FontSize="24" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="2" Padding="12,8" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="150" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="STATUS" FontSize="11" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="CATEGORY" FontSize="11" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="2" Text="REVIT TYPE" FontSize="11" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="3" Text="COUNT" FontSize="11" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="4" Text="AREA (m²)" FontSize="11" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="5" Text="CALCULATION TYPE" FontSize="11" FontWeight="SemiBold" />
                    </Grid>

                    <ListView Grid.Row="3"
                              ItemsSource="{x:Bind ReviewItems}"
                              SelectionMode="None"
                              IsItemClickEnabled="False">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:ReviewRow">
                                <Grid Padding="12,9">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="150" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Status}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Category}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind TypeName}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind Quantity}" />
                                    <TextBlock Grid.Column="4" Text="{x:Bind Area}" />
                                    <TextBlock Grid.Column="5" Text="{x:Bind CalculationType}" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </TabViewItem>

            <TabViewItem Header="Parameter Mapper" IsClosable="False">
                <Grid Padding="4,12,4,4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="3">
                            <TextBlock Text="Airtable → Revit parameter mapping"
                                       FontSize="22"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="MapperStatusText"
                                       Text="Load the Airtable headers and active-model parameters to begin."
                                       Opacity="0.7" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="Load catalogs"
                                Click="LoadMapper_Click"
                                Padding="16,9"
                                VerticalAlignment="Center" />
                        <Button Grid.Column="2"
                                Content="Auto-map WWP"
                                Click="AutoMap_Click"
                                Padding="16,9"
                                VerticalAlignment="Center" />
                        <Button Grid.Column="3"
                                Content="Add mapping"
                                Click="AddMapping_Click"
                                Padding="16,9"
                                VerticalAlignment="Center" />
                        <Button Grid.Column="4"
                                Content="Save mappings"
                                Click="SaveMappings_Click"
                                Style="{StaticResource PrimaryButtonStyle}"
                                VerticalAlignment="Center" />
                    </Grid>

                    <InfoBar Grid.Row="1"
                             Margin="0,14,0,14"
                             IsOpen="True"
                             IsClosable="False"
                             Severity="Informational"
                             Title="Mapping only"
                             Message="Mappings are stored locally and do not modify the Revit model. Read-only parameters are excluded." />

                    <Grid Grid.Row="2" Padding="12,8" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="1.5*" />
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="80" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="USE" FontSize="11" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="AIRTABLE COLUMN" FontSize="11" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="2" Text="REVIT PARAMETER / SCOPE / STORAGE" FontSize="11" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="3" Text="CONVERSION" FontSize="11" FontWeight="SemiBold" />
                    </Grid>

                    <ListView Grid.Row="3"
                              ItemsSource="{x:Bind MappingRows}"
                              SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:MappingRow">
                                <Grid Padding="8,7" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="1.2*" />
                                        <ColumnDefinition Width="1.5*" />
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="70" />
                                    </Grid.ColumnDefinitions>
                                    <ToggleSwitch IsOn="{x:Bind Enabled, Mode=TwoWay}" />
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{x:Bind SourceOptions}"
                                              SelectedItem="{x:Bind SelectedAirtableField, Mode=TwoWay}"
                                              PlaceholderText="Select Airtable column"
                                              HorizontalAlignment="Stretch" />
                                    <ComboBox Grid.Column="2"
                                              ItemsSource="{x:Bind TargetOptions}"
                                              SelectedItem="{x:Bind SelectedTarget, Mode=TwoWay}"
                                              DisplayMemberPath="DisplayName"
                                              PlaceholderText="Select Revit parameter"
                                              HorizontalAlignment="Stretch" />
                                    <ComboBox Grid.Column="3"
                                              ItemsSource="{x:Bind ConversionOptions}"
                                              SelectedItem="{x:Bind SelectedConversion, Mode=TwoWay}"
                                              HorizontalAlignment="Stretch" />
                                    <Button Grid.Column="4"
                                            Content="Remove"
                                            Tag="{x:Bind}"
                                            Click="RemoveMapping_Click"
                                            HorizontalAlignment="Right" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </TabViewItem>

            <TabViewItem Header="Calculations" IsClosable="False">
                <Grid Padding="28">
                    <StackPanel MaxWidth="620" HorizontalAlignment="Left" Spacing="12">
                        <TextBlock Text="Environmental calculations" FontSize="22" FontWeight="SemiBold" />
                        <TextBlock TextWrapping="Wrap"
                                   Text="This area will calculate CO₂ sequestration, oxygen, retained water, pollutants, maintenance cost and cost savings after the Airtable-to-Revit parameter map has been approved." />
                        <InfoBar IsOpen="True"
                                 IsClosable="False"
                                 Severity="Informational"
                                 Title="Read-only foundation"
                                 Message="No model parameters are written by this build." />
                    </StackPanel>
                </Grid>
            </TabViewItem>

            <TabViewItem Header="Quality Control" IsClosable="False">
                <Grid Padding="28">
                    <StackPanel MaxWidth="680" HorizontalAlignment="Left" Spacing="14">
                        <TextBlock Text="Synchronization quality" FontSize="22" FontWeight="SemiBold" />
                        <TextBlock Text="Matched" FontWeight="SemiBold" />
                        <TextBlock Text="The normalized Revit type name exists in the Airtable dataset." Opacity="0.75" />
                        <TextBlock Text="Missing" FontWeight="SemiBold" />
                        <TextBlock Text="No Airtable record matches the Revit type; review an alias or database entry." Opacity="0.75" />
                        <TextBlock Text="Not checked" FontWeight="SemiBold" />
                        <TextBlock Text="The model was scanned without downloading Airtable records." Opacity="0.75" />
                    </StackPanel>
                </Grid>
            </TabViewItem>

            <TabViewItem Header="Settings" IsClosable="False">
                <Grid Padding="28">
                    <StackPanel MaxWidth="680" HorizontalAlignment="Left" Spacing="12">
                        <TextBlock Text="Security and deployment" FontSize="22" FontWeight="SemiBold" />
                        <TextBlock TextWrapping="Wrap"
                                   Text="The Airtable token is never stored in the source code or UI settings. Set WWP_AIRTABLE_TOKEN as a Windows user environment variable, then restart Revit." />
                        <TextBlock TextWrapping="Wrap"
                                   Text="Optionally set WWP_AIRTABLE_BASE_ID to prefill the base ID. The table defaults to Dataset." />
                    </StackPanel>
                </Grid>
            </TabViewItem>
        </TabView>

        <ProgressRing x:Name="BusyIndicator"
                      Grid.RowSpan="3"
                      Width="44"
                      Height="44"
                      IsActive="False"
                      Visibility="Collapsed"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center" />
    </Grid>
</Page>
