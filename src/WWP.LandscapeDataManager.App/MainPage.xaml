<Page
    x:Class="WWP.LandscapeDataManager.App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:WWP.LandscapeDataManager.Shared.Models">

    <Page.Resources>
        <Style x:Key="SummaryCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
            <Setter Property="Padding" Value="18,9" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
    </Page.Resources>

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="24,18" Background="{StaticResource EgisBlueBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="14">
                    <Border Width="60"
                            Height="60"
                            Padding="5"
                            Background="White"
                            CornerRadius="10">
                        <Image Source="ms-appx:///Assets/LIM-logo.png"
                               Stretch="Uniform" />
                    </Border>
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="LIM- LANDSCAPE DATA"
                                   Foreground="White"
                                   FontSize="24"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="Landscape data synchronization, model review, calculations and quality control"
                                   Foreground="#CCDDE8EE"
                                   FontSize="13" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right" Spacing="2">
                    <TextBlock x:Name="RevitConnectionText"
                               Text="Connecting to Revit…"
                               Foreground="White"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Right" />
                    <TextBlock x:Name="DocumentText"
                               Text="No active document"
                               Foreground="#CCDDE8EE"
                               HorizontalAlignment="Right" />
                </StackPanel>
            </Grid>
        </Border>

        <InfoBar x:Name="StatusBar"
                 Grid.Row="1"
                 Margin="20,12,20,0"
                 IsOpen="False"
                 IsClosable="True" />

        <TabView x:Name="WorkflowTabs"
                 Grid.Row="2"
                 Margin="20,12,20,20"
                 IsAddTabButtonVisible="False">
            <TabViewItem Header="Sync &amp; Review" IsClosable="False">
                <Grid Padding="4,12,4,4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" ColumnSpacing="12" RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="210" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="DataSourceBox"
                                  Header="Data source"
                                  SelectedIndex="0"
                                  SelectionChanged="DataSourceBox_SelectionChanged"
                                  HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="Airtable shared link" />
                            <ComboBoxItem Content="Excel workbook" />
                        </ComboBox>
                        <TextBox x:Name="SharedLinkBox"
                                 Grid.Column="1"
                                 Header="Airtable public share link"
                                 PlaceholderText="https://airtable.com/app.../shr..." />
                        <Grid x:Name="ExcelSourcePanel"
                              Grid.Column="1"
                              ColumnSpacing="8"
                              Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ExcelPathBox"
                                     Header="Excel workbook"
                                     PlaceholderText="Select or paste the path to an .xlsx or .xlsm file" />
                            <Button Grid.Column="1"
                                    Content="Browse..."
                                    Click="BrowseExcel_Click"
                                    VerticalAlignment="Bottom"
                                    Padding="16,9" />
                        </Grid>
                        <ToggleSwitch x:Name="PrimaryOptionsToggle"
                                      Grid.Column="2"
                                      Header="Design options"
                                      OnContent="Primary only"
                                      OffContent="All"
                                      IsOn="True"
                                      VerticalAlignment="Bottom" />
                        <StackPanel Grid.Row="1"
                                    Grid.ColumnSpan="3"
                                    Orientation="Horizontal"
                                    Spacing="10"
                                    HorizontalAlignment="Right">
                        <Button
                                Content="Import data source settings..."
                                Click="ImportDataSourceSettings_Click"
                                Padding="16,9" />
                        <Button
                                Content="Export data source settings..."
                                Click="ExportDataSourceSettings_Click"
                                Padding="16,9" />
                        <Button
                                Content="Test connection"
                                Click="TestConnection_Click"
                                Padding="16,9" />
                        <Button
                                Content="Scan Revit"
                                Click="ScanRevit_Click"
                                Padding="16,9" />
                        <Button
                                Content="Sync &amp; scan"
                                Click="SyncAndScan_Click"
                                Style="{StaticResource PrimaryButtonStyle}" />
                        </StackPanel>
                    </Grid>

                    <InfoBar Grid.Row="1"
                             Margin="0,12,0,12"
                             IsOpen="True"
                             IsClosable="False"
                             Severity="Informational"
                             Title="Step 1 — Connect and compare"
                             Message="Choose Airtable or Excel, enter the source, then select Test connection. Choose Auto-map all or Map manually when prompted. Use Sync &amp; scan to compare source names with Planting and Floor types; Scan Revit reads the model without loading source data." />

                    <Grid Grid.Row="2" Margin="0,6,0,16" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource SummaryCardStyle}">
                            <StackPanel Spacing="4">
                                <TextBlock Text="REVIT TYPES" Opacity="0.65" FontSize="11" FontWeight="SemiBold" />
                                <TextBlock x:Name="TypeCountText" Text="—" FontSize="24" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource SummaryCardStyle}">
                            <StackPanel Spacing="4">
                                <TextBlock Text="ELEMENTS" Opacity="0.65" FontSize="11" FontWeight="SemiBold" />
                                <TextBlock x:Name="ElementCountText" Text="—" FontSize="24" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource SummaryCardStyle}">
                            <StackPanel Spacing="4">
                                <TextBlock Text="FLOOR AREA" Opacity="0.65" FontSize="11" FontWeight="SemiBold" />
                                <TextBlock x:Name="FloorAreaText" Text="—" FontSize="24" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="3" Style="{StaticResource SummaryCardStyle}">
                            <StackPanel Spacing="4">
                                <TextBlock Text="NEEDS REVIEW" Opacity="0.65" FontSize="11" FontWeight="SemiBold" />
                                <TextBlock x:Name="ReviewCountText" Text="—" FontSize="24" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="3" Padding="12,8" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="150" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="STATUS" FontSize="11" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="CATEGORY" FontSize="11" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="2" Text="REVIT TYPE" FontSize="11" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="3" Text="COUNT" FontSize="11" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="4" Text="AREA (m²)" FontSize="11" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="5" Text="CALCULATION TYPE" FontSize="11" FontWeight="SemiBold" />
                    </Grid>

                    <ListView Grid.Row="4"
                              ItemsSource="{x:Bind ReviewItems}"
                              SelectionMode="None"
                              IsItemClickEnabled="False">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:ReviewRow">
                                <Grid Padding="12,9">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="150" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Status}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Category}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind TypeName}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind Quantity}" />
                                    <TextBlock Grid.Column="4" Text="{x:Bind Area}" />
                                    <TextBlock Grid.Column="5" Text="{x:Bind CalculationType}" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </TabViewItem>

            <TabViewItem Header="Parameter Mapper" IsClosable="False">
                <Grid Padding="4,12,4,4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="3">
                            <TextBlock Text="Source data → Revit parameter mapping"
                                       FontSize="22"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="MapperStatusText"
                                       Text="Load the source headers and active-model parameters to begin."
                                       Opacity="0.7" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="Load catalogs"
                                Click="LoadMapper_Click"
                                Padding="16,9"
                                VerticalAlignment="Center" />
                        <Button Grid.Column="2"
                                Content="Import mappings..."
                                Click="ImportMappings_Click"
                                Padding="16,9"
                                VerticalAlignment="Center" />
                        <Button Grid.Column="3"
                                Content="Export mappings..."
                                Click="ExportMappings_Click"
                                Padding="16,9"
                                VerticalAlignment="Center" />
                        <Button Grid.Column="4"
                                Content="Auto-map all columns"
                                Click="AutoMap_Click"
                                Padding="16,9"
                                VerticalAlignment="Center" />
                        <Button Grid.Column="5"
                                Content="Adjust columns"
                                Padding="16,9"
                                VerticalAlignment="Center">
                            <Button.Flyout>
                                <Flyout>
                                    <StackPanel Width="310" Spacing="8">
                                        <TextBlock Text="Mapper column widths"
                                                   FontSize="16"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="Source column" Opacity="0.75" />
                                        <Slider x:Name="MapperSourceWidthSlider"
                                                Minimum="220"
                                                Maximum="720"
                                                Value="420"
                                                StepFrequency="10"
                                                ValueChanged="MapperColumnWidth_ValueChanged" />
                                        <TextBlock Text="Revit parameter" Opacity="0.75" />
                                        <Slider x:Name="MapperTargetWidthSlider"
                                                Minimum="220"
                                                Maximum="620"
                                                Value="350"
                                                StepFrequency="10"
                                                ValueChanged="MapperColumnWidth_ValueChanged" />
                                        <TextBlock Text="Conversion" Opacity="0.75" />
                                        <Slider x:Name="MapperConversionWidthSlider"
                                                Minimum="170"
                                                Maximum="420"
                                                Value="230"
                                                StepFrequency="10"
                                                ValueChanged="MapperColumnWidth_ValueChanged" />
                                        <Button Content="Reset widths"
                                                Click="ResetMapperColumnWidths_Click"
                                                HorizontalAlignment="Left" />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <Button Grid.Column="6"
                                Content="Save mappings"
                                Click="SaveMappings_Click"
                                Style="{StaticResource PrimaryButtonStyle}"
                                VerticalAlignment="Center" />
                    </Grid>

                    <InfoBar Grid.Row="1"
                             Margin="0,14,0,14"
                             IsOpen="True"
                             IsClosable="False"
                             Severity="Informational"
                             Title="Step 2 — Map source columns"
                             Message="Select Load catalogs, then Auto-map all columns. Review every row: choose a writable Revit target and conversion for Needs mapping, or turn Use off to ignore it. Use Adjust columns or the horizontal scrollbar for long names. Select Save mappings when all required rows are Ready." />

                    <ScrollViewer Grid.Row="2"
                                  Grid.RowSpan="2"
                                  HorizontalScrollBarVisibility="Auto"
                                  HorizontalScrollMode="Enabled"
                                  VerticalScrollBarVisibility="Disabled"
                                  VerticalScrollMode="Disabled">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Padding="8" ColumnSpacing="10" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition x:Name="MapperSourceHeaderColumn" Width="420" />
                                    <ColumnDefinition x:Name="MapperTargetHeaderColumn" Width="350" />
                                    <ColumnDefinition x:Name="MapperConversionHeaderColumn" Width="230" />
                                    <ColumnDefinition Width="120" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="USE" FontSize="11" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="SOURCE COLUMN" FontSize="11" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="2" Text="REVIT PARAMETER / SCOPE / STORAGE" FontSize="11" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="3" Text="CONVERSION" FontSize="11" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="4" Text="STATUS" FontSize="11" FontWeight="SemiBold" />
                            </Grid>

                            <ListView x:Name="MapperRowsListView"
                                      Grid.Row="1"
                                      ItemsSource="{x:Bind MappingRows}"
                                      SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:MappingRow">
                                        <Grid Tag="MapperRowGrid"
                                              Loaded="MappingRowGrid_Loaded"
                                              Padding="8,7"
                                              ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="70" />
                                                <ColumnDefinition Width="420" />
                                                <ColumnDefinition Width="350" />
                                                <ColumnDefinition Width="230" />
                                                <ColumnDefinition Width="120" />
                                            </Grid.ColumnDefinitions>
                                            <ToggleSwitch IsOn="{x:Bind Enabled, Mode=TwoWay}" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{x:Bind SelectedAirtableField}"
                                                       ToolTipService.ToolTip="{x:Bind SelectedAirtableField}"
                                                       VerticalAlignment="Center"
                                                       TextWrapping="Wrap" />
                                            <ComboBox Grid.Column="2"
                                                      ItemsSource="{x:Bind TargetOptions}"
                                                      SelectedItem="{x:Bind SelectedTarget, Mode=TwoWay}"
                                                      DisplayMemberPath="DisplayName"
                                                      PlaceholderText="Select Revit parameter"
                                                      HorizontalAlignment="Stretch" />
                                            <ComboBox Grid.Column="3"
                                                      ItemsSource="{x:Bind ConversionOptions}"
                                                      SelectedItem="{x:Bind SelectedConversion, Mode=TwoWay}"
                                                      HorizontalAlignment="Stretch" />
                                            <TextBlock Grid.Column="4"
                                                       Text="{x:Bind MappingStatus, Mode=OneWay}"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </TabViewItem>

            <TabViewItem Header="Apply to Revit" IsClosable="False">
                <Grid Padding="4,12,4,4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="3">
                            <TextBlock Text="Write source values to Revit"
                                       FontSize="22"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="SyncStatusText"
                                       Text="Save mappings, then build a parameter-write preview."
                                       Opacity="0.7" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="Preview changes"
                                Click="PreviewParameterWrites_Click"
                                Padding="16,9"
                                VerticalAlignment="Center" />
                        <Button x:Name="ApplyParameterWritesButton"
                                Grid.Column="2"
                                Content="Apply to Revit"
                                Click="ApplyParameterWrites_Click"
                                Style="{StaticResource PrimaryButtonStyle}"
                                IsEnabled="False"
                                VerticalAlignment="Center" />
                    </Grid>

                    <InfoBar Grid.Row="1"
                             Margin="0,12,0,12"
                             IsOpen="True"
                             IsClosable="False"
                             Severity="Warning"
                             Title="Step 3 — Preview and write to Revit"
                             Message="Select Preview changes and compare Current with Proposed values. Resolve Invalid, Missing or Duplicate rows if needed. Select Apply to Revit only after review; it writes Ready rows in one undoable Revit transaction and skips No change rows." />

                    <Grid Grid.Row="2" Padding="10,8" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="190" />
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="65" />
                            <ColumnDefinition Width="190" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="STATUS" FontSize="10" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="REVIT TYPE" FontSize="10" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="2" Text="PARAMETER" FontSize="10" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="3" Text="SCOPE" FontSize="10" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="4" Text="CURRENT" FontSize="10" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="5" Text="PROPOSED" FontSize="10" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="6" Text="TARGETS" FontSize="10" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="7" Text="MESSAGE" FontSize="10" FontWeight="SemiBold" />
                    </Grid>

                    <ListView Grid.Row="3"
                              ItemsSource="{x:Bind SyncPreviewItems}"
                              SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:SyncPreviewRow">
                                <Grid Padding="10,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="65" />
                                        <ColumnDefinition Width="190" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Status}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind TypeName}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind Parameter}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind Scope}" />
                                    <TextBlock Grid.Column="4" Text="{x:Bind CurrentValue}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="5" Text="{x:Bind ProposedValue}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="6" Text="{x:Bind Targets}" />
                                    <TextBlock Grid.Column="7" Text="{x:Bind Message}" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </TabViewItem>

            <TabViewItem Header="Calculations" IsClosable="False">
                <Grid Padding="4,12,4,4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="3">
                            <TextBlock Text="Environmental and financial calculations"
                                       FontSize="22"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="CalculationStatusText"
                                       Text="Load the selected source and Revit model to calculate a preview."
                                       Opacity="0.7" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="Calculate preview"
                                Click="Calculate_Click"
                                Style="{StaticResource PrimaryButtonStyle}"
                                VerticalAlignment="Center" />
                    </Grid>

                    <InfoBar Grid.Row="1"
                             Margin="0,12,0,12"
                             IsOpen="True"
                             IsClosable="False"
                             Severity="Informational"
                             Title="Step 4 — Calculate the project preview"
                             Message="Select Calculate preview. Trees use each source coefficient × Revit instance count; Floors and planting surfaces use coefficient × area. Review carbon, oxygen, runoff, pollutants, maintenance and savings below. This calculation does not write Revit parameters." />

                    <Grid Grid.Row="2" ColumnSpacing="10" RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource SummaryCardStyle}">
                            <StackPanel Spacing="3">
                                <TextBlock Text="CARBON" FontSize="11" FontWeight="SemiBold" Opacity="0.65" />
                                <TextBlock x:Name="CarbonTotalText" Text="—" FontSize="20" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource SummaryCardStyle}">
                            <StackPanel Spacing="3">
                                <TextBlock Text="OXYGEN" FontSize="11" FontWeight="SemiBold" Opacity="0.65" />
                                <TextBlock x:Name="OxygenTotalText" Text="—" FontSize="20" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource SummaryCardStyle}">
                            <StackPanel Spacing="3">
                                <TextBlock Text="RUNOFF" FontSize="11" FontWeight="SemiBold" Opacity="0.65" />
                                <TextBlock x:Name="RunoffTotalText" Text="—" FontSize="20" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="1" Style="{StaticResource SummaryCardStyle}">
                            <StackPanel Spacing="3">
                                <TextBlock Text="POLLUTANTS REMOVED" FontSize="11" FontWeight="SemiBold" Opacity="0.65" />
                                <TextBlock x:Name="PollutantsTotalText" Text="—" FontSize="20" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource SummaryCardStyle}">
                            <StackPanel Spacing="3">
                                <TextBlock Text="MAINTENANCE COST" FontSize="11" FontWeight="SemiBold" Opacity="0.65" />
                                <TextBlock x:Name="MaintenanceTotalText" Text="—" FontSize="20" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource SummaryCardStyle}">
                            <StackPanel Spacing="3">
                                <TextBlock Text="COST SAVINGS" FontSize="11" FontWeight="SemiBold" Opacity="0.65" />
                                <TextBlock x:Name="SavingsTotalText" Text="—" FontSize="20" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="3" Margin="0,12,0,0" Padding="10,8" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="100" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="STATUS" FontSize="10" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="REVIT TYPE" FontSize="10" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="2" Text="BASIS" FontSize="10" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="3" Text="CARBON" FontSize="10" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="4" Text="OXYGEN" FontSize="10" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="5" Text="RUNOFF" FontSize="10" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="6" Text="POLLUTANTS" FontSize="10" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="7" Text="MAINTENANCE" FontSize="10" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="8" Text="SAVINGS" FontSize="10" FontWeight="SemiBold" />
                    </Grid>

                    <ListView Grid.Row="4"
                              ItemsSource="{x:Bind CalculationItems}"
                              SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:CalculationRow">
                                <Grid Padding="10,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="100" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Status}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind TypeName}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind Basis}" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind Carbon}" />
                                    <TextBlock Grid.Column="4" Text="{x:Bind Oxygen}" />
                                    <TextBlock Grid.Column="5" Text="{x:Bind Runoff}" />
                                    <TextBlock Grid.Column="6" Text="{x:Bind Pollutants}" />
                                    <TextBlock Grid.Column="7" Text="{x:Bind MaintenanceCost}" />
                                    <TextBlock Grid.Column="8" Text="{x:Bind CostSavings}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </TabViewItem>

            <TabViewItem Header="i-Tree Excel" IsClosable="False">
                <ScrollViewer>
                    <Grid Padding="4,12,4,20" ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="14">
                            <StackPanel Spacing="3">
                                <TextBlock Text="Download i-Tree data to Excel"
                                           FontSize="22"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="Read planting type inputs from Revit, query i-Tree, then create or safely update a workbook."
                                           TextWrapping="Wrap"
                                           Opacity="0.7" />
                            </StackPanel>

                            <InfoBar IsOpen="True"
                                     IsClosable="False"
                                     Severity="Informational"
                                     Title="Species_Code controls the merge"
                                     Message="Matching rows are updated in place. Unmatched workbook rows and columns that are not supplied by i-Tree are preserved." />

                            <ComboBox x:Name="ITreeScopeBox"
                                      Header="Revit planting scope"
                                      SelectedIndex="0"
                                      HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="All planting types with Species_Code" />
                                <ComboBoxItem Content="Current Revit selection only" />
                                <ComboBoxItem Content="Entire i-Tree species catalog (no Revit data required)" />
                            </ComboBox>

                            <PasswordBox x:Name="ITreeApiKeyBox"
                                         Header="i-Tree API key"
                                         PlaceholderText="Enter the API key used by the Dynamo graph" />
                            <CheckBox x:Name="RememberITreeKeyCheckBox"
                                      Content="Remember securely for this Windows user"
                                      IsChecked="True" />

                            <TextBlock Text="Excel destination" FontSize="16" FontWeight="SemiBold" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="ITreeExcelPathBox"
                                         Header="Workbook path"
                                         PlaceholderText="Create a new .xlsx or select an existing .xlsx/.xlsm" />
                                <Button Grid.Column="1"
                                        Content="Existing..."
                                        Click="BrowseExistingITreeWorkbook_Click"
                                        VerticalAlignment="Bottom"
                                        Padding="14,9" />
                                <Button Grid.Column="2"
                                        Content="New..."
                                        Click="ChooseNewITreeWorkbook_Click"
                                        VerticalAlignment="Bottom"
                                        Padding="14,9" />
                            </Grid>

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="170" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="ITreeWorksheetBox"
                                         Header="Worksheet"
                                         Text="iTree Data" />
                                <NumberBox x:Name="ITreeHeaderRowBox"
                                           Grid.Column="1"
                                           Header="Header row"
                                           Value="1"
                                           Minimum="1"
                                           Maximum="1048575"
                                           SpinButtonPlacementMode="Inline" />
                            </Grid>

                            <CheckBox x:Name="ITreeAppendMissingCheckBox"
                                      Content="Append exported Species_Code values not already in the worksheet"
                                      IsChecked="True" />
                            <CheckBox x:Name="ITreeBackupCheckBox"
                                      Content="Create a timestamped backup before updating an existing workbook"
                                      IsChecked="True" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="14">
                            <StackPanel Spacing="3">
                                <TextBlock Text="Data to download" FontSize="22" FontWeight="SemiBold" />
                                <TextBlock Text="The established Revit/Dynamo input and output columns are created by default."
                                           TextWrapping="Wrap"
                                           Opacity="0.7" />
                            </StackPanel>

                            <Border Style="{StaticResource SummaryCardStyle}">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="Benefit groups" FontWeight="SemiBold" />
                                    <CheckBox x:Name="ITreeMonetaryCheckBox" Content="Monetary benefits" IsChecked="True" />
                                    <CheckBox x:Name="ITreeCarbonCheckBox" Content="Carbon storage and sequestration" IsChecked="True" />
                                    <CheckBox x:Name="ITreeHydrologyCheckBox" Content="Hydrology and avoided runoff" IsChecked="True" />
                                    <CheckBox x:Name="ITreeAirCheckBox" Content="Air quality and pollution removal" IsChecked="True" />
                                    <CheckBox x:Name="ITreeMetadataCheckBox" Content="API versions and Revit trace metadata" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SummaryCardStyle}">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="Detailed timelines" FontWeight="SemiBold" />
                                    <CheckBox x:Name="ITreeAnnualTimelineCheckBox" Content="All annual timeline values" />
                                    <CheckBox x:Name="ITreeCumulativeTimelineCheckBox" Content="All cumulative timeline values" />
                                    <CheckBox x:Name="ITreeFullResponseCheckBox" Content="Entire raw API response" />
                                </StackPanel>
                            </Border>

                            <InfoBar IsOpen="True"
                                     IsClosable="False"
                                     Severity="Warning"
                                     Title="Full response can be very wide"
                                     Message="A 20-year full response can add roughly 6,600 columns. Excel's maximum is 16,384 columns." />

                            <Button Content="Download and update Excel"
                                    Click="ExportITree_Click"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    HorizontalAlignment="Right" />
                            <TextBlock x:Name="ITreeExportStatusText"
                                       Text="Ready. No workbook has been changed."
                                       TextWrapping="Wrap"
                                       Opacity="0.75" />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabViewItem>

            <TabViewItem Header="Quality Control" IsClosable="False">
                <Grid Padding="28">
                    <StackPanel MaxWidth="680" HorizontalAlignment="Left" Spacing="14">
                        <TextBlock Text="Synchronization quality" FontSize="22" FontWeight="SemiBold" />
                        <InfoBar IsOpen="True"
                                 IsClosable="False"
                                 Severity="Informational"
                                 Title="Step 5 — Resolve warnings"
                                 Message="Return to Sync &amp; Review for Missing types, Parameter Mapper for unmapped columns, or the source file for duplicate and invalid values. Matching ignores case, spaces, punctuation and most accents." />
                        <TextBlock Text="Matched" FontWeight="SemiBold" />
                        <TextBlock Text="The normalized Revit type name exists in the selected source dataset." Opacity="0.75" />
                        <TextBlock Text="Missing" FontWeight="SemiBold" />
                        <TextBlock Text="No source record matches the Revit type; review an alias or source entry." Opacity="0.75" />
                        <TextBlock Text="Not checked" FontWeight="SemiBold" />
                        <TextBlock Text="The model was scanned without loading source records." Opacity="0.75" />
                    </StackPanel>
                </Grid>
            </TabViewItem>

            <TabViewItem Header="Settings" IsClosable="False">
                <Grid Padding="28">
                    <StackPanel MaxWidth="680" HorizontalAlignment="Left" Spacing="12">
                        <TextBlock Text="Security and deployment" FontSize="22" FontWeight="SemiBold" />
                        <InfoBar IsOpen="True"
                                 IsClosable="False"
                                 Severity="Informational"
                                 Title="Setup notes"
                                 Message="Source and mapping settings are stored for the current Windows user. Use a public Airtable view or a local/shared Excel workbook; no Airtable token or administrator installation is required." />
                        <TextBlock TextWrapping="Wrap"
                                   Text="Choose a public Airtable share link or an Excel workbook on the Sync &amp; Review tab. No Airtable token, account or administrator installation is required." />
                        <TextBlock TextWrapping="Wrap"
                                   Text="The selected source is saved only for the current Windows user. Excel files must use the first row for column headers; the first non-empty worksheet is loaded." />
                    </StackPanel>
                </Grid>
            </TabViewItem>
        </TabView>

        <WebView2 x:Name="AirtableWebView"
                  Grid.RowSpan="3"
                  Width="1"
                  Height="1"
                  Opacity="0.01"
                  IsHitTestVisible="False"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Bottom" />

        <ProgressRing x:Name="BusyIndicator"
                      Grid.RowSpan="3"
                      Width="44"
                      Height="44"
                      IsActive="False"
                      Visibility="Collapsed"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center" />
    </Grid>
</Page>
