<Application
    x:Class="WWP.LandscapeDataManager.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <Color x:Key="EgisBlue">#FF003B5C</Color>
            <Color x:Key="EgisTeal">#FF00A6A6</Color>
            <SolidColorBrush x:Key="EgisBlueBrush" Color="{StaticResource EgisBlue}" />
            <SolidColorBrush x:Key="EgisTealBrush" Color="{StaticResource EgisTeal}" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
