<Page
    x:Class="WWP.LandscapeDataManager.App.ITreeCalculator.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:WWP.LandscapeDataManager.SharedUI"
    xmlns:local="using:WWP.LandscapeDataManager.App.ITreeCalculator">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="{StaticResource LimPageMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="Tree Calculator" Style="{StaticResource LimPageTitleStyle}" />
            <TextBlock
                Text="Validates every planting instance before calling the i-Tree API, calculates only what's ready or stale, and caches identical inputs so repeat trees don't cost another call."
                Style="{StaticResource LimPageSubtitleStyle}" />
        </StackPanel>

        <Border Grid.Row="1" Margin="0,16,0,0" Style="{StaticResource LimCardStyle}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox
                          x:Name="ValidationScopeBox"
                          Header="Scope"
                          SelectedIndex="0"
                          HorizontalAlignment="Stretch">
                    <ComboBoxItem Content="All planting instances in model" />
                    <ComboBoxItem Content="Current Revit selection only" />
                </ComboBox>
                <Button Grid.Column="1" Content="Validate" Click="Validate_Click" Style="{StaticResource LimPrimaryButtonStyle}" VerticalAlignment="Bottom" />
                <Button Grid.Column="2" Content="Settings" Click="OpenSettings_Click" Style="{StaticResource LimSecondaryButtonStyle}" VerticalAlignment="Bottom" />
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,16,0,0" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border x:Name="ReadyCard" Style="{StaticResource LimCardStyle}" Padding="12" Tag="Ready" Tapped="StatusCard_Tapped">
                <StackPanel Spacing="2"><TextBlock Text="READY" Style="{StaticResource LimSectionHeaderStyle}" /><TextBlock x:Name="ReadyCountText" Text="—" FontSize="18" FontWeight="SemiBold" /></StackPanel>
            </Border>
            <Border x:Name="StaleCard" Grid.Column="1" Style="{StaticResource LimCardStyle}" Padding="12" Tag="Stale" Tapped="StatusCard_Tapped">
                <StackPanel Spacing="2"><TextBlock Text="STALE" Style="{StaticResource LimSectionHeaderStyle}" /><TextBlock x:Name="StaleCountText" Text="—" FontSize="18" FontWeight="SemiBold" /></StackPanel>
            </Border>
            <Border x:Name="CalculatedCard" Grid.Column="2" Style="{StaticResource LimCardStyle}" Padding="12" Tag="Calculated" Tapped="StatusCard_Tapped">
                <StackPanel Spacing="2"><TextBlock Text="CALCULATED" Style="{StaticResource LimSectionHeaderStyle}" /><TextBlock x:Name="CalculatedCountText" Text="—" FontSize="18" FontWeight="SemiBold" /></StackPanel>
            </Border>
            <Border x:Name="MissingCard" Grid.Column="3" Style="{StaticResource LimCardStyle}" Padding="12" Tag="MissingInput" Tapped="StatusCard_Tapped">
                <StackPanel Spacing="2"><TextBlock Text="MISSING" Style="{StaticResource LimSectionHeaderStyle}" /><TextBlock x:Name="MissingCountText" Text="—" FontSize="18" FontWeight="SemiBold" /></StackPanel>
            </Border>
            <Border x:Name="InvalidCard" Grid.Column="4" Style="{StaticResource LimCardStyle}" Padding="12" Tag="InvalidInput" Tapped="StatusCard_Tapped">
                <StackPanel Spacing="2"><TextBlock Text="INVALID" Style="{StaticResource LimSectionHeaderStyle}" /><TextBlock x:Name="InvalidCountText" Text="—" FontSize="18" FontWeight="SemiBold" /></StackPanel>
            </Border>
            <Border x:Name="WarningCard" Grid.Column="5" Style="{StaticResource LimCardStyle}" Padding="12" Tag="APIWarning" Tapped="StatusCard_Tapped">
                <StackPanel Spacing="2"><TextBlock Text="WARNING" Style="{StaticResource LimSectionHeaderStyle}" /><TextBlock x:Name="WarningCountText" Text="—" FontSize="18" FontWeight="SemiBold" /></StackPanel>
            </Border>
            <Border x:Name="ErrorCard" Grid.Column="6" Style="{StaticResource LimCardStyle}" Padding="12" Tag="APIError" Tapped="StatusCard_Tapped">
                <StackPanel Spacing="2"><TextBlock Text="ERROR" Style="{StaticResource LimSectionHeaderStyle}" /><TextBlock x:Name="ErrorCountText" Text="—" FontSize="18" FontWeight="SemiBold" /></StackPanel>
            </Border>
        </Grid>

        <TextBlock Grid.Row="3"
                   x:Name="FilterStatusText"
                   Margin="0,8,0,0"
                   Style="{StaticResource LimMutedTextStyle}"
                   Text="Showing all rows — click a card above to filter the list to just that status." />

        <Grid Grid.Row="4" Margin="0,16,0,10" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Style="{StaticResource LimMutedTextStyle}" Text="Enter your API key, then select Validate." VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="Select" Click="SelectRows_Click" Style="{StaticResource LimSecondaryButtonStyle}" />
            <Button Grid.Column="2" Content="Zoom" Click="ZoomRows_Click" Style="{StaticResource LimSecondaryButtonStyle}" />
            <Button Grid.Column="3" Content="Isolate" Click="IsolateRows_Click" Style="{StaticResource LimSecondaryButtonStyle}" />
            <Button Grid.Column="4" Content="Reset isolate" Click="ResetIsolate_Click" Style="{StaticResource LimSecondaryButtonStyle}" />
            <Button Grid.Column="5" Content="Colour overrides" Click="ColourOverrides_Click" Style="{StaticResource LimSecondaryButtonStyle}" />
            <Button Grid.Column="6" Content="Reset colours" Click="ResetColours_Click" Style="{StaticResource LimSecondaryButtonStyle}" />
            <Button Grid.Column="7" Content="Export report" Click="ExportReport_Click" Style="{StaticResource LimSecondaryButtonStyle}" />
        </Grid>

        <Grid Grid.Row="5" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Validation report: the i-Tree inputs and the last calculation each sit in a swim lane. -->
            <Grid Grid.Row="0">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid Grid.RowSpan="3" Style="{StaticResource LimTableLanesStyle}" ui:TableLanes.FollowRows="True" Margin="{StaticResource LimTableCheckOffset}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /><ColumnDefinition Width="90" /><ColumnDefinition Width="70" /><ColumnDefinition Width="160" /><ColumnDefinition Width="320" /></Grid.ColumnDefinitions>
                    <Border Grid.Column="2" Grid.ColumnSpan="2" Style="{StaticResource LimTableLaneStyle}" Background="{ThemeResource LimLaneBlueBrush}" />
                    <Border Grid.Column="4" Style="{StaticResource LimTableLaneStyle}" Background="{ThemeResource LimLaneGreenBrush}" />
                </Grid>
                <Grid Style="{StaticResource LimTableGroupRowStyle}" Margin="{StaticResource LimTableCheckOffset}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /><ColumnDefinition Width="90" /><ColumnDefinition Width="70" /><ColumnDefinition Width="160" /><ColumnDefinition Width="320" /></Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="2" Grid.ColumnSpan="2" Text="I-TREE INPUTS" Style="{StaticResource LimTableGroupStyle}" Foreground="{ThemeResource LimLaneBlueTextBrush}" />
                    <TextBlock Grid.Column="4" Text="CALCULATED" Style="{StaticResource LimTableGroupStyle}" Foreground="{ThemeResource LimLaneGreenTextBrush}" />
                </Grid>
                <Grid Grid.Row="1" Style="{StaticResource LimTableHeaderRowStyle}" Margin="{StaticResource LimTableCheckOffset}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /><ColumnDefinition Width="90" /><ColumnDefinition Width="70" /><ColumnDefinition Width="160" /><ColumnDefinition Width="320" /></Grid.ColumnDefinitions>
                    <TextBlock Text="Status" Style="{StaticResource LimTableHeaderStyle}" />
                    <TextBlock Grid.Column="1" Text="Family : Type" Style="{StaticResource LimTableHeaderStyle}" />
                    <TextBlock Grid.Column="2" Text="Species&#x0a;code" Style="{StaticResource LimTableHeaderStyle}" />
                    <TextBlock Grid.Column="3" Text="Age&#x0a;years" Style="{StaticResource LimTableNumberHeaderStyle}" />
                    <TextBlock Grid.Column="4" Text="Last updated" Style="{StaticResource LimTableHeaderStyle}" />
                    <TextBlock Grid.Column="5" Text="Details" Style="{StaticResource LimTableHeaderStyle}" />
                </Grid>
                <ListView Grid.Row="2" x:Name="ReportList" ItemsSource="{x:Bind FilteredRows}" SelectionMode="Multiple" ItemContainerStyle="{StaticResource LimTableCheckItemStyle}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:InstanceReportRow">
                            <Grid Style="{StaticResource LimTableRowStyle}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /><ColumnDefinition Width="90" /><ColumnDefinition Width="70" /><ColumnDefinition Width="160" /><ColumnDefinition Width="320" /></Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind Status}" FontWeight="SemiBold" Foreground="{x:Bind StatusBrush}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind FamilyType}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind FamilyType}" />
                                <TextBlock Grid.Column="2" Text="{x:Bind SpeciesCode}" />
                                <TextBlock Grid.Column="3" Text="{x:Bind Years}" TextAlignment="Right" />
                                <TextBlock Grid.Column="4" Text="{x:Bind LastUpdated}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind LastUpdated}" />
                                <TextBlock Grid.Column="5" Text="{x:Bind Details}" Opacity="0.75" TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <Grid Grid.Row="1" Margin="0,10,0,0" ColumnSpacing="10" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Content="Calculate valid" Click="CalculateValid_Click" Style="{StaticResource LimPrimaryButtonStyle}" />
                <Button Grid.Column="1" Content="Select all"
                        ToolTipService.ToolTip="Selects every row currently shown below (respects the status-card filter above)."
                        Click="SelectAllRows_Click" Style="{StaticResource LimSecondaryButtonStyle}" />
                <Button Grid.Column="2" Content="Recalculate selected" Click="RecalculateSelected_Click" Style="{StaticResource LimSecondaryButtonStyle}" />
                <Button Grid.Column="3" Content="Fill gaps from WWP sheet" Click="FillFromSheet_Click" Style="{StaticResource LimSecondaryButtonStyle}"
                        ToolTipService.ToolTip="No i-Tree calls: estimate every tree i-Tree hasn't calculated from the WWP landscape data sheet, and add pollen for every tree." />
                <TextBlock Grid.Column="4" x:Name="CalculateStatusText" Style="{StaticResource LimMutedTextStyle}" VerticalAlignment="Center" TextWrapping="Wrap" />
                <CheckBox Grid.Row="1" Grid.ColumnSpan="5" x:Name="FillFromSheetCheckBox" IsChecked="True"
                          Content="After calculating, fill the rest from the WWP sheet: estimate the trees i-Tree couldn't calculate, and add pollen for every tree"
                          ToolTipService.ToolTip="A tree with no i-Tree result (no species code, missing or invalid inputs, an API error) gets the sheet's per-tree CO₂e, oxygen, runoff, pollutants and money saved, marked Estimated. Trees with i-Tree results keep them; i-Tree replaces an estimate once the tree is calculated." />
            </Grid>
        </Grid>

        <ProgressRing x:Name="BusyIndicator"
                      Grid.RowSpan="6"
                      Width="40"
                      Height="40"
                      IsActive="False"
                      Visibility="Collapsed"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center" />
    </Grid>
</Page>
