<Page
    x:Class="WWP.LandscapeDataManager.App.ITreeCalculator.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WWP.LandscapeDataManager.App.ITreeCalculator">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="{StaticResource LimPageMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="i-Tree Calculate and Quality Control" Style="{StaticResource LimPageTitleStyle}" />
            <TextBlock
                Text="Validates every planting instance before calling the i-Tree API, calculates only what's ready or stale, and caches identical inputs so repeat trees don't cost another call."
                Style="{StaticResource LimPageSubtitleStyle}" />
        </StackPanel>

        <Border Grid.Row="1" Margin="0,16,0,0" Style="{StaticResource LimCardStyle}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <PasswordBox x:Name="ApiKeyBox" Header="i-Tree API key" />
                <ComboBox Grid.Column="1"
                          x:Name="ValidationScopeBox"
                          Header="Scope"
                          SelectedIndex="0"
                          HorizontalAlignment="Stretch">
                    <ComboBoxItem Content="All planting instances in model" />
                    <ComboBoxItem Content="Current Revit selection only" />
                </ComboBox>
                <ComboBox Grid.Column="2"
                          x:Name="CurrencyBox"
                          Header="Currency"
                          HorizontalAlignment="Stretch"
                          SelectionChanged="CurrencyBox_SelectionChanged">
                    <ComboBoxItem Content="USD" />
                    <ComboBoxItem Content="GBP" />
                    <ComboBoxItem Content="EUR" />
                    <ComboBoxItem Content="CAD" />
                    <ComboBoxItem Content="AUD" />
                    <ComboBoxItem Content="NZD" />
                </ComboBox>
                <CheckBox Grid.Column="3" x:Name="RememberKeyCheckBox" Content="Remember" IsChecked="True" VerticalAlignment="Bottom" Margin="0,0,0,8" />
                <Button Grid.Column="4" Content="Validate" Click="Validate_Click" Style="{StaticResource LimPrimaryButtonStyle}" VerticalAlignment="Bottom" />
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,16,0,0" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border x:Name="ReadyCard" Style="{StaticResource LimCardStyle}" Padding="12" Tag="Ready" Tapped="StatusCard_Tapped">
                <StackPanel Spacing="2"><TextBlock Text="READY" Style="{StaticResource LimSectionHeaderStyle}" /><TextBlock x:Name="ReadyCountText" Text="—" FontSize="18" FontWeight="SemiBold" /></StackPanel>
            </Border>
            <Border x:Name="StaleCard" Grid.Column="1" Style="{StaticResource LimCardStyle}" Padding="12" Tag="Stale" Tapped="StatusCard_Tapped">
                <StackPanel Spacing="2"><TextBlock Text="STALE" Style="{StaticResource LimSectionHeaderStyle}" /><TextBlock x:Name="StaleCountText" Text="—" FontSize="18" FontWeight="SemiBold" /></StackPanel>
            </Border>
            <Border x:Name="CalculatedCard" Grid.Column="2" Style="{StaticResource LimCardStyle}" Padding="12" Tag="Calculated" Tapped="StatusCard_Tapped">
                <StackPanel Spacing="2"><TextBlock Text="CALCULATED" Style="{StaticResource LimSectionHeaderStyle}" /><TextBlock x:Name="CalculatedCountText" Text="—" FontSize="18" FontWeight="SemiBold" /></StackPanel>
            </Border>
            <Border x:Name="MissingCard" Grid.Column="3" Style="{StaticResource LimCardStyle}" Padding="12" Tag="MissingInput" Tapped="StatusCard_Tapped">
                <StackPanel Spacing="2"><TextBlock Text="MISSING" Style="{StaticResource LimSectionHeaderStyle}" /><TextBlock x:Name="MissingCountText" Text="—" FontSize="18" FontWeight="SemiBold" /></StackPanel>
            </Border>
            <Border x:Name="InvalidCard" Grid.Column="4" Style="{StaticResource LimCardStyle}" Padding="12" Tag="InvalidInput" Tapped="StatusCard_Tapped">
                <StackPanel Spacing="2"><TextBlock Text="INVALID" Style="{StaticResource LimSectionHeaderStyle}" /><TextBlock x:Name="InvalidCountText" Text="—" FontSize="18" FontWeight="SemiBold" /></StackPanel>
            </Border>
            <Border x:Name="WarningCard" Grid.Column="5" Style="{StaticResource LimCardStyle}" Padding="12" Tag="APIWarning" Tapped="StatusCard_Tapped">
                <StackPanel Spacing="2"><TextBlock Text="WARNING" Style="{StaticResource LimSectionHeaderStyle}" /><TextBlock x:Name="WarningCountText" Text="—" FontSize="18" FontWeight="SemiBold" /></StackPanel>
            </Border>
            <Border x:Name="ErrorCard" Grid.Column="6" Style="{StaticResource LimCardStyle}" Padding="12" Tag="APIError" Tapped="StatusCard_Tapped">
                <StackPanel Spacing="2"><TextBlock Text="ERROR" Style="{StaticResource LimSectionHeaderStyle}" /><TextBlock x:Name="ErrorCountText" Text="—" FontSize="18" FontWeight="SemiBold" /></StackPanel>
            </Border>
        </Grid>

        <TextBlock Grid.Row="3"
                   x:Name="FilterStatusText"
                   Margin="0,8,0,0"
                   Style="{StaticResource LimMutedTextStyle}"
                   Text="Showing all rows — click a card above to filter the list to just that status." />

        <Grid Grid.Row="4" Margin="0,16,0,10" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Style="{StaticResource LimMutedTextStyle}" Text="Enter your API key, then select Validate." VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="Select" Click="SelectRows_Click" Style="{StaticResource LimSecondaryButtonStyle}" />
            <Button Grid.Column="2" Content="Zoom" Click="ZoomRows_Click" Style="{StaticResource LimSecondaryButtonStyle}" />
            <Button Grid.Column="3" Content="Isolate" Click="IsolateRows_Click" Style="{StaticResource LimSecondaryButtonStyle}" />
            <Button Grid.Column="4" Content="Reset isolate" Click="ResetIsolate_Click" Style="{StaticResource LimSecondaryButtonStyle}" />
            <Button Grid.Column="5" Content="Colour overrides" Click="ColourOverrides_Click" Style="{StaticResource LimSecondaryButtonStyle}" />
            <Button Grid.Column="6" Content="Reset colours" Click="ResetColours_Click" Style="{StaticResource LimSecondaryButtonStyle}" />
            <Button Grid.Column="7" Content="Export report" Click="ExportReport_Click" Style="{StaticResource LimSecondaryButtonStyle}" />
        </Grid>

        <Grid Grid.Row="5" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ListView x:Name="ReportList" Grid.Row="0" ItemsSource="{x:Bind FilteredRows}" SelectionMode="Multiple">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:InstanceReportRow">
                        <Grid Padding="6" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="320" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind Status}" FontWeight="SemiBold" Foreground="{x:Bind StatusBrush}" />
                            <TextBlock Grid.Column="1" Text="{x:Bind FamilyType}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2" Text="{x:Bind SpeciesCode}" />
                            <TextBlock Grid.Column="3" Text="{x:Bind Years}" />
                            <TextBlock Grid.Column="4" Text="{x:Bind LastUpdated}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="5" Text="{x:Bind Details}" Opacity="0.75" TextWrapping="Wrap" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Grid Grid.Row="1" Margin="0,10,0,0" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Content="Calculate valid" Click="CalculateValid_Click" Style="{StaticResource LimPrimaryButtonStyle}" />
                <Button Grid.Column="1" Content="Recalculate selected" Click="RecalculateSelected_Click" Style="{StaticResource LimSecondaryButtonStyle}" />
                <TextBlock Grid.Column="2" x:Name="CalculateStatusText" Style="{StaticResource LimMutedTextStyle}" VerticalAlignment="Center" />
            </Grid>
        </Grid>

        <ProgressRing x:Name="BusyIndicator"
                      Grid.RowSpan="6"
                      Width="40"
                      Height="40"
                      IsActive="False"
                      Visibility="Collapsed"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center" />
    </Grid>
</Page>
