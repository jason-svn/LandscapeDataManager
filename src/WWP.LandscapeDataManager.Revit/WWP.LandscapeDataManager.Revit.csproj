<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <AssemblyName>WWP.LandscapeDataManager.Revit</AssemblyName>
    <RootNamespace>WWP.LandscapeDataManager.Revit</RootNamespace>
    <RevitVersion Condition="'$(RevitVersion)' == ''">2025</RevitVersion>
    <RevitInstallDir>C:\Program Files\Autodesk\Revit $(RevitVersion)</RevitInstallDir>
    <OutputPath>$(MSBuildProjectDirectory)\..\..\artifacts\Revit$(RevitVersion)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
    <Configurations>Debug;Release;Debug 2025;Debug 2026</Configurations>
  </PropertyGroup>

  <!-- Debugging: start Revit from the selected RevitInstallDir (controlled by RevitVersion) -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <!-- Visual Studio will launch this external program when debugging the project -->
    <StartProgram>$(RevitInstallDir)\Revit.exe</StartProgram>
    <StartWorkingDirectory>$(RevitInstallDir)</StartWorkingDirectory>
    <StartArguments></StartArguments>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Debug 2025'">
    <StartProgram>$(RevitInstallDir)\Revit.exe</StartProgram>
    <StartWorkingDirectory>$(RevitInstallDir)</StartWorkingDirectory>
    <StartArguments />
  </PropertyGroup>

  <!-- Named debug configurations for Revit 2025 and 2026 -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug 2025'">
    <RevitVersion>2025</RevitVersion>
    <RevitInstallDir>C:\Program Files\Autodesk\Revit 2025</RevitInstallDir>
    <OutputPath>$(MSBuildProjectDirectory)\..\..\artifacts\Revit2025\</OutputPath>
    <StartProgram>$(RevitInstallDir)\Revit.exe</StartProgram>
    <StartWorkingDirectory>$(RevitInstallDir)</StartWorkingDirectory>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug 2026'">
    <RevitVersion>2026</RevitVersion>
    <RevitInstallDir>C:\Program Files\Autodesk\Revit 2026</RevitInstallDir>
    <OutputPath>$(MSBuildProjectDirectory)\..\..\artifacts\Revit2026\</OutputPath>
    <StartProgram>$(RevitInstallDir)\Revit.exe</StartProgram>
    <StartWorkingDirectory>$(RevitInstallDir)</StartWorkingDirectory>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WWP.LandscapeDataManager.Contracts\WWP.LandscapeDataManager.Contracts.csproj" />
    <ProjectReference Include="..\WWP.LandscapeDataManager.App.Parameters\WWP.LandscapeDataManager.App.Parameters.csproj"
                      ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true" />
    <ProjectReference Include="..\WWP.LandscapeDataManager.App.Importer\WWP.LandscapeDataManager.App.Importer.csproj"
                      ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true" />
    <ProjectReference Include="..\WWP.LandscapeDataManager.App.ITreeDownloader\WWP.LandscapeDataManager.App.ITreeDownloader.csproj"
                      ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true" />
    <ProjectReference Include="..\WWP.LandscapeDataManager.App.ITreeCalculator\WWP.LandscapeDataManager.App.ITreeCalculator.csproj"
                      ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true" />
    <ProjectReference Include="..\WWP.LandscapeDataManager.App.SyncAudit\WWP.LandscapeDataManager.App.SyncAudit.csproj"
                      ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true" />
    <ProjectReference Include="..\WWP.LandscapeDataManager.App.TreeSearcher\WWP.LandscapeDataManager.App.TreeSearcher.csproj"
                      ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true" />
    <ProjectReference Include="..\WWP.LandscapeDataManager.App.LocationFinder\WWP.LandscapeDataManager.App.LocationFinder.csproj"
                      ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true" />
    <ProjectReference Include="..\WWP.LandscapeDataManager.App.FloorCalculator\WWP.LandscapeDataManager.App.FloorCalculator.csproj"
                      ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true" />
    <ProjectReference Include="..\WWP.LandscapeDataManager.App.HealthCheck\WWP.LandscapeDataManager.App.HealthCheck.csproj"
                      ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true" />
    <ProjectReference Include="..\WWP.LandscapeDataManager.App.Dashboard\WWP.LandscapeDataManager.App.Dashboard.csproj"
                      ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true" />
    <ProjectReference Include="..\WWP.LandscapeDataManager.App.Settings\WWP.LandscapeDataManager.App.Settings.csproj"
                      ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>

  <!-- Compile against Autodesk's published API reference assemblies, not the copy installed on the
       build machine. A Revit update can retarget the installed copy (Revit 2025.5 references
       .NET 10), which would stop the .NET 8 connector compiling and, if retargeted to match,
       stop it loading on earlier 2025 updates. The 2025.4 API builds a connector that loads on
       2025.4 (.NET 8) and still runs on 2025.5 (.NET 10). Compile-only: Revit supplies these
       assemblies at runtime. -->
  <PropertyGroup>
    <RevitApiPackageVersion Condition="'$(RevitVersion)' == '2025'">2025.4.60</RevitApiPackageVersion>
    <RevitApiPackageVersion Condition="'$(RevitVersion)' == '2026'">2026.4.10</RevitApiPackageVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitApiPackageVersion)" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitApiPackageVersion)" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\Assets\PS-16.png" LogicalName="LIM.LandscapeData.PS.16.png" />
    <EmbeddedResource Include="..\..\Assets\PS-32.png" LogicalName="LIM.LandscapeData.PS.32.png" />
    <EmbeddedResource Include="..\..\Assets\EX-16.png" LogicalName="LIM.LandscapeData.EX.16.png" />
    <EmbeddedResource Include="..\..\Assets\EX-32.png" LogicalName="LIM.LandscapeData.EX.32.png" />
    <EmbeddedResource Include="..\..\Assets\iDL-16.png" LogicalName="LIM.LandscapeData.iDL.16.png" />
    <EmbeddedResource Include="..\..\Assets\iDL-32.png" LogicalName="LIM.LandscapeData.iDL.32.png" />
    <EmbeddedResource Include="..\..\Assets\iCAL-16.png" LogicalName="LIM.LandscapeData.iCAL.16.png" />
    <EmbeddedResource Include="..\..\Assets\iCAL-32.png" LogicalName="LIM.LandscapeData.iCAL.32.png" />
    <EmbeddedResource Include="..\..\Assets\RA-16.png" LogicalName="LIM.LandscapeData.RA.16.png" />
    <EmbeddedResource Include="..\..\Assets\RA-32.png" LogicalName="LIM.LandscapeData.RA.32.png" />
    <EmbeddedResource Include="..\..\Assets\TS-16.png" LogicalName="LIM.LandscapeData.TS.16.png" />
    <EmbeddedResource Include="..\..\Assets\TS-32.png" LogicalName="LIM.LandscapeData.TS.32.png" />
    <EmbeddedResource Include="..\..\Assets\LF-16.png" LogicalName="LIM.LandscapeData.LF.16.png" />
    <EmbeddedResource Include="..\..\Assets\LF-32.png" LogicalName="LIM.LandscapeData.LF.32.png" />
    <EmbeddedResource Include="..\..\Assets\KS-16.png" LogicalName="LIM.LandscapeData.KS.16.png" />
    <EmbeddedResource Include="..\..\Assets\KS-32.png" LogicalName="LIM.LandscapeData.KS.32.png" />
    <EmbeddedResource Include="..\..\Assets\FC-16.png" LogicalName="LIM.LandscapeData.FC.16.png" />
    <EmbeddedResource Include="..\..\Assets\FC-32.png" LogicalName="LIM.LandscapeData.FC.32.png" />
    <EmbeddedResource Include="..\..\Assets\HC-16.png" LogicalName="LIM.LandscapeData.HC.16.png" />
    <EmbeddedResource Include="..\..\Assets\HC-32.png" LogicalName="LIM.LandscapeData.HC.32.png" />
    <EmbeddedResource Include="..\..\Assets\DB-16.png" LogicalName="LIM.LandscapeData.DB.16.png" />
    <EmbeddedResource Include="..\..\Assets\DB-32.png" LogicalName="LIM.LandscapeData.DB.32.png" />
    <EmbeddedResource Include="..\..\Assets\ST-16.png" LogicalName="LIM.LandscapeData.ST.16.png" />
    <EmbeddedResource Include="..\..\Assets\ST-32.png" LogicalName="LIM.LandscapeData.ST.32.png" />
    <EmbeddedResource Include="..\..\Assets\UP-16.png" LogicalName="LIM.LandscapeData.UP.16.png" />
    <EmbeddedResource Include="..\..\Assets\UP-32.png" LogicalName="LIM.LandscapeData.UP.32.png" />
  </ItemGroup>

  <Target Name="ValidateRevitInstallation" BeforeTargets="ResolveReferences">
    <Error Condition="'$(RevitApiPackageVersion)' == ''" Text="No Revit API package version is set for Revit $(RevitVersion) — add one to RevitApiPackageVersion in this project." />
    <Error Condition="$([MSBuild]::VersionLessThan('$(RevitVersion)', '2025'))" Text="Revit 2024 and older are intentionally unsupported. Use RevitVersion=2025 or newer." />
  </Target>

  <Target Name="DeployDebugConnector"
          AfterTargets="Build"
          Condition="('$(Configuration)' == 'Debug' Or '$(Configuration)' == 'Debug 2025' Or '$(Configuration)' == 'Debug 2026') And '$(DesignTimeBuild)' != 'true'">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\Deployment\Deploy-DebugConnector.ps1&quot; -RevitVersion $(RevitVersion) -ConnectorAssembly &quot;$(TargetPath)&quot; -ToolAssembly &quot;Parameters=$(MSBuildProjectDirectory)\..\..\artifacts\Parameters\WWP.LandscapeDataManager.Parameters.dll;Importer=$(MSBuildProjectDirectory)\..\..\artifacts\Importer\WWP.LandscapeDataManager.Importer.dll;ITreeDownloader=$(MSBuildProjectDirectory)\..\..\artifacts\ITreeDownloader\WWP.LandscapeDataManager.ITreeDownloader.dll;ITreeCalculator=$(MSBuildProjectDirectory)\..\..\artifacts\ITreeCalculator\WWP.LandscapeDataManager.ITreeCalculator.dll;SyncAudit=$(MSBuildProjectDirectory)\..\..\artifacts\SyncAudit\WWP.LandscapeDataManager.SyncAudit.dll;TreeSearcher=$(MSBuildProjectDirectory)\..\..\artifacts\TreeSearcher\WWP.LandscapeDataManager.TreeSearcher.dll;LocationFinder=$(MSBuildProjectDirectory)\..\..\artifacts\LocationFinder\WWP.LandscapeDataManager.LocationFinder.dll;FloorCalculator=$(MSBuildProjectDirectory)\..\..\artifacts\FloorCalculator\WWP.LandscapeDataManager.FloorCalculator.dll;HealthCheck=$(MSBuildProjectDirectory)\..\..\artifacts\HealthCheck\WWP.LandscapeDataManager.HealthCheck.dll;Dashboard=$(MSBuildProjectDirectory)\..\..\artifacts\Dashboard\WWP.LandscapeDataManager.Dashboard.dll;Settings=$(MSBuildProjectDirectory)\..\..\artifacts\Settings\WWP.LandscapeDataManager.Settings.dll&quot;" />
  </Target>
</Project>
