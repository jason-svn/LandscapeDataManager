<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <AssemblyName>WWP.LandscapeDataManager.Revit</AssemblyName>
    <RootNamespace>WWP.LandscapeDataManager.Revit</RootNamespace>
    <RevitVersion Condition="'$(RevitVersion)' == ''">2025</RevitVersion>
    <RevitInstallDir>C:\Program Files\Autodesk\Revit $(RevitVersion)</RevitInstallDir>
    <OutputPath>$(MSBuildProjectDirectory)\..\..\artifacts\Revit$(RevitVersion)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
    <Configurations>Debug;Release;Debug 2025;Debug 2026</Configurations>
  </PropertyGroup>

  <!-- Debugging: start Revit from the selected RevitInstallDir (controlled by RevitVersion) -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <!-- Visual Studio will launch this external program when debugging the project -->
    <StartProgram>$(RevitInstallDir)\Revit.exe</StartProgram>
    <StartWorkingDirectory>$(RevitInstallDir)</StartWorkingDirectory>
    <StartArguments></StartArguments>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Debug 2025'">
    <StartProgram>$(RevitInstallDir)\Revit.exe</StartProgram>
    <StartWorkingDirectory>$(RevitInstallDir)</StartWorkingDirectory>
    <StartArguments />
  </PropertyGroup>

  <!-- Named debug configurations for Revit 2025 and 2026 -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug 2025'">
    <RevitVersion>2025</RevitVersion>
    <RevitInstallDir>C:\Program Files\Autodesk\Revit 2025</RevitInstallDir>
    <OutputPath>$(MSBuildProjectDirectory)\..\..\artifacts\Revit2025\</OutputPath>
    <StartProgram>$(RevitInstallDir)\Revit.exe</StartProgram>
    <StartWorkingDirectory>$(RevitInstallDir)</StartWorkingDirectory>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug 2026'">
    <RevitVersion>2026</RevitVersion>
    <RevitInstallDir>C:\Program Files\Autodesk\Revit 2026</RevitInstallDir>
    <OutputPath>$(MSBuildProjectDirectory)\..\..\artifacts\Revit2026\</OutputPath>
    <StartProgram>$(RevitInstallDir)\Revit.exe</StartProgram>
    <StartWorkingDirectory>$(RevitInstallDir)</StartWorkingDirectory>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WWP.LandscapeDataManager.Contracts\WWP.LandscapeDataManager.Contracts.csproj" />
    <ProjectReference Include="..\WWP.LandscapeDataManager.App\WWP.LandscapeDataManager.App.csproj"
                      ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true" />
    <ProjectReference Include="..\WWP.LandscapeDataManager.App.Parameters\WWP.LandscapeDataManager.App.Parameters.csproj"
                      ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true" />
    <ProjectReference Include="..\WWP.LandscapeDataManager.App.Importer\WWP.LandscapeDataManager.App.Importer.csproj"
                      ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true" />
    <ProjectReference Include="..\WWP.LandscapeDataManager.App.ITreeDownloader\WWP.LandscapeDataManager.App.ITreeDownloader.csproj"
                      ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true" />
    <ProjectReference Include="..\WWP.LandscapeDataManager.App.ITreeCalculator\WWP.LandscapeDataManager.App.ITreeCalculator.csproj"
                      ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true" />
    <ProjectReference Include="..\WWP.LandscapeDataManager.App.SyncAudit\WWP.LandscapeDataManager.App.SyncAudit.csproj"
                      ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true" />
    <Reference Include="RevitAPI">
      <HintPath>$(RevitInstallDir)\RevitAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>$(RevitInstallDir)\RevitAPIUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\Assets\PS-16.png" LogicalName="LIM.LandscapeData.PS.16.png" />
    <EmbeddedResource Include="..\..\Assets\PS-32.png" LogicalName="LIM.LandscapeData.PS.32.png" />
    <EmbeddedResource Include="..\..\Assets\EX-16.png" LogicalName="LIM.LandscapeData.EX.16.png" />
    <EmbeddedResource Include="..\..\Assets\EX-32.png" LogicalName="LIM.LandscapeData.EX.32.png" />
    <EmbeddedResource Include="..\..\Assets\IT-16.png" LogicalName="LIM.LandscapeData.IT.16.png" />
    <EmbeddedResource Include="..\..\Assets\IT-32.png" LogicalName="LIM.LandscapeData.IT.32.png" />
    <EmbeddedResource Include="..\..\Assets\CAL-16.png" LogicalName="LIM.LandscapeData.CAL.16.png" />
    <EmbeddedResource Include="..\..\Assets\CAL-32.png" LogicalName="LIM.LandscapeData.CAL.32.png" />
    <EmbeddedResource Include="..\..\Assets\RA-16.png" LogicalName="LIM.LandscapeData.RA.16.png" />
    <EmbeddedResource Include="..\..\Assets\RA-32.png" LogicalName="LIM.LandscapeData.RA.32.png" />
  </ItemGroup>

  <Target Name="ValidateRevitInstallation" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(RevitInstallDir)\RevitAPI.dll')" Text="Revit $(RevitVersion) was not found at $(RevitInstallDir). Supported values are 2025 and newer." />
    <Error Condition="$([MSBuild]::VersionLessThan('$(RevitVersion)', '2025'))" Text="Revit 2024 and older are intentionally unsupported. Use RevitVersion=2025 or newer." />
  </Target>

  <Target Name="DeployDebugConnector"
          AfterTargets="Build"
          Condition="('$(Configuration)' == 'Debug' Or '$(Configuration)' == 'Debug 2025' Or '$(Configuration)' == 'Debug 2026') And '$(DesignTimeBuild)' != 'true'">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\Deployment\Deploy-DebugConnector.ps1&quot; -RevitVersion $(RevitVersion) -ConnectorAssembly &quot;$(TargetPath)&quot; -AppAssembly &quot;$(MSBuildProjectDirectory)\..\..\artifacts\App\WWP.LandscapeDataManager.App.dll&quot; -ToolAssembly &quot;Parameters=$(MSBuildProjectDirectory)\..\..\artifacts\Parameters\WWP.LandscapeDataManager.Parameters.dll;Importer=$(MSBuildProjectDirectory)\..\..\artifacts\Importer\WWP.LandscapeDataManager.Importer.dll;ITreeDownloader=$(MSBuildProjectDirectory)\..\..\artifacts\ITreeDownloader\WWP.LandscapeDataManager.ITreeDownloader.dll;ITreeCalculator=$(MSBuildProjectDirectory)\..\..\artifacts\ITreeCalculator\WWP.LandscapeDataManager.ITreeCalculator.dll;SyncAudit=$(MSBuildProjectDirectory)\..\..\artifacts\SyncAudit\WWP.LandscapeDataManager.SyncAudit.dll&quot;" />
  </Target>
</Project>
