<Page
    x:Class="WWP.LandscapeDataManager.App.Dashboard.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WWP.LandscapeDataManager.App.Dashboard"
    Loaded="Page_Loaded">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="KpiForestBrush" Color="#FF176B2B" />
                    <SolidColorBrush x:Key="KpiLeafBrush" Color="#FF63BE47" />
                    <SolidColorBrush x:Key="KpiLimeBrush" Color="#FFA6D78C" />
                    <SolidColorBrush x:Key="KpiGoldBrush" Color="#FFFFC400" />
                    <SolidColorBrush x:Key="KpiWaterBrush" Color="#FF2F6FB0" />
                    <SolidColorBrush x:Key="KpiChartAmberBrush" Color="#FFC98A00" />
                    <SolidColorBrush x:Key="KpiAmberCardBrush" Color="#FFA36A00" />
                    <SolidColorBrush x:Key="KpiCanvasBrush" Color="#FFF5F7F2" />
                    <SolidColorBrush x:Key="KpiInkBrush" Color="#FF1C281F" />
                    <SolidColorBrush x:Key="KpiSurfaceBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="KpiBorderBrush" Color="#FFDDE4DA" />
                    <SolidColorBrush x:Key="KpiMutedBrush" Color="#FF586359" />
                    <SolidColorBrush x:Key="KpiAccentTextBrush" Color="#FF176B2B" />
                    <SolidColorBrush x:Key="KpiBadgeBrush" Color="#FFE5F2E1" />
                    <SolidColorBrush x:Key="KpiOnCategoryBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="KpiCategoryTrackBrush" Color="#FF83A889" />
                    <SolidColorBrush x:Key="KpiCategoryDividerBrush" Color="#558CC394" />
                    <SolidColorBrush x:Key="KpiChartTrackBrush" Color="#FFE1E8DE" />
                    <SolidColorBrush x:Key="KpiWaterTextBrush" Color="#FF2F6FB0" />
                    <SolidColorBrush x:Key="KpiAmberTextBrush" Color="#FFA36A00" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="KpiForestBrush" Color="#FF176B2B" />
                    <SolidColorBrush x:Key="KpiLeafBrush" Color="#FF83D96B" />
                    <SolidColorBrush x:Key="KpiLimeBrush" Color="#FF497D3B" />
                    <SolidColorBrush x:Key="KpiGoldBrush" Color="#FFFFC400" />
                    <SolidColorBrush x:Key="KpiWaterBrush" Color="#FF2F6FB0" />
                    <SolidColorBrush x:Key="KpiChartAmberBrush" Color="#FFE8B54C" />
                    <SolidColorBrush x:Key="KpiAmberCardBrush" Color="#FFA36A00" />
                    <SolidColorBrush x:Key="KpiCanvasBrush" Color="#FF141A16" />
                    <SolidColorBrush x:Key="KpiInkBrush" Color="#FFF0F4EF" />
                    <SolidColorBrush x:Key="KpiSurfaceBrush" Color="#FF202923" />
                    <SolidColorBrush x:Key="KpiBorderBrush" Color="#FF455249" />
                    <SolidColorBrush x:Key="KpiMutedBrush" Color="#FFB4C2B7" />
                    <SolidColorBrush x:Key="KpiAccentTextBrush" Color="#FF8EDB9B" />
                    <SolidColorBrush x:Key="KpiBadgeBrush" Color="#FF263D2B" />
                    <SolidColorBrush x:Key="KpiOnCategoryBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="KpiCategoryTrackBrush" Color="#FF83A889" />
                    <SolidColorBrush x:Key="KpiCategoryDividerBrush" Color="#558CC394" />
                    <SolidColorBrush x:Key="KpiChartTrackBrush" Color="#FF344139" />
                    <SolidColorBrush x:Key="KpiWaterTextBrush" Color="#FF78B5ED" />
                    <SolidColorBrush x:Key="KpiAmberTextBrush" Color="#FFF4BE70" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="KpiForestBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="KpiLeafBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="KpiLimeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="KpiGoldBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="KpiWaterBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="KpiChartAmberBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="KpiAmberCardBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="KpiCanvasBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="KpiInkBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="KpiSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="KpiBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="KpiMutedBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="KpiAccentTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="KpiBadgeBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="KpiOnCategoryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="KpiCategoryTrackBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="KpiCategoryDividerBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="KpiChartTrackBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="KpiWaterTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="KpiAmberTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <Style x:Key="KpiSurfaceStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource KpiSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource KpiBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="24" />
                <Setter Property="Padding" Value="22" />
            </Style>
            <Style x:Key="KpiEyebrowStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="100" />
                <Setter Property="Foreground" Value="{ThemeResource KpiMutedBrush}" />
            </Style>
            <Style x:Key="KpiCardTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="17" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource KpiInkBrush}" />
            </Style>
            <Style x:Key="KpiMetricCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource KpiSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource KpiBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="Padding" Value="12,10" />
            </Style>
            <Style x:Key="KpiStatusCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource KpiSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource KpiBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="Padding" Value="12,10" />
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="24,18,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="52" Height="52" CornerRadius="14" Background="{ThemeResource KpiForestBrush}" Margin="0,0,16,0">
                <TextBlock Text="LIM" FontSize="15" FontWeight="Bold" Foreground="{ThemeResource KpiOnCategoryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="Environmental KPI Dashboard" FontSize="25" FontWeight="Bold" />
                <TextBlock Text="Graphic outlook, design-scenario comparison, and detailed LIM reporting" Style="{StaticResource LimPageSubtitleStyle}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Border Background="{ThemeResource KpiBadgeBrush}" CornerRadius="16" Padding="14,7">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse Width="8" Height="8" Fill="{ThemeResource KpiLeafBrush}" VerticalAlignment="Center" />
                        <TextBlock x:Name="CacheStatusText" Text="No snapshot loaded" Foreground="{ThemeResource KpiAccentTextBrush}" FontWeight="SemiBold" FontSize="13" />
                    </StackPanel>
                </Border>
                <Button Content="Settings" Click="OpenSettings_Click" Style="{StaticResource LimSecondaryButtonStyle}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Margin="0,14,0,4" Style="{StaticResource LimCardStyle}" Padding="16,12">
            <StackPanel Spacing="8">
                <TextBlock Text="FILTERS &amp; SCOPE" Style="{StaticResource KpiEyebrowStyle}" />
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" VerticalScrollMode="Disabled">
                    <Grid ColumnSpacing="10" MinWidth="1500" Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="135" />
                            <ColumnDefinition Width="320" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="145" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="280" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="ScopeBox" Header="Model scope" SelectedIndex="0" HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="Whole model" />
                            <ComboBoxItem Content="Current selection" />
                        </ComboBox>
                        <!-- A scenario is one option per design option set (default: each set's primary).
                        Elements in options that aren't chosen are left out of every number. -->
                        <ComboBox Grid.Column="1" x:Name="ScenarioBox" Header="Design scenario" HorizontalAlignment="Stretch"
                            DisplayMemberPath="Label" SelectionChanged="ScenarioBox_SelectionChanged"
                            ToolTipService.ToolTip="One option per design option set. Main-model elements are in every scenario; elements in options that aren't chosen are left out." />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Bottom">
                            <Button Content="Edit…" Click="EditScenario_Click" Style="{StaticResource LimSecondaryButtonStyle}"
                                ToolTipService.ToolTip="Pick one option per design option set, then show it or save it as a named scenario." />
                            <Button Content="Use current view" Click="UseCurrentView_Click" Style="{StaticResource LimSecondaryButtonStyle}"
                                ToolTipService.ToolTip="Show the scenario Revit's active view displays, worked out from which options have elements visible in it." />
                        </StackPanel>
                        <ComboBox Grid.Column="3" x:Name="LevelBox" Header="Level" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="LevelBox_SelectionChanged">
                            <ComboBoxItem Content="All levels" />
                        </ComboBox>
                        <TextBox Grid.Column="4" x:Name="SpeciesSearchBox" Header="Species filter" PlaceholderText="Code or common name" TextChanged="SpeciesSearchBox_TextChanged" />
                        <ComboBox Grid.Column="5" x:Name="UnitSystemBox" Header="Display units" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="UnitSystemBox_SelectionChanged">
                            <ComboBoxItem Content="Project default" />
                            <ComboBoxItem Content="Metric" />
                            <ComboBoxItem Content="Imperial" />
                        </ComboBox>
                        <!-- One stop per growth year, like the web dashboard's slicer. Stops come from the
                        model's growth-year worksets (see GrowthYears), else the standard 5-25 outlook. -->
                        <StackPanel Grid.Column="6" Spacing="0" ToolTipService.ToolTip="Growth year: trees on that year's workset (plus trees on no growth-year workset), with outlook totals over that many years.">
                            <TextBlock x:Name="GrowthYearHeaderText" Text="Growth year" Margin="0,0,0,4" />
                            <Slider x:Name="GrowthYearSlider" Minimum="0" Maximum="4" StepFrequency="1" TickFrequency="1" TickPlacement="None"
                                SnapsTo="StepValues" IsThumbToolTipEnabled="False" Margin="8,0,8,0"
                                AutomationProperties.Name="Growth year" ValueChanged="GrowthYearSlider_ValueChanged" />
                            <Grid x:Name="GrowthYearTicks" Margin="0,-6,0,0" />
                        </StackPanel>
                        <Button Grid.Column="7" Click="Refresh_Click" Style="{StaticResource LimPrimaryButtonStyle}" VerticalAlignment="Bottom">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="&#8635;" FontSize="14" />
                                <TextBlock Text="Refresh model" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <Pivot Grid.Row="2" x:Name="DashboardPages">
            <PivotItem Header="Executive overview">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <Grid x:Name="CaptureRoot" MinWidth="1180" Background="{ThemeResource KpiCanvasBrush}" Padding="22" CornerRadius="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Margin="2,0,2,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="3">
                                <TextBlock Text="ENVIRONMENTAL PERFORMANCE" Style="{StaticResource KpiEyebrowStyle}" Foreground="{ThemeResource KpiAccentTextBrush}" />
                                <TextBlock x:Name="ProjectTitleText" Text="LIM project snapshot" FontSize="25" FontWeight="Bold" Foreground="{ThemeResource KpiInkBrush}" />
                                <TextBlock x:Name="OutlookText" Text="10-year outlook · annual stored results × 10" Foreground="{ThemeResource KpiMutedBrush}" />
                            </StackPanel>
                            <Border Grid.Column="1" Background="{ThemeResource KpiForestBrush}" CornerRadius="18" Padding="16,9" VerticalAlignment="Center">
                                <TextBlock x:Name="ScenarioBadgeText" Text="ALL DESIGN OPTIONS" Foreground="{ThemeResource KpiOnCategoryBrush}" FontWeight="SemiBold" />
                            </Border>
                        </Grid>

                        <!-- Headline banner: the ecosystem value over the outlook, split into the three i-Tree
                        benefit categories plus planting areas (the WWP sheet doesn't split those), then
                        what maintaining the planting costs and the net value left. -->
                        <Border Grid.Row="1" Margin="0,14,0,0" Background="{ThemeResource KpiForestBrush}" CornerRadius="24" Padding="26,20">
                            <Grid ColumnSpacing="22">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="1" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="1" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="1" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4" VerticalAlignment="Center" MaxWidth="260">
                                    <TextBlock Text="ECOSYSTEM VALUE" Foreground="{ThemeResource KpiOnCategoryBrush}" FontWeight="SemiBold" />
                                    <TextBlock x:Name="KpiEcosystemValueText" Text="—" FontSize="32" FontWeight="Bold" Foreground="{ThemeResource KpiGoldBrush}" TextWrapping="Wrap" />
                                    <TextBlock x:Name="EcosystemValueCaptionText" Text="Trees (i-Tree) + planting areas (WWP sheet)" Foreground="{ThemeResource KpiOnCategoryBrush}" FontSize="12" TextWrapping="Wrap" />
                                </StackPanel>
                                <Border Grid.Column="1" Background="{ThemeResource KpiCategoryDividerBrush}" Margin="0,4" />
                                <!-- Only what the cards below don't show: the planting areas' share. The trees'
                                share is the three cards, split by benefit. -->
                                <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center"
                                    ToolTipService.ToolTip="The WWP landscape data sheet gives planting areas one combined saving, not split by benefit.">
                                    <TextBlock Text="OF WHICH PLANTING AREAS" Foreground="{ThemeResource KpiOnCategoryBrush}" FontSize="11" CharacterSpacing="40" />
                                    <TextBlock x:Name="BannerFloorValueText" Text="—" Foreground="{ThemeResource KpiOnCategoryBrush}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="WWP sheet, all benefits · the trees' share is split in the cards below" Foreground="{ThemeResource KpiOnCategoryBrush}" FontSize="11" Opacity="0.8" TextWrapping="Wrap" />
                                </StackPanel>
                                <Border Grid.Column="3" Background="{ThemeResource KpiCategoryDividerBrush}" Margin="0,4" />
                                <StackPanel Grid.Column="4" Spacing="2" VerticalAlignment="Center"
                                    ToolTipService.ToolTip="Maintenance: the WWP sheet's yearly rate per tree, or per m² for planting areas (!_S_PLT_LDS_MaintenanceCostAnnual_Currency), over the outlook. Net value = ecosystem value − maintenance.">
                                    <TextBlock Text="MAINTENANCE" Foreground="{ThemeResource KpiOnCategoryBrush}" FontSize="11" CharacterSpacing="40" />
                                    <TextBlock x:Name="BannerMaintenanceText" Text="—" Foreground="{ThemeResource KpiOnCategoryBrush}" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Text="NET VALUE" Foreground="{ThemeResource KpiOnCategoryBrush}" FontSize="11" CharacterSpacing="40" Margin="0,6,0,0" />
                                    <TextBlock x:Name="BannerNetValueText" Text="—" Foreground="{ThemeResource KpiGoldBrush}" FontSize="20" FontWeight="Bold" />
                                    <TextBlock x:Name="BannerMaintenanceDetailText" Foreground="{ThemeResource KpiOnCategoryBrush}" FontSize="11" Opacity="0.8" />
                                </StackPanel>
                                <Border Grid.Column="5" Background="{ThemeResource KpiCategoryDividerBrush}" Margin="0,4" />
                                <StackPanel Grid.Column="6" Spacing="10" VerticalAlignment="Center">
                                    <StackPanel>
                                        <TextBlock Text="TREES" Foreground="{ThemeResource KpiOnCategoryBrush}" FontSize="11" />
                                        <TextBlock x:Name="KpiTreeCountText" Text="—" Foreground="{ThemeResource KpiOnCategoryBrush}" FontSize="22" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="PLANTING AREAS" Foreground="{ThemeResource KpiOnCategoryBrush}" FontSize="11" />
                                        <TextBlock x:Name="KpiPlantingAreaText" Text="—" Foreground="{ThemeResource KpiOnCategoryBrush}" FontSize="22" FontWeight="SemiBold" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="2" ColumnSpacing="16" RowSpacing="16" Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- One card per i-Tree benefit category, side by side under the ecosystem value
                            banner — Carbon / Stormwater / Air Quality, the order and colours used throughout.
                            Each leads with its value over the outlook, then the amounts behind it over the
                            outlook, then the yearly rate now. -->
                            <Border Background="{ThemeResource KpiForestBrush}" CornerRadius="24" Padding="22,20">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="CARBON DIOXIDE UPTAKE" Foreground="{ThemeResource KpiOnCategoryBrush}" FontWeight="SemiBold" CharacterSpacing="60" FontSize="12" TextWrapping="Wrap" />
                                    <TextBlock x:Name="HeroCarbonCostText" Text="—" FontSize="26" FontWeight="Bold" Foreground="{ThemeResource KpiGoldBrush}" TextWrapping="Wrap" />
                                    <Grid ColumnSpacing="6" Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="Carbon sequestered" Foreground="{ThemeResource KpiOnCategoryBrush}" FontSize="12.5" />
                                        <TextBlock Grid.Column="1" x:Name="HeroCarbonSequesteredText" Text="—" Foreground="{ThemeResource KpiOnCategoryBrush}" FontWeight="SemiBold" FontSize="12.5" />
                                    </Grid>
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="CO₂ equivalent" Foreground="{ThemeResource KpiOnCategoryBrush}" FontSize="12.5" />
                                        <TextBlock Grid.Column="1" x:Name="HeroCO2EquivalentText" Text="—" Foreground="{ThemeResource KpiOnCategoryBrush}" FontWeight="SemiBold" FontSize="12.5" />
                                    </Grid>
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="Oxygen released" Foreground="{ThemeResource KpiOnCategoryBrush}" FontSize="12.5" ToolTipService.ToolTip="Trees: CO₂e × 32/44. Planting areas: the WWP sheet's oxygen rate × area." />
                                        <TextBlock Grid.Column="1" x:Name="HeroOxygenText" Text="—" Foreground="{ThemeResource KpiOnCategoryBrush}" FontWeight="SemiBold" FontSize="12.5" />
                                    </Grid>
                                    <TextBlock x:Name="HeroCarbonRateText" Foreground="{ThemeResource KpiOnCategoryBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap" />
                                    <TextBlock Text="Amounts: trees + planting areas, over the outlook. £: trees only (the WWP sheet doesn't split planting-area savings by benefit)." Foreground="{ThemeResource KpiOnCategoryBrush}" FontSize="10.5" TextWrapping="Wrap" Opacity="0.85" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Background="{ThemeResource KpiWaterBrush}" CornerRadius="24" Padding="22,20">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="STORM WATER MITIGATION" Foreground="{ThemeResource KpiOnCategoryBrush}" FontWeight="SemiBold" CharacterSpacing="60" FontSize="12" TextWrapping="Wrap" />
                                    <TextBlock x:Name="HeroStormWaterCostText" Text="—" FontSize="26" FontWeight="Bold" Foreground="{ThemeResource KpiGoldBrush}" TextWrapping="Wrap" />
                                    <Grid ColumnSpacing="6" Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="Runoff avoided" Foreground="{ThemeResource KpiOnCategoryBrush}" FontSize="12.5" />
                                        <TextBlock Grid.Column="1" x:Name="HeroRunoffAvoidedText" Text="—" Foreground="{ThemeResource KpiOnCategoryBrush}" FontWeight="SemiBold" FontSize="12.5" />
                                    </Grid>
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="Rainfall intercepted (trees)" Foreground="{ThemeResource KpiOnCategoryBrush}" FontSize="12.5" />
                                        <TextBlock Grid.Column="1" x:Name="HeroRainfallInterceptedText" Text="—" Foreground="{ThemeResource KpiOnCategoryBrush}" FontWeight="SemiBold" FontSize="12.5" />
                                    </Grid>
                                    <TextBlock x:Name="HeroWaterRateText" Foreground="{ThemeResource KpiOnCategoryBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap" />
                                    <TextBlock Text="Runoff: trees + planting areas. Rainfall intercepted and £: trees only (i-Tree). Over the outlook." Foreground="{ThemeResource KpiOnCategoryBrush}" FontSize="10.5" TextWrapping="Wrap" Opacity="0.85" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Background="{ThemeResource KpiAmberCardBrush}" CornerRadius="24" Padding="22,20">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="AIR POLLUTION REMOVAL" Foreground="{ThemeResource KpiOnCategoryBrush}" FontWeight="SemiBold" CharacterSpacing="60" FontSize="12" TextWrapping="Wrap" />
                                    <TextBlock x:Name="HeroAirPollutionCostText" Text="—" FontSize="26" FontWeight="Bold" Foreground="{ThemeResource KpiOnCategoryBrush}" TextWrapping="Wrap" />
                                    <Grid ColumnSpacing="6" Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="Total removed" Foreground="{ThemeResource KpiOnCategoryBrush}" FontSize="12.5" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1" x:Name="HeroPollutionTotalText" Text="—" Foreground="{ThemeResource KpiOnCategoryBrush}" FontWeight="SemiBold" FontSize="12.5" />
                                    </Grid>
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="Carbon monoxide" Foreground="{ThemeResource KpiOnCategoryBrush}" FontSize="12" />
                                        <TextBlock Grid.Column="1" x:Name="HeroCarbonMonoxideText" Text="—" Foreground="{ThemeResource KpiOnCategoryBrush}" FontSize="12" />
                                    </Grid>
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="Ozone" Foreground="{ThemeResource KpiOnCategoryBrush}" FontSize="12" />
                                        <TextBlock Grid.Column="1" x:Name="HeroOzoneText" Text="—" Foreground="{ThemeResource KpiOnCategoryBrush}" FontSize="12" />
                                    </Grid>
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="Nitrogen dioxide" Foreground="{ThemeResource KpiOnCategoryBrush}" FontSize="12" />
                                        <TextBlock Grid.Column="1" x:Name="HeroNitrogenDioxideText" Text="—" Foreground="{ThemeResource KpiOnCategoryBrush}" FontSize="12" />
                                    </Grid>
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="Sulfur dioxide" Foreground="{ThemeResource KpiOnCategoryBrush}" FontSize="12" />
                                        <TextBlock Grid.Column="1" x:Name="HeroSulfurDioxideText" Text="—" Foreground="{ThemeResource KpiOnCategoryBrush}" FontSize="12" />
                                    </Grid>
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="PM2.5" Foreground="{ThemeResource KpiOnCategoryBrush}" FontSize="12" />
                                        <TextBlock Grid.Column="1" x:Name="HeroPM25Text" Text="—" Foreground="{ThemeResource KpiOnCategoryBrush}" FontSize="12" />
                                    </Grid>
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="Planting areas (all pollutants)" Foreground="{ThemeResource KpiOnCategoryBrush}" FontSize="12" />
                                        <TextBlock Grid.Column="1" x:Name="HeroFloorPollutionText" Text="—" Foreground="{ThemeResource KpiOnCategoryBrush}" FontSize="12" />
                                    </Grid>
                                    <TextBlock x:Name="HeroAirRateText" Foreground="{ThemeResource KpiOnCategoryBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap" />
                                    <TextBlock Text="Per pollutant and £: trees (i-Tree). Planting areas: total removed, from the WWP sheet. Over the outlook." Foreground="{ThemeResource KpiOnCategoryBrush}" FontSize="10.5" TextWrapping="Wrap" Opacity="0.85" />
                                </StackPanel>
                            </Border>

                            <!-- Carbon, runoff and pollution outlooks: one bar each, the outlook years layered
                            in shades of the metric's colour (built in code, see BuildOutlookBars). -->
                            <Border Grid.Row="1" Style="{StaticResource KpiSurfaceStyle}">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="Outlooks" Style="{StaticResource KpiCardTitleStyle}" />
                                    <TextBlock x:Name="OutlookCaptionText" Text="Totals added up year by year" Foreground="{ThemeResource KpiMutedBrush}" FontSize="12" TextWrapping="Wrap" />
                                    <StackPanel x:Name="OutlookBarsHost" Spacing="16" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource KpiSurfaceStyle}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Project snapshot" Style="{StaticResource KpiCardTitleStyle}" />
                                    <Grid ColumnSpacing="14" RowSpacing="14">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="CANOPY COVER" Style="{StaticResource KpiEyebrowStyle}" />
                                            <TextBlock x:Name="SnapshotCanopyText" Text="—" FontSize="22" FontWeight="Bold" Foreground="{ThemeResource KpiAccentTextBrush}" />
                                            <TextBlock x:Name="SnapshotCanopyDetailText" Foreground="{ThemeResource KpiMutedBrush}" FontSize="11" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Text="WATER" Style="{StaticResource KpiEyebrowStyle}" />
                                            <TextBlock x:Name="SnapshotWaterText" Text="—" FontSize="22" FontWeight="Bold" Foreground="{ThemeResource KpiWaterTextBrush}" TextWrapping="Wrap" />
                                            <TextBlock x:Name="SnapshotWaterDetailText" Foreground="{ThemeResource KpiMutedBrush}" FontSize="11" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Spacing="2">
                                            <TextBlock Text="SPECIES" Style="{StaticResource KpiEyebrowStyle}" />
                                            <TextBlock x:Name="SnapshotSpeciesText" Text="—" FontSize="20" FontWeight="SemiBold" />
                                            <TextBlock Text="distinct tree species" Foreground="{ThemeResource KpiMutedBrush}" FontSize="11" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="2">
                                            <TextBlock Text="HABITAT TYPES" Style="{StaticResource KpiEyebrowStyle}" />
                                            <TextBlock x:Name="SnapshotHabitatText" Text="—" FontSize="20" FontWeight="SemiBold" />
                                            <TextBlock x:Name="SnapshotHabitatDetailText" Foreground="{ThemeResource KpiMutedBrush}" FontSize="11" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Spacing="2">
                                            <TextBlock Text="PLANTING AREA" Style="{StaticResource KpiEyebrowStyle}" />
                                            <TextBlock x:Name="SnapshotAreaText" Text="—" FontSize="18" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Grid.Column="1" Spacing="2">
                                            <TextBlock Text="EMBODIED CARBON" Style="{StaticResource KpiEyebrowStyle}"
                                                ToolTipService.ToolTip="One-off GWP of the planting areas' materials (product + transport) — paving, stone, etc. Payback = years of the planting's current yearly CO₂e uptake needed to offset it." />
                                            <TextBlock x:Name="GwpBaselineText" Text="—" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock x:Name="GwpPaybackText" Foreground="{ThemeResource KpiMutedBrush}" FontSize="11" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource KpiSurfaceStyle}">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="Habitat &amp; connectivity" Style="{StaticResource KpiCardTitleStyle}" />
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="BNG NET CHANGE" Style="{StaticResource KpiEyebrowStyle}" />
                                        <TextBlock x:Name="OverviewBngText" Text="—" FontSize="22" FontWeight="Bold" />
                                        <TextBlock x:Name="OverviewBngDetailText" Foreground="{ThemeResource KpiMutedBrush}" FontSize="11" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <TextBlock Text="CONNECTIVITY BANDS" Style="{StaticResource KpiEyebrowStyle}" Margin="0,6,0,0"
                                        ToolTipService.ToolTip="From the Connectivity Calculator (dPC): how much each tree and planting area holds the habitat network together." />
                                    <ItemsControl ItemsSource="{x:Bind ConnectivityBandRows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="local:KpiBarRow">
                                                <Grid Margin="0,2" ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <TextBlock Text="{x:Bind Label}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Detail}" />
                                                    <ProgressBar Grid.Column="1" Value="{x:Bind Percent}" Maximum="100" Height="10" Foreground="{ThemeResource KpiLeafBrush}" Background="{ThemeResource KpiChartTrackBrush}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2" Text="{x:Bind ValueText}" FontSize="12" FontWeight="SemiBold" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock x:Name="ConnectivityEmptyText" Foreground="{ThemeResource KpiMutedBrush}" FontSize="11" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="2" Style="{StaticResource KpiSurfaceStyle}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Impact profile" Style="{StaticResource KpiCardTitleStyle}" />
                                    <TextBlock Text="Share supplied by calculated trees; the balance comes from planting areas" Foreground="{ThemeResource KpiMutedBrush}" FontSize="12" TextWrapping="Wrap" />
                                    <ItemsControl ItemsSource="{x:Bind ImpactProfileRows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="local:KpiBarRow">
                                                <StackPanel Margin="0,4" Spacing="4">
                                                    <Grid><TextBlock Text="{x:Bind Label}" FontWeight="SemiBold" /><TextBlock Text="{x:Bind ValueText}" HorizontalAlignment="Right" /></Grid>
                                                    <ProgressBar Value="{x:Bind Percent}" Maximum="100" Height="12" Foreground="{ThemeResource KpiAccentTextBrush}" Background="{ThemeResource KpiLimeBrush}" />
                                                    <TextBlock Text="{x:Bind Detail}" Foreground="{ThemeResource KpiMutedBrush}" FontSize="11" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- What's planted: planting types by area, and the BNG habitat types they make. -->
                            <Border Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource KpiSurfaceStyle}">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="Planting-area mix" Style="{StaticResource KpiCardTitleStyle}" />
                                    <Grid ColumnSpacing="18">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="PLANTING TYPES" Style="{StaticResource KpiEyebrowStyle}" />
                                            <ItemsControl ItemsSource="{x:Bind FloorMixRows}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="local:KpiBarRow">
                                                        <StackPanel Margin="0,2" Spacing="2">
                                                            <Grid ColumnSpacing="6">
                                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                                <TextBlock Text="{x:Bind Label}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Detail}" />
                                                                <TextBlock Grid.Column="1" Text="{x:Bind ValueText}" FontSize="12" FontWeight="SemiBold" />
                                                            </Grid>
                                                            <ProgressBar Value="{x:Bind Percent}" Maximum="100" Height="6" Foreground="{ThemeResource KpiLeafBrush}" Background="{ThemeResource KpiChartTrackBrush}" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <TextBlock Text="HABITAT TYPES (BNG)" Style="{StaticResource KpiEyebrowStyle}" />
                                            <ItemsControl ItemsSource="{x:Bind HabitatMixRows}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="local:KpiBarRow">
                                                        <StackPanel Margin="0,2" Spacing="2">
                                                            <Grid ColumnSpacing="6">
                                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                                <TextBlock Text="{x:Bind Label}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Detail}" />
                                                                <TextBlock Grid.Column="1" Text="{x:Bind ValueText}" FontSize="12" FontWeight="SemiBold" />
                                                            </Grid>
                                                            <ProgressBar Value="{x:Bind Percent}" Maximum="100" Height="6" Foreground="{ThemeResource KpiAccentTextBrush}" Background="{ThemeResource KpiChartTrackBrush}" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock x:Name="HabitatMixEmptyText" Foreground="{ThemeResource KpiMutedBrush}" FontSize="11" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Per-species dataset, sortable by any column (money saved first). -->
                            <Border Grid.Row="3" Grid.ColumnSpan="3" Style="{StaticResource KpiSurfaceStyle}">
                                <StackPanel Spacing="8">
                                    <Grid>
                                        <TextBlock Text="Tree palette" Style="{StaticResource KpiCardTitleStyle}" />
                                        <TextBlock x:Name="PaletteCaptionText" HorizontalAlignment="Right" Foreground="{ThemeResource KpiMutedBrush}" FontSize="12" VerticalAlignment="Center" />
                                    </Grid>
                                    <!-- Same table language as the Data explorer: benefit groups in swim lanes, two-line
                                         headers (metric, then unit) that sort when selected, plain numbers in the cells. -->
                                    <Grid>
                                        <Grid ColumnSpacing="14" Padding="6,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="200" /><ColumnDefinition Width="70" /><ColumnDefinition Width="120" /><ColumnDefinition Width="120" /><ColumnDefinition Width="120" /><ColumnDefinition Width="120" /><ColumnDefinition Width="120" /><ColumnDefinition Width="120" /></Grid.ColumnDefinitions>
                                            <Border Grid.Column="3" Grid.ColumnSpan="2" Style="{StaticResource LimTableLaneStyle}" Background="{ThemeResource LimLaneGreenBrush}" />
                                            <Border Grid.Column="5" Style="{StaticResource LimTableLaneStyle}" Background="{ThemeResource LimLaneBlueBrush}" />
                                            <Border Grid.Column="6" Style="{StaticResource LimTableLaneStyle}" Background="{ThemeResource LimLaneAmberBrush}" />
                                            <Border Grid.Column="7" Style="{StaticResource LimTableLaneStyle}" Background="{ThemeResource LimLaneGreyBrush}" />
                                        </Grid>
                                        <StackPanel>
                                            <Grid ColumnSpacing="14" Padding="6,10,6,0">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="200" /><ColumnDefinition Width="70" /><ColumnDefinition Width="120" /><ColumnDefinition Width="120" /><ColumnDefinition Width="120" /><ColumnDefinition Width="120" /><ColumnDefinition Width="120" /><ColumnDefinition Width="120" /></Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="3" Grid.ColumnSpan="2" Text="CARBON" Style="{StaticResource KpiEyebrowStyle}" Foreground="{ThemeResource KpiAccentTextBrush}" HorizontalAlignment="Center" />
                                                <TextBlock Grid.Column="5" Text="WATER" Style="{StaticResource KpiEyebrowStyle}" Foreground="{ThemeResource KpiWaterTextBrush}" HorizontalAlignment="Center" />
                                                <TextBlock Grid.Column="6" Text="AIR QUALITY" Style="{StaticResource KpiEyebrowStyle}" Foreground="{ThemeResource KpiAmberTextBrush}" HorizontalAlignment="Center" />
                                                <TextBlock Grid.Column="7" Text="MAINTENANCE" Style="{StaticResource KpiEyebrowStyle}" HorizontalAlignment="Center" />
                                            </Grid>
                                            <Grid ColumnSpacing="14" Padding="6,6,6,8">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="200" /><ColumnDefinition Width="70" /><ColumnDefinition Width="120" /><ColumnDefinition Width="120" /><ColumnDefinition Width="120" /><ColumnDefinition Width="120" /><ColumnDefinition Width="120" /><ColumnDefinition Width="120" /></Grid.ColumnDefinitions>
                                                <HyperlinkButton Tag="Name" Click="PaletteSort_Click" Padding="0" HorizontalAlignment="Left" VerticalAlignment="Bottom"><TextBlock x:Name="PaletteNameHeader" Text="Species" Style="{StaticResource KpiEyebrowStyle}" LineHeight="15" /></HyperlinkButton>
                                                <HyperlinkButton Grid.Column="1" Tag="Count" Click="PaletteSort_Click" Padding="0" HorizontalAlignment="Right" VerticalAlignment="Bottom"><TextBlock x:Name="PaletteCountHeader" Text="Trees" Style="{StaticResource KpiEyebrowStyle}" TextAlignment="Right" LineHeight="15" /></HyperlinkButton>
                                                <HyperlinkButton Grid.Column="2" Tag="Value" Click="PaletteSort_Click" Padding="0" HorizontalAlignment="Right" VerticalAlignment="Bottom"><TextBlock x:Name="PaletteValueHeader" Text="Money saved" Style="{StaticResource KpiEyebrowStyle}" TextAlignment="Right" LineHeight="15" /></HyperlinkButton>
                                                <HyperlinkButton Grid.Column="3" Tag="Co2" Click="PaletteSort_Click" Padding="0" HorizontalAlignment="Right" VerticalAlignment="Bottom"><TextBlock x:Name="PaletteCo2Header" Text="CO₂e" Style="{StaticResource KpiEyebrowStyle}" TextAlignment="Right" LineHeight="15" /></HyperlinkButton>
                                                <HyperlinkButton Grid.Column="4" Tag="Oxygen" Click="PaletteSort_Click" Padding="0" HorizontalAlignment="Right" VerticalAlignment="Bottom"><TextBlock x:Name="PaletteOxygenHeader" Text="Oxygen" Style="{StaticResource KpiEyebrowStyle}" TextAlignment="Right" LineHeight="15" /></HyperlinkButton>
                                                <HyperlinkButton Grid.Column="5" Tag="Runoff" Click="PaletteSort_Click" Padding="0" HorizontalAlignment="Right" VerticalAlignment="Bottom"><TextBlock x:Name="PaletteRunoffHeader" Text="Runoff" Style="{StaticResource KpiEyebrowStyle}" TextAlignment="Right" LineHeight="15" /></HyperlinkButton>
                                                <HyperlinkButton Grid.Column="6" Tag="Pollution" Click="PaletteSort_Click" Padding="0" HorizontalAlignment="Right" VerticalAlignment="Bottom"><TextBlock x:Name="PalettePollutionHeader" Text="Pollution" Style="{StaticResource KpiEyebrowStyle}" TextAlignment="Right" LineHeight="15" /></HyperlinkButton>
                                                <HyperlinkButton Grid.Column="7" Tag="Upkeep" Click="PaletteSort_Click" Padding="0" HorizontalAlignment="Right" VerticalAlignment="Bottom"><TextBlock x:Name="PaletteUpkeepHeader" Text="Cost" Style="{StaticResource KpiEyebrowStyle}" TextAlignment="Right" LineHeight="15" /></HyperlinkButton>
                                            </Grid>
                                            <ItemsControl ItemsSource="{x:Bind PaletteRows}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="local:SpeciesPaletteRow">
                                                        <Grid ColumnSpacing="14" Padding="6,7" BorderBrush="{ThemeResource KpiBorderBrush}" BorderThickness="0,1,0,0">
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="200" /><ColumnDefinition Width="70" /><ColumnDefinition Width="120" /><ColumnDefinition Width="120" /><ColumnDefinition Width="120" /><ColumnDefinition Width="120" /><ColumnDefinition Width="120" /><ColumnDefinition Width="120" /></Grid.ColumnDefinitions>
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <TextBlock Text="{x:Bind SpeciesCode}" FontWeight="SemiBold" />
                                                                <TextBlock Text="{x:Bind CommonName}" Foreground="{ThemeResource KpiMutedBrush}" TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="1" Text="{x:Bind CountText}" TextAlignment="Right" />
                                                            <TextBlock Grid.Column="2" Text="{x:Bind ValueText}" TextAlignment="Right" FontWeight="SemiBold" />
                                                            <TextBlock Grid.Column="3" Text="{x:Bind Co2Text}" TextAlignment="Right" />
                                                            <TextBlock Grid.Column="4" Text="{x:Bind OxygenText}" TextAlignment="Right" />
                                                            <TextBlock Grid.Column="5" Text="{x:Bind RunoffText}" TextAlignment="Right" />
                                                            <TextBlock Grid.Column="6" Text="{x:Bind PollutionText}" TextAlignment="Right" />
                                                            <TextBlock Grid.Column="7" Text="{x:Bind UpkeepText}" TextAlignment="Right" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </PivotItem>

            <PivotItem Header="Design scenarios">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <Grid Background="{ThemeResource KpiCanvasBrush}" Padding="22" CornerRadius="20" RowSpacing="16">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Scenario overview" FontSize="24" FontWeight="Bold" />
                                <TextBlock x:Name="ScenarioIntroText" Text="Every saved scenario side by side. A scenario is one option per design option set; save scenarios with Edit… above." Foreground="{ThemeResource KpiMutedBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" x:Name="ReferenceScenarioBox" Header="Compare against" MinWidth="260" DisplayMemberPath="Label"
                                SelectionChanged="ReferenceScenarioBox_SelectionChanged"
                                ToolTipService.ToolTip="The reference scenario: every other scenario shows its difference from this one, in units and %. Saved on the project." />
                        </Grid>
                        <!-- Metric rows × scenario columns, built in code (the number of scenarios varies). -->
                        <Border Grid.Row="1" Style="{StaticResource KpiSurfaceStyle}" Padding="18">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" VerticalScrollMode="Disabled">
                                <Grid x:Name="ScenarioTableHost" ColumnSpacing="0" RowSpacing="0" Margin="0,0,0,14" />
                            </ScrollViewer>
                        </Border>
                        <StackPanel Grid.Row="2" Spacing="8">
                            <TextBlock Text="Performance comparison" Style="{StaticResource KpiCardTitleStyle}" />
                            <TextBlock x:Name="ScenarioChartCaptionText" Text="Each bar is one scenario; the reference is outlined." Foreground="{ThemeResource KpiMutedBrush}" FontSize="12" TextWrapping="Wrap" />
                            <Grid x:Name="ScenarioChartsHost" ColumnSpacing="16" RowSpacing="16" />
                        </StackPanel>
                        <Grid Grid.Row="3" ColumnSpacing="16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource KpiSurfaceStyle}">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="Status distribution" Style="{StaticResource KpiCardTitleStyle}" />
                                    <ItemsControl ItemsSource="{x:Bind StatusBreakdownRows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="local:KpiBarRow">
                                                <Grid Margin="0,4" ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="130" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" MinWidth="90" /></Grid.ColumnDefinitions>
                                                    <TextBlock Text="{x:Bind Label}" />
                                                    <ProgressBar Grid.Column="1" Value="{x:Bind Percent}" Maximum="100" Height="11" Foreground="{ThemeResource KpiLeafBrush}" Background="{ThemeResource KpiChartTrackBrush}" />
                                                    <TextBlock Grid.Column="2" Text="{x:Bind ValueText}" HorizontalAlignment="Right" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource KpiSurfaceStyle}">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="How scenarios are compared" Style="{StaticResource KpiCardTitleStyle}" />
                                    <TextBlock x:Name="ProjectionMethodText" TextWrapping="Wrap" Foreground="{ThemeResource KpiMutedBrush}"
                                        Text="Each scenario counts the main model plus its chosen option in every set. Outlook figures add up year 1 to year N." />
                                    <TextBlock Text="• Canopy cover counts overlapping crowns once, over the site boundary chosen on Site &amp; Biodiversity." TextWrapping="Wrap" />
                                    <TextBlock Text="• Greenspace ratio = pervious ÷ (pervious + impervious) floor area; unclassified floors and building slabs are left out." TextWrapping="Wrap" />
                                    <TextBlock Text="• Net value = ecosystem value − maintenance cost, over the same outlook." TextWrapping="Wrap" />
                                    <TextBlock Text="• Embodied carbon is one-off; lower is better, like maintenance cost." TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </PivotItem>

            <PivotItem Header="Data explorer">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <Grid Background="{ThemeResource KpiCanvasBrush}" Padding="22" CornerRadius="20" RowSpacing="18" MinWidth="1180">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="3">
                                <TextBlock Text="CALCULATION STATUS" Style="{StaticResource KpiEyebrowStyle}" Foreground="{ThemeResource KpiAccentTextBrush}" />
                                <TextBlock Text="Tree records by status — select a card to isolate it below" FontSize="17" FontWeight="SemiBold" Foreground="{ThemeResource KpiInkBrush}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" x:Name="PeriodToggle" IsOn="True" OnContent="Annual" OffContent="Lifetime" Toggled="PeriodToggle_Toggled" VerticalAlignment="Center" />
                        </Grid>

                        <!-- Readiness lives here, with the status it summarises; the overview shows results only. -->
                        <Grid Grid.Row="1" ColumnSpacing="16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="380" /></Grid.ColumnDefinitions>
                            <Grid ColumnSpacing="10" RowSpacing="10" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Border x:Name="CalculatedCard" Style="{StaticResource KpiStatusCardStyle}" Tag="Calculated" Tapped="StatusCard_Tapped"><StackPanel Spacing="2"><TextBlock Text="CALCULATED" Style="{StaticResource KpiEyebrowStyle}" Foreground="{ThemeResource KpiAccentTextBrush}" /><TextBlock x:Name="CalculatedCountText" Text="—" FontSize="20" FontWeight="SemiBold" /></StackPanel></Border>
                                <Border x:Name="ReadyCard" Grid.Column="1" Style="{StaticResource KpiStatusCardStyle}" Tag="Ready" Tapped="StatusCard_Tapped"><StackPanel Spacing="2"><TextBlock Text="READY" Style="{StaticResource KpiEyebrowStyle}" Foreground="{ThemeResource KpiAccentTextBrush}" /><TextBlock x:Name="ReadyCountText" Text="—" FontSize="20" FontWeight="SemiBold" /></StackPanel></Border>
                                <Border x:Name="StaleCard" Grid.Column="2" Style="{StaticResource KpiStatusCardStyle}" Tag="Stale" Tapped="StatusCard_Tapped"><StackPanel Spacing="2"><TextBlock Text="STALE" Style="{StaticResource KpiEyebrowStyle}" Foreground="{ThemeResource LimWarningBrush}" /><TextBlock x:Name="StaleCountText" Text="—" FontSize="20" FontWeight="SemiBold" /></StackPanel></Border>
                                <Border x:Name="MissingCard" Grid.Column="3" Style="{StaticResource KpiStatusCardStyle}" Tag="MissingInput" Tapped="StatusCard_Tapped"><StackPanel Spacing="2"><TextBlock Text="MISSING" Style="{StaticResource KpiEyebrowStyle}" Foreground="{ThemeResource LimWarningBrush}" /><TextBlock x:Name="MissingCountText" Text="—" FontSize="20" FontWeight="SemiBold" /></StackPanel></Border>
                                <Border x:Name="InvalidCard" Grid.Row="1" Style="{StaticResource KpiStatusCardStyle}" Tag="InvalidInput" Tapped="StatusCard_Tapped"><StackPanel Spacing="2"><TextBlock Text="INVALID" Style="{StaticResource KpiEyebrowStyle}" Foreground="{ThemeResource LimErrorBrush}" /><TextBlock x:Name="InvalidCountText" Text="—" FontSize="20" FontWeight="SemiBold" /></StackPanel></Border>
                                <Border x:Name="WarningCard" Grid.Row="1" Grid.Column="1" Style="{StaticResource KpiStatusCardStyle}" Tag="APIWarning" Tapped="StatusCard_Tapped"><StackPanel Spacing="2"><TextBlock Text="API WARNING" Style="{StaticResource KpiEyebrowStyle}" Foreground="{ThemeResource LimWarningBrush}" /><TextBlock x:Name="WarningCountText" Text="—" FontSize="20" FontWeight="SemiBold" /></StackPanel></Border>
                                <Border x:Name="ErrorCard" Grid.Row="1" Grid.Column="2" Style="{StaticResource KpiStatusCardStyle}" Tag="APIError" Tapped="StatusCard_Tapped"><StackPanel Spacing="2"><TextBlock Text="API ERROR" Style="{StaticResource KpiEyebrowStyle}" Foreground="{ThemeResource LimErrorBrush}" /><TextBlock x:Name="ErrorCountText" Text="—" FontSize="20" FontWeight="SemiBold" /></StackPanel></Border>
                            </Grid>
                            <Border Grid.Column="1" Style="{StaticResource KpiSurfaceStyle}" Padding="18">
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Grid>
                                        <ProgressRing x:Name="ReadinessRing" Width="110" Height="110" IsIndeterminate="False" Maximum="100" Foreground="{ThemeResource KpiLeafBrush}" />
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock x:Name="ReadinessPercentText" Text="0%" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" />
                                            <TextBlock Text="ready" Foreground="{ThemeResource KpiMutedBrush}" HorizontalAlignment="Center" FontSize="12" />
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                                        <TextBlock Text="Data readiness" Style="{StaticResource KpiCardTitleStyle}" />
                                        <TextBlock Text="Only Calculated trees count towards benefit totals." Foreground="{ThemeResource KpiMutedBrush}" FontSize="12" TextWrapping="Wrap" />
                                        <TextBlock x:Name="ReadinessDetailText" Text="Refresh to inspect status coverage." FontWeight="SemiBold" Foreground="{ThemeResource KpiAccentTextBrush}" FontSize="12" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>

                        <TextBlock Grid.Row="2" x:Name="PeriodLabelText" Foreground="{ThemeResource KpiMutedBrush}" Text="Showing Annual benefits — click a status card above to filter trees." TextWrapping="Wrap" />

                        <Grid Grid.Row="3" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource KpiMetricCardStyle}"><StackPanel Spacing="2"><TextBlock Text="TREES" Style="{StaticResource KpiEyebrowStyle}" /><TextBlock x:Name="TreeCountText" Text="—" FontSize="18" FontWeight="SemiBold" /><TextBlock x:Name="TreeExcludedText" FontSize="10" Foreground="{ThemeResource KpiMutedBrush}" TextWrapping="Wrap" /></StackPanel></Border>
                            <Border Grid.Column="1" Style="{StaticResource KpiMetricCardStyle}"><StackPanel Spacing="2"><TextBlock Text="PLANTING AREAS" Style="{StaticResource KpiEyebrowStyle}" /><TextBlock x:Name="FloorCountText" Text="—" FontSize="18" FontWeight="SemiBold" /><TextBlock x:Name="FloorAreaText" FontSize="10" Foreground="{ThemeResource KpiMutedBrush}" TextWrapping="Wrap" /></StackPanel></Border>
                            <Border Grid.Column="2" Style="{StaticResource KpiMetricCardStyle}"><StackPanel Spacing="2"><TextBlock Text="AREA CARBON / EMBODIED" Style="{StaticResource KpiEyebrowStyle}" TextWrapping="Wrap" /><TextBlock x:Name="FloorCarbonText" Text="—" FontSize="18" FontWeight="SemiBold" /><TextBlock x:Name="FloorGwpText" FontSize="10" Foreground="{ThemeResource KpiMutedBrush}" TextWrapping="Wrap" /></StackPanel></Border>
                            <Border Grid.Column="3" Style="{StaticResource KpiMetricCardStyle}"><StackPanel Spacing="2"><TextBlock Text="AREA RUNOFF / POLLUTION" Style="{StaticResource KpiEyebrowStyle}" TextWrapping="Wrap" /><TextBlock x:Name="FloorRunoffText" Text="—" FontSize="18" FontWeight="SemiBold" /><TextBlock x:Name="FloorPollutionText" FontSize="10" Foreground="{ThemeResource KpiMutedBrush}" TextWrapping="Wrap" /></StackPanel></Border>
                            <Border Grid.Column="4" Style="{StaticResource KpiMetricCardStyle}"><StackPanel Spacing="2"><TextBlock Text="AREA BENEFIT / MAINTENANCE" Style="{StaticResource KpiEyebrowStyle}" TextWrapping="Wrap" /><TextBlock x:Name="FloorCostSavedText" Text="—" FontSize="18" FontWeight="SemiBold" /><TextBlock x:Name="MaintenanceSummaryText" FontSize="10" Foreground="{ThemeResource KpiMutedBrush}" TextWrapping="Wrap" /></StackPanel></Border>
                            <Border Grid.Column="5" Style="{StaticResource KpiMetricCardStyle}"><StackPanel Spacing="2"><TextBlock Text="CURRENCY" Style="{StaticResource KpiEyebrowStyle}" /><TextBlock x:Name="CurrencyText" Text="—" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" /></StackPanel></Border>
                        </Grid>

                        <!-- Benefit swim lanes: one per i-Tree benefit category, each a category total
                        followed by its own component metrics — same grouping, order, and labels as
                        the public i-Tree "MyTree Benefits" report (Carbon Dioxide Uptake / Storm
                        Water Mitigation / Air Pollution Removal). -->
                        <Border Grid.Row="4" Background="{ThemeResource KpiSurfaceBrush}" BorderBrush="{ThemeResource KpiForestBrush}" BorderThickness="6,1,1,1" CornerRadius="14" Padding="18,14">
                            <Grid ColumnSpacing="24">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="230" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="CARBON DIOXIDE UPTAKE" Style="{StaticResource KpiEyebrowStyle}" Foreground="{ThemeResource KpiAccentTextBrush}" TextWrapping="Wrap" />
                                    <TextBlock x:Name="CarbonUptakeCostText" Text="—" FontSize="22" FontWeight="Bold" Foreground="{ThemeResource KpiInkBrush}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="36" VerticalAlignment="Center">
                                    <StackPanel>
                                        <TextBlock Text="CARBON SEQUESTERED" Style="{StaticResource KpiEyebrowStyle}" FontSize="10" />
                                        <TextBlock x:Name="CarbonSequesteredSubText" Text="—" FontSize="16" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="CO₂ EQUIVALENT" Style="{StaticResource KpiEyebrowStyle}" FontSize="10" />
                                        <TextBlock x:Name="CO2EquivalentSubText" Text="—" FontSize="16" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="OXYGEN RELEASED" Style="{StaticResource KpiEyebrowStyle}" FontSize="10" />
                                        <TextBlock x:Name="OxygenSubText" Text="—" FontSize="16" FontWeight="SemiBold" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Row="5" Background="{ThemeResource KpiSurfaceBrush}" BorderBrush="{ThemeResource KpiWaterTextBrush}" BorderThickness="6,1,1,1" CornerRadius="14" Padding="18,14">
                            <Grid ColumnSpacing="24">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="230" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="STORM WATER MITIGATION" Style="{StaticResource KpiEyebrowStyle}" Foreground="{ThemeResource KpiWaterTextBrush}" TextWrapping="Wrap" />
                                    <TextBlock x:Name="StormWaterCostText" Text="—" FontSize="22" FontWeight="Bold" Foreground="{ThemeResource KpiInkBrush}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="36" VerticalAlignment="Center">
                                    <StackPanel>
                                        <TextBlock Text="RUNOFF AVOIDED" Style="{StaticResource KpiEyebrowStyle}" FontSize="10" />
                                        <TextBlock x:Name="RunoffAvoidedSubText" Text="—" FontSize="16" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="RAINFALL INTERCEPTED" Style="{StaticResource KpiEyebrowStyle}" FontSize="10" />
                                        <TextBlock x:Name="RainfallInterceptedSubText" Text="—" FontSize="16" FontWeight="SemiBold" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Row="6" Background="{ThemeResource KpiSurfaceBrush}" BorderBrush="{ThemeResource KpiAmberTextBrush}" BorderThickness="6,1,1,1" CornerRadius="14" Padding="18,14">
                            <Grid ColumnSpacing="24">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="230" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="AIR POLLUTION REMOVAL" Style="{StaticResource KpiEyebrowStyle}" Foreground="{ThemeResource KpiAmberTextBrush}" TextWrapping="Wrap" />
                                    <TextBlock x:Name="AirPollutionCostText" Text="—" FontSize="22" FontWeight="Bold" Foreground="{ThemeResource KpiInkBrush}" />
                                </StackPanel>
                                <ItemsControl Grid.Column="1" ItemsSource="{x:Bind AirPollutantRows}" VerticalAlignment="Center">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="28" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="local:KpiBarRow">
                                            <StackPanel>
                                                <TextBlock Text="{x:Bind Label}" Style="{StaticResource KpiEyebrowStyle}" FontSize="10" TextWrapping="Wrap" MaxWidth="110" />
                                                <TextBlock Text="{x:Bind ValueText}" FontSize="16" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>

                        <Border Grid.Row="7" Style="{StaticResource KpiSurfaceStyle}">
                            <Grid ColumnSpacing="18">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Grid x:Name="BenefitRingHost" Width="150" Height="150">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="1">
                                        <TextBlock Text="TOTAL" Style="{StaticResource KpiEyebrowStyle}" FontSize="10" HorizontalAlignment="Center" />
                                        <TextBlock x:Name="RingTotalText" Text="—" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                                <StackPanel Grid.Column="1" Spacing="10" VerticalAlignment="Center">
                                    <TextBlock Text="Benefit composition" Style="{StaticResource KpiCardTitleStyle}" />
                                    <TextBlock Text="Share of the trees' estimated money benefit by category" Foreground="{ThemeResource KpiMutedBrush}" FontSize="12" TextWrapping="Wrap" />
                                    <StackPanel Spacing="8">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <Ellipse Width="9" Height="9" Fill="{ThemeResource KpiAccentTextBrush}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="Carbon dioxide uptake" FontSize="12.5" Margin="6,0,0,0" />
                                            <TextBlock Grid.Column="2" x:Name="RingCarbonLegendText" Text="—" FontSize="12.5" FontWeight="SemiBold" />
                                        </Grid>
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <Ellipse Width="9" Height="9" Fill="{ThemeResource KpiWaterTextBrush}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="Storm water mitigation" FontSize="12.5" Margin="6,0,0,0" />
                                            <TextBlock Grid.Column="2" x:Name="RingStormWaterLegendText" Text="—" FontSize="12.5" FontWeight="SemiBold" />
                                        </Grid>
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <Ellipse Width="9" Height="9" Fill="{ThemeResource KpiChartAmberBrush}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="Air pollution removal" FontSize="12.5" Margin="6,0,0,0" />
                                            <TextBlock Grid.Column="2" x:Name="RingAirPollutionLegendText" Text="—" FontSize="12.5" FontWeight="SemiBold" />
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Full-width tables, the planting-area one under the tree one. Each benefit group
                        is a vertical swim lane in a pale wash of its card's colour, running behind the
                        header and every row. Units are in the headers, so cells are plain numbers. -->
                        <Border Grid.Row="8" Style="{StaticResource KpiSurfaceStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="By species (trees)" Style="{StaticResource KpiCardTitleStyle}" />
                                <Grid>
                                    <Grid ColumnSpacing="14" Padding="6,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="*" MinWidth="160" /><ColumnDefinition Width="70" /><ColumnDefinition Width="110" /><ColumnDefinition Width="110" /><ColumnDefinition Width="110" /><ColumnDefinition Width="110" /><ColumnDefinition Width="110" /><ColumnDefinition Width="110" /><ColumnDefinition Width="110" /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions>
                                        <Border Grid.Column="3" Grid.ColumnSpan="3" Background="{ThemeResource LimLaneGreenBrush}" Style="{StaticResource LimTableLaneStyle}" />
                                        <Border Grid.Column="6" Grid.ColumnSpan="2" Background="{ThemeResource LimLaneBlueBrush}" Style="{StaticResource LimTableLaneStyle}" />
                                        <Border Grid.Column="8" Grid.ColumnSpan="2" Background="{ThemeResource LimLaneAmberBrush}" Style="{StaticResource LimTableLaneStyle}" />
                                        <Border Grid.Column="10" Background="{ThemeResource LimLaneGreyBrush}" Style="{StaticResource LimTableLaneStyle}" />
                                    </Grid>
                                    <StackPanel>
                                        <Grid ColumnSpacing="14" Padding="6,10,6,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="*" MinWidth="160" /><ColumnDefinition Width="70" /><ColumnDefinition Width="110" /><ColumnDefinition Width="110" /><ColumnDefinition Width="110" /><ColumnDefinition Width="110" /><ColumnDefinition Width="110" /><ColumnDefinition Width="110" /><ColumnDefinition Width="110" /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="3" Grid.ColumnSpan="3" Text="CARBON" Style="{StaticResource KpiEyebrowStyle}" Foreground="{ThemeResource KpiAccentTextBrush}" HorizontalAlignment="Center" />
                                            <TextBlock Grid.Column="6" Grid.ColumnSpan="2" Text="WATER" Style="{StaticResource KpiEyebrowStyle}" Foreground="{ThemeResource KpiWaterTextBrush}" HorizontalAlignment="Center" />
                                            <TextBlock Grid.Column="8" Grid.ColumnSpan="2" Text="AIR QUALITY" Style="{StaticResource KpiEyebrowStyle}" Foreground="{ThemeResource KpiAmberTextBrush}" HorizontalAlignment="Center" />
                                            <TextBlock Grid.Column="10" Text="MAINTENANCE" Style="{StaticResource KpiEyebrowStyle}" HorizontalAlignment="Center" />
                                        </Grid>
                                        <Grid ColumnSpacing="14" Padding="6,6,6,8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="*" MinWidth="160" /><ColumnDefinition Width="70" /><ColumnDefinition Width="110" /><ColumnDefinition Width="110" /><ColumnDefinition Width="110" /><ColumnDefinition Width="110" /><ColumnDefinition Width="110" /><ColumnDefinition Width="110" /><ColumnDefinition Width="110" /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="Code" Style="{StaticResource KpiEyebrowStyle}" VerticalAlignment="Bottom" />
                                            <TextBlock Grid.Column="1" Text="Common name" Style="{StaticResource KpiEyebrowStyle}" VerticalAlignment="Bottom" />
                                            <TextBlock Grid.Column="2" Text="Trees" Style="{StaticResource KpiEyebrowStyle}" TextAlignment="Right" VerticalAlignment="Bottom" />
                                            <TextBlock Grid.Column="3" x:Name="SpeciesCarbonHeader" Text="Carbon" Style="{StaticResource KpiEyebrowStyle}" TextAlignment="Right" VerticalAlignment="Bottom" LineHeight="15" />
                                            <TextBlock Grid.Column="4" x:Name="SpeciesOxygenHeader" Text="Oxygen" Style="{StaticResource KpiEyebrowStyle}" TextAlignment="Right" VerticalAlignment="Bottom" LineHeight="15" />
                                            <TextBlock Grid.Column="5" x:Name="SpeciesCarbonCostHeader" Text="Carbon" Style="{StaticResource KpiEyebrowStyle}" TextAlignment="Right" VerticalAlignment="Bottom" LineHeight="15" />
                                            <TextBlock Grid.Column="6" x:Name="SpeciesRunoffHeader" Text="Runoff" Style="{StaticResource KpiEyebrowStyle}" TextAlignment="Right" VerticalAlignment="Bottom" LineHeight="15" />
                                            <TextBlock Grid.Column="7" x:Name="SpeciesStormCostHeader" Text="Water" Style="{StaticResource KpiEyebrowStyle}" TextAlignment="Right" VerticalAlignment="Bottom" LineHeight="15" />
                                            <TextBlock Grid.Column="8" x:Name="SpeciesPollutionHeader" Text="Pollution" Style="{StaticResource KpiEyebrowStyle}" TextAlignment="Right" VerticalAlignment="Bottom" LineHeight="15" />
                                            <TextBlock Grid.Column="9" x:Name="SpeciesAirCostHeader" Text="Air" Style="{StaticResource KpiEyebrowStyle}" TextAlignment="Right" VerticalAlignment="Bottom" LineHeight="15" />
                                            <TextBlock Grid.Column="10" x:Name="SpeciesUpkeepHeader" Text="Maintenance" Style="{StaticResource KpiEyebrowStyle}" TextAlignment="Right" VerticalAlignment="Bottom" LineHeight="15" />
                                        </Grid>
                                        <ItemsControl ItemsSource="{x:Bind SpeciesSubtotals}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="local:SpeciesSubtotalRow">
                                                    <Grid Padding="6,7" ColumnSpacing="14" BorderBrush="{ThemeResource KpiBorderBrush}" BorderThickness="0,1,0,0">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="*" MinWidth="160" /><ColumnDefinition Width="70" /><ColumnDefinition Width="110" /><ColumnDefinition Width="110" /><ColumnDefinition Width="110" /><ColumnDefinition Width="110" /><ColumnDefinition Width="110" /><ColumnDefinition Width="110" /><ColumnDefinition Width="110" /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions>
                                                        <TextBlock Text="{x:Bind SpeciesCode}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="1" Text="{x:Bind CommonName}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind CommonName}" />
                                                        <TextBlock Grid.Column="2" Text="{x:Bind TreeCount}" TextAlignment="Right" />
                                                        <TextBlock Grid.Column="3" Text="{x:Bind CarbonSequestered}" TextAlignment="Right" />
                                                        <TextBlock Grid.Column="4" Text="{x:Bind OxygenProduced}" TextAlignment="Right" />
                                                        <TextBlock Grid.Column="5" Text="{x:Bind CarbonCostSaved}" TextAlignment="Right" />
                                                        <TextBlock Grid.Column="6" Text="{x:Bind RunoffAvoided}" TextAlignment="Right" />
                                                        <TextBlock Grid.Column="7" Text="{x:Bind StormWaterCostSaved}" TextAlignment="Right" />
                                                        <TextBlock Grid.Column="8" Text="{x:Bind PollutionMassRemoved}" TextAlignment="Right" />
                                                        <TextBlock Grid.Column="9" Text="{x:Bind AirPollutionCostSaved}" TextAlignment="Right" />
                                                        <TextBlock Grid.Column="10" Text="{x:Bind MaintenanceCost}" TextAlignment="Right" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="9" Style="{StaticResource KpiSurfaceStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Planting areas by landscape-data type" Style="{StaticResource KpiCardTitleStyle}" />
                                <Grid>
                                    <Grid ColumnSpacing="14" Padding="6,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="200" /><ColumnDefinition Width="60" /><ColumnDefinition Width="110" /><ColumnDefinition Width="110" /><ColumnDefinition Width="110" /><ColumnDefinition Width="120" /><ColumnDefinition Width="110" /><ColumnDefinition Width="110" /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions>
                                        <Border Grid.Column="3" Grid.ColumnSpan="3" Background="{ThemeResource LimLaneGreenBrush}" Style="{StaticResource LimTableLaneStyle}" />
                                        <Border Grid.Column="6" Background="{ThemeResource LimLaneBlueBrush}" Style="{StaticResource LimTableLaneStyle}" />
                                        <Border Grid.Column="7" Background="{ThemeResource LimLaneAmberBrush}" Style="{StaticResource LimTableLaneStyle}" />
                                        <Border Grid.Column="8" Background="{ThemeResource LimLaneGreyBrush}" Style="{StaticResource LimTableLaneStyle}" />
                                    </Grid>
                                    <StackPanel>
                                        <Grid ColumnSpacing="14" Padding="6,10,6,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="200" /><ColumnDefinition Width="60" /><ColumnDefinition Width="110" /><ColumnDefinition Width="110" /><ColumnDefinition Width="110" /><ColumnDefinition Width="120" /><ColumnDefinition Width="110" /><ColumnDefinition Width="110" /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="3" Grid.ColumnSpan="3" Text="CARBON" Style="{StaticResource KpiEyebrowStyle}" Foreground="{ThemeResource KpiAccentTextBrush}" HorizontalAlignment="Center" />
                                            <TextBlock Grid.Column="6" Text="WATER" Style="{StaticResource KpiEyebrowStyle}" Foreground="{ThemeResource KpiWaterTextBrush}" HorizontalAlignment="Center" />
                                            <TextBlock Grid.Column="7" Text="AIR QUALITY" Style="{StaticResource KpiEyebrowStyle}" Foreground="{ThemeResource KpiAmberTextBrush}" HorizontalAlignment="Center" />
                                            <TextBlock Grid.Column="8" Text="MAINTENANCE" Style="{StaticResource KpiEyebrowStyle}" HorizontalAlignment="Center" />
                                        </Grid>
                                        <Grid ColumnSpacing="14" Padding="6,6,6,8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="200" /><ColumnDefinition Width="60" /><ColumnDefinition Width="110" /><ColumnDefinition Width="110" /><ColumnDefinition Width="110" /><ColumnDefinition Width="120" /><ColumnDefinition Width="110" /><ColumnDefinition Width="110" /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="Type" Style="{StaticResource KpiEyebrowStyle}" VerticalAlignment="Bottom" />
                                            <TextBlock Grid.Column="1" Text="Count" Style="{StaticResource KpiEyebrowStyle}" TextAlignment="Right" VerticalAlignment="Bottom" />
                                            <TextBlock Grid.Column="2" x:Name="FloorAreaHeader" Text="Area" Style="{StaticResource KpiEyebrowStyle}" TextAlignment="Right" VerticalAlignment="Bottom" LineHeight="15" />
                                            <TextBlock Grid.Column="3" x:Name="FloorCarbonHeader" Text="Carbon" Style="{StaticResource KpiEyebrowStyle}" TextAlignment="Right" VerticalAlignment="Bottom" LineHeight="15" />
                                            <TextBlock Grid.Column="4" x:Name="FloorOxygenHeader" Text="Oxygen" Style="{StaticResource KpiEyebrowStyle}" TextAlignment="Right" VerticalAlignment="Bottom" LineHeight="15" />
                                            <TextBlock Grid.Column="5" x:Name="FloorEmbodiedHeader" Text="Embodied" Style="{StaticResource KpiEyebrowStyle}" TextAlignment="Right" VerticalAlignment="Bottom" LineHeight="15" />
                                            <TextBlock Grid.Column="6" x:Name="FloorRunoffHeader" Text="Runoff" Style="{StaticResource KpiEyebrowStyle}" TextAlignment="Right" VerticalAlignment="Bottom" LineHeight="15" />
                                            <TextBlock Grid.Column="7" x:Name="FloorPollutionHeader" Text="Pollution" Style="{StaticResource KpiEyebrowStyle}" TextAlignment="Right" VerticalAlignment="Bottom" LineHeight="15" />
                                            <TextBlock Grid.Column="8" x:Name="FloorMaintenanceHeader" Text="Maintenance" Style="{StaticResource KpiEyebrowStyle}" TextAlignment="Right" VerticalAlignment="Bottom" LineHeight="15" />
                                        </Grid>
                                        <ItemsControl ItemsSource="{x:Bind FloorSubtotals}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="local:FloorSubtotalRow">
                                                    <Grid Padding="6,7" ColumnSpacing="14" BorderBrush="{ThemeResource KpiBorderBrush}" BorderThickness="0,1,0,0">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="200" /><ColumnDefinition Width="60" /><ColumnDefinition Width="110" /><ColumnDefinition Width="110" /><ColumnDefinition Width="110" /><ColumnDefinition Width="120" /><ColumnDefinition Width="110" /><ColumnDefinition Width="110" /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions>
                                                        <TextBlock Text="{x:Bind LdsType}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind LdsType}" />
                                                        <TextBlock Grid.Column="1" Text="{x:Bind FloorCount}" TextAlignment="Right" />
                                                        <TextBlock Grid.Column="2" Text="{x:Bind AreaSquareMeters}" TextAlignment="Right" />
                                                        <TextBlock Grid.Column="3" Text="{x:Bind CarbonSequestered}" TextAlignment="Right" />
                                                        <TextBlock Grid.Column="4" Text="{x:Bind OxygenProduced}" TextAlignment="Right" />
                                                        <TextBlock Grid.Column="5" Text="{x:Bind TotalGwp}" TextAlignment="Right" />
                                                        <TextBlock Grid.Column="6" Text="{x:Bind RunoffAvoided}" TextAlignment="Right" />
                                                        <TextBlock Grid.Column="7" Text="{x:Bind PollutionMassRemoved}" TextAlignment="Right" />
                                                        <TextBlock Grid.Column="8" Text="{x:Bind MaintenanceCost}" TextAlignment="Right" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </PivotItem>
            <PivotItem Header="Site &amp; Biodiversity">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Background="{ThemeResource KpiCanvasBrush}" Padding="22" CornerRadius="20" RowSpacing="16">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock Text="Site &amp; Biodiversity KPIs" FontSize="24" FontWeight="Bold" />
                            <TextBlock Text="Canopy Cover and Softscape Surface Ratio are percentages of the site boundary chosen below: a Revit property line, all property lines, or the area entered on Project Information (!_S_PLT_Site_TotalArea_Area). Habitat Connectivity Score is entered after external GIS connectivity modelling, not calculated here." Foreground="{ThemeResource KpiMutedBrush}" TextWrapping="Wrap" />
                            <ComboBox x:Name="SiteBoundaryBox" Header="Site boundary (for Canopy Cover and Softscape Surface Ratio)" MinWidth="420" Margin="0,6,0,0"
                                DisplayMemberPath="Label" SelectionChanged="SiteBoundaryBox_SelectionChanged" />
                        </StackPanel>

                        <Grid Grid.Row="1" ColumnSpacing="10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource KpiMetricCardStyle}">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="CANOPY COVER" Style="{StaticResource KpiEyebrowStyle}" />
                                    <TextBlock x:Name="CanopyCoverText" Text="—" FontSize="20" FontWeight="SemiBold" />
                                    <TextBlock x:Name="CanopyCoverDetailText" FontSize="10" Foreground="{ThemeResource KpiMutedBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource KpiMetricCardStyle}">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="SOFTSCAPE SURFACE RATIO" Style="{StaticResource KpiEyebrowStyle}" TextWrapping="Wrap" />
                                    <TextBlock x:Name="SoftscapeRatioText" Text="—" FontSize="20" FontWeight="SemiBold" />
                                    <TextBlock x:Name="SoftscapeRatioDetailText" FontSize="10" Foreground="{ThemeResource KpiMutedBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource KpiMetricCardStyle}">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="GREENSPACE RATIO" Style="{StaticResource KpiEyebrowStyle}" TextWrapping="Wrap"
                                        ToolTipService.ToolTip="Pervious ÷ (pervious + impervious) floor area. Unclassified floors and building slabs are left out and listed below the figure." />
                                    <TextBlock x:Name="GreenspaceRatioText" Text="—" FontSize="20" FontWeight="SemiBold" />
                                    <TextBlock x:Name="GreenspaceRatioDetailText" FontSize="10" Foreground="{ThemeResource KpiMutedBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="3" Style="{StaticResource KpiMetricCardStyle}">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="BIODIVERSITY ADDED" Style="{StaticResource KpiEyebrowStyle}" />
                                    <TextBlock x:Name="BiodiversityAddedText" Text="—" FontSize="20" FontWeight="SemiBold" />
                                    <TextBlock x:Name="BiodiversityAddedDetailText" FontSize="10" Foreground="{ThemeResource KpiMutedBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="4" Style="{StaticResource KpiMetricCardStyle}">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="NATIVE SPECIES RATIO" Style="{StaticResource KpiEyebrowStyle}" TextWrapping="Wrap" />
                                    <TextBlock x:Name="NativeSpeciesRatioText" Text="—" FontSize="20" FontWeight="SemiBold" />
                                    <TextBlock x:Name="NativeSpeciesRatioDetailText" FontSize="10" Foreground="{ThemeResource KpiMutedBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="2" ColumnSpacing="10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource KpiMetricCardStyle}">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="PHENOLOGICAL RESILIENCE" Style="{StaticResource KpiEyebrowStyle}" TextWrapping="Wrap" />
                                    <TextBlock x:Name="PhenologicalResilienceText" Text="—" FontSize="20" FontWeight="SemiBold" />
                                    <TextBlock x:Name="PhenologicalResilienceDetailText" FontSize="10" Foreground="{ThemeResource KpiMutedBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource KpiMetricCardStyle}">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="FUNCTIONAL DIVERSITY INDEX" Style="{StaticResource KpiEyebrowStyle}" TextWrapping="Wrap" />
                                    <TextBlock x:Name="FunctionalDiversityText" Text="—" FontSize="20" FontWeight="SemiBold" />
                                    <TextBlock x:Name="FunctionalDiversityDetailText" FontSize="10" Foreground="{ThemeResource KpiMutedBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource KpiMetricCardStyle}">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="HABITAT CONNECTIVITY SCORE" Style="{StaticResource KpiEyebrowStyle}" TextWrapping="Wrap" />
                                    <TextBlock x:Name="HabitatConnectivityText" Text="—" FontSize="20" FontWeight="SemiBold" />
                                    <TextBlock x:Name="HabitatConnectivityDetailText" FontSize="10" Foreground="{ThemeResource KpiMutedBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="3" Style="{StaticResource KpiMetricCardStyle}">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="LIGHTING IMPACT REDUCTION" Style="{StaticResource KpiEyebrowStyle}" TextWrapping="Wrap" />
                                    <TextBlock x:Name="LightingImpactText" Text="—" FontSize="20" FontWeight="SemiBold" />
                                    <TextBlock x:Name="LightingImpactDetailText" FontSize="10" Foreground="{ThemeResource KpiMutedBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="3" ColumnSpacing="10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource KpiMetricCardStyle}">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="BNG NET CHANGE (ON-SITE HABITAT)" Style="{StaticResource KpiEyebrowStyle}" TextWrapping="Wrap" />
                                    <TextBlock x:Name="BngNetChangeText" Text="—" FontSize="20" FontWeight="SemiBold" />
                                    <TextBlock x:Name="BngNetChangeDetailText" FontSize="10" Foreground="{ThemeResource KpiMutedBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource KpiMetricCardStyle}">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="BNG BASELINE UNITS" Style="{StaticResource KpiEyebrowStyle}" TextWrapping="Wrap" />
                                    <TextBlock x:Name="BngBaselineText" Text="—" FontSize="20" FontWeight="SemiBold" />
                                    <TextBlock x:Name="BngBaselineDetailText" FontSize="10" Foreground="{ThemeResource KpiMutedBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource KpiMetricCardStyle}">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="BNG POST-INTERVENTION UNITS" Style="{StaticResource KpiEyebrowStyle}" TextWrapping="Wrap" />
                                    <TextBlock x:Name="BngPostText" Text="—" FontSize="20" FontWeight="SemiBold" />
                                    <TextBlock x:Name="BngPostDetailText" FontSize="10" Foreground="{ThemeResource KpiMutedBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="3" Style="{StaticResource KpiMetricCardStyle}">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="BNG NEEDS ATTENTION" Style="{StaticResource KpiEyebrowStyle}" TextWrapping="Wrap" />
                                    <TextBlock x:Name="BngAttentionText" Text="—" FontSize="20" FontWeight="SemiBold" />
                                    <TextBlock x:Name="BngAttentionDetailText" FontSize="10" Foreground="{ThemeResource KpiMutedBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Grid.Row="4" Style="{StaticResource KpiSurfaceStyle}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="BNG post-intervention habitat units by broad habitat" Style="{StaticResource KpiCardTitleStyle}" />
                                <TextBlock x:Name="BngHabitatEmptyText" Foreground="{ThemeResource KpiMutedBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
                                <ItemsControl ItemsSource="{x:Bind BngHabitatRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="local:KpiBarRow">
                                            <Grid Margin="0,3" ColumnSpacing="10">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions>
                                                <TextBlock Text="{x:Bind Label}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Detail}" />
                                                <ProgressBar Grid.Column="1" Value="{x:Bind Percent}" Maximum="100" Height="10" Foreground="{ThemeResource KpiLeafBrush}" Background="{ThemeResource KpiChartTrackBrush}" />
                                                <TextBlock Grid.Column="2" Text="{x:Bind ValueText}" HorizontalAlignment="Right" FontWeight="SemiBold" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="5" Style="{StaticResource KpiSurfaceStyle}">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Data entry" Style="{StaticResource KpiCardTitleStyle}" />
                                <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource KpiMutedBrush}" Text="Tag each Planting Type's !_S_PLT_iTreeSpecies_NativeStatus_Text, _BloomMonths_Text, and _EcologicalFunctions_Text; each Lighting Fixture Type's !_S_PLT_Lighting_DarkSkyCompliant_Text (Yes/No); and Project Information's !_S_PLT_Site_TotalArea_Area and !_S_PLT_Site_HabitatConnectivityScore_Number. Softscape Surface Ratio infers Pervious/Impervious automatically from each floor's LDS Type — tag !_S_PLT_LDS_SurfaceClass_Text only to override that guess. BNG units come from Floor Calculator's BNG tab and each floor's Revit phases: floors created in the first phase (e.g. Existing) are the baseline (metric sheet A-1) — retained, or lost if demolished, and enhanced (A-3) when !_S_PLT_BNGInput_Enhanced_YesNo is ticked; floors created later (e.g. New Construction) are new habitat (A-2). Net change = post-intervention (retained + enhanced + created) − baseline; recalculate in Floor Calculator if a floor shows as stale. Run &quot;Import Shared Parameter&quot; first if these parameters aren't bound yet." />
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </PivotItem>
        </Pivot>

        <Grid Grid.Row="3" Margin="0,8,0,0" ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Button Grid.Column="4" Content="Show original data" Click="ShowOriginalData_Click" Style="{StaticResource LimSecondaryButtonStyle}"
                ToolTipService.ToolTip="One row per tree (or planting area) with every value exactly as stored in Revit" />
            <Button Content="Export PNG" Click="ExportImage_Click" Style="{StaticResource LimSecondaryButtonStyle}" />
            <Button Grid.Column="1" Content="Export SVG" Click="ExportSvg_Click" Style="{StaticResource LimSecondaryButtonStyle}" />
            <Button Grid.Column="2" Content="Export Excel" Click="ExportExcel_Click" Style="{StaticResource LimSecondaryButtonStyle}" />
            <Button Grid.Column="3" Content="Export JSON" Click="ExportJson_Click" Style="{StaticResource LimSecondaryButtonStyle}" />
            <TextBlock Grid.Column="5" x:Name="StatusText" Style="{StaticResource LimMutedTextStyle}" VerticalAlignment="Center" Text="Refresh from Revit or open the last cached snapshot." />
        </Grid>

        <ProgressRing x:Name="BusyIndicator" Grid.RowSpan="4" Width="44" Height="44" IsActive="False" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Grid>
</Page>
