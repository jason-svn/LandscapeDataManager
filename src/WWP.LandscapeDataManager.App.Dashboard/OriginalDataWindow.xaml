<Window
    x:Class="WWP.LandscapeDataManager.App.Dashboard.OriginalDataWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WWP.LandscapeDataManager.App.Dashboard"
    xmlns:ui="using:WWP.LandscapeDataManager.SharedUI"
    Title="Original data — LIM Landscape Data">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="24,18" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="2">
            <TextBlock Text="Original data" FontSize="25" FontWeight="Bold" />
            <TextBlock x:Name="SubtitleText" Style="{StaticResource LimPageSubtitleStyle}" TextWrapping="Wrap"
                       Text="Every element and every value the Dashboard read from Revit, exactly as stored — no unit or currency conversion." />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="DatasetBox" Header="Show" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="DatasetBox_SelectionChanged">
                <ComboBoxItem Content="Trees (Planting)" />
                <ComboBoxItem Content="Planting areas (Floors)" />
            </ComboBox>
            <TextBox Grid.Column="1" x:Name="SearchBox" Header="Search any column" PlaceholderText="Species, type, level, ID…" TextChanged="SearchBox_TextChanged" />
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource LimCardStyle}" Padding="0">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled"
                          VerticalScrollBarVisibility="Disabled" VerticalScrollMode="Disabled">
                <!-- The shared table language: related columns sit in a swim lane that runs behind the
                     header and the rows, named in capitals above; each header is the name, then its
                     unit or qualifier. Lanes, group names, headers and cells share each column's width. -->
                <Grid x:Name="TableRoot" HorizontalAlignment="Left">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <ItemsControl x:Name="LaneRow" Grid.RowSpan="3" Margin="12,0" IsTabStop="False" ui:TableLanes.FollowRows="True">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:OriginalDataLane">
                                <Border Width="{x:Bind BandWidth}" Margin="3,0" CornerRadius="10" Background="{x:Bind Background}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl x:Name="GroupRow" Margin="12,10,12,0" IsTabStop="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:OriginalDataLane">
                                <TextBlock Width="{x:Bind Width}" Text="{x:Bind Label}" Style="{StaticResource LimTableGroupStyle}"
                                           Foreground="{x:Bind Foreground}" TextAlignment="Center" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl Grid.Row="1" x:Name="HeaderRow" Margin="12,6,12,8" IsTabStop="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:OriginalDataCell">
                                <TextBlock Width="{x:Bind Width}" Text="{x:Bind Text}" Style="{StaticResource LimTableHeaderStyle}"
                                           TextAlignment="{x:Bind Alignment}" Padding="8,0,6,0" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ListView Grid.Row="2" x:Name="RowsList" SelectionMode="Extended" Padding="0,0,0,8"
                              SelectionChanged="RowsList_SelectionChanged">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource LimTableItemStyle}">
                                <Setter Property="Padding" Value="12,0" />
                                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:OriginalDataRow">
                                <Border Padding="0,7" BorderBrush="{ThemeResource LimTableDividerBrush}" BorderThickness="0,1,0,0">
                                    <ItemsControl ItemsSource="{x:Bind Cells}" IsTabStop="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="local:OriginalDataCell">
                                                <TextBlock Width="{x:Bind Width}" Text="{x:Bind Text}" Padding="8,0,6,0" TextAlignment="{x:Bind Alignment}"
                                                           TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Text}"
                                                           VerticalAlignment="Center" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="3" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="SelectInRevitButton" Content="Select in Revit" Click="SelectInRevit_Click" IsEnabled="False" Style="{StaticResource LimSecondaryButtonStyle}" />
            <Button Grid.Column="1" x:Name="ZoomInRevitButton" Content="Zoom to in Revit" Click="ZoomInRevit_Click" IsEnabled="False" Style="{StaticResource LimSecondaryButtonStyle}" />
            <Button Grid.Column="2" Content="Export CSV" Click="ExportCsv_Click" Style="{StaticResource LimSecondaryButtonStyle}" />
            <TextBlock Grid.Column="3" x:Name="StatusText" Style="{StaticResource LimMutedTextStyle}" VerticalAlignment="Center" TextWrapping="Wrap" />
        </Grid>
    </Grid>
</Window>
