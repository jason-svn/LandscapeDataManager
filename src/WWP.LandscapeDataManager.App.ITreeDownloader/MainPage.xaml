<Page
    x:Class="WWP.LandscapeDataManager.App.ITreeDownloader.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WWP.LandscapeDataManager.App.ITreeDownloader">

    <ScrollViewer>
        <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="{StaticResource LimPageMargin}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Spacing="4">
                <TextBlock Text="i-Tree Species Catalogue" Style="{StaticResource LimPageTitleStyle}" />
                <TextBlock
                    Text="Downloads species code, common name, scientific name, and species type from i-Tree, matches by species code, and never touches columns or species it doesn't manage."
                    Style="{StaticResource LimPageSubtitleStyle}" />
            </StackPanel>

            <!-- Step 1: API key + scope -->
            <Border Grid.Row="1" Margin="0,20,0,0" Style="{StaticResource LimCardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="STEP 1 — SOURCE &amp; SCOPE" Style="{StaticResource LimSectionHeaderStyle}" />
                    <TextBlock x:Name="ApiKeyStatusText" Style="{StaticResource LimMutedTextStyle}" />
                    <ComboBox x:Name="ScopeBox" Header="Local catalogue scope" SelectedIndex="0" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="Project species (recommended) — only species used in this model" />
                        <ComboBoxItem Content="Full catalogue — cache every recognized species locally" />
                    </ComboBox>
                    <TextBlock
                        Text="Either scope only ever writes Revit types that already have a Species_Code — a Revit schedule can't list a species with no modeled type. Full catalogue just keeps more in the local lookup database for later."
                        Style="{StaticResource LimMutedTextStyle}" />
                </StackPanel>
            </Border>

            <!-- Step 2: destinations -->
            <Border Grid.Row="2" Margin="0,16,0,0" Style="{StaticResource LimCardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="STEP 2 — ALSO EXPORT TO EXCEL (OPTIONAL)" Style="{StaticResource LimSectionHeaderStyle}" />
                    <TextBlock
                        Text="Downloading always caches the full catalogue locally for Tree Searcher, and always reconciles species data on modeled types that already have a Species_Code entered. Exporting to Excel is optional, on top of that."
                        Style="{StaticResource LimMutedTextStyle}" />
                    <CheckBox x:Name="ExportExcelCheckBox" Content="Export to an Excel workbook"
                              Checked="DestinationCheckBox_Changed" Unchecked="DestinationCheckBox_Changed" />

                    <Grid x:Name="ExcelOptionsPanel" ColumnSpacing="10" RowSpacing="10" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBox x:Name="ExcelPathBox" Header="Workbook path" PlaceholderText="Create a new .xlsx or select an existing .xlsx/.xlsm" />
                        <Button Grid.Column="1" Content="Existing..." Click="BrowseExistingWorkbook_Click" VerticalAlignment="Bottom" Style="{StaticResource LimSecondaryButtonStyle}" />
                        <Button Grid.Column="2" Content="New..." Click="ChooseNewWorkbook_Click" VerticalAlignment="Bottom" Style="{StaticResource LimSecondaryButtonStyle}" />
                        <TextBox Grid.Row="1" x:Name="WorksheetBox" Header="Worksheet" Text="Species Catalogue" />
                        <CheckBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" x:Name="AppendMissingCheckBox"
                                  Content="Append species not already in the sheet" IsChecked="True" VerticalAlignment="Bottom" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Step 3: download & apply -->
            <Border Grid.Row="3" Margin="0,16,0,0" Style="{StaticResource LimCardStyle}">
                <StackPanel Spacing="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="STEP 3 — DOWNLOAD &amp; APPLY" Style="{StaticResource LimSectionHeaderStyle}" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="Download &amp; apply" Click="Download_Click" Style="{StaticResource LimPrimaryButtonStyle}" />
                    </Grid>
                    <TextBlock x:Name="StatusText" Style="{StaticResource LimMutedTextStyle}" Text="Enter your API key, choose destinations, then select Download &amp; apply." />
                </StackPanel>
            </Border>

            <!-- Results -->
            <Border Grid.Row="4" Margin="0,16,0,0" Style="{StaticResource LimCardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="RESULTS" Style="{StaticResource LimSectionHeaderStyle}" />
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource LimCardStyle}">
                            <StackPanel Spacing="3">
                                <TextBlock Text="ADDED" Style="{StaticResource LimSectionHeaderStyle}" />
                                <TextBlock x:Name="AddedCountText" Text="—" FontSize="20" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource LimCardStyle}">
                            <StackPanel Spacing="3">
                                <TextBlock Text="CHANGED" Style="{StaticResource LimSectionHeaderStyle}" />
                                <TextBlock x:Name="ChangedCountText" Text="—" FontSize="20" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource LimCardStyle}">
                            <StackPanel Spacing="3">
                                <TextBlock Text="DEPRECATED" Style="{StaticResource LimSectionHeaderStyle}" />
                                <TextBlock x:Name="DeprecatedCountText" Text="—" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource LimWarningBrush}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="3" Style="{StaticResource LimCardStyle}">
                            <StackPanel Spacing="3">
                                <TextBlock Text="UNCHANGED" Style="{StaticResource LimSectionHeaderStyle}" />
                                <TextBlock x:Name="UnchangedCountText" Text="—" FontSize="20" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <TextBlock x:Name="CatalogueVersionText" Style="{StaticResource LimMutedTextStyle}" Text="No catalogue downloaded yet." />

                    <ListView x:Name="ResultsList" ItemsSource="{x:Bind ResultRows}" SelectionMode="None" MaxHeight="260">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:SpeciesResultRow">
                                <Grid Padding="6" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="260" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Status}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind SpeciesCode}" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind TypeName}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind Message}" Opacity="0.75" TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

            <ProgressRing x:Name="BusyIndicator"
                          Grid.RowSpan="5"
                          Width="40"
                          Height="40"
                          IsActive="False"
                          Visibility="Collapsed"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
        </Grid>
    </ScrollViewer>
</Page>
