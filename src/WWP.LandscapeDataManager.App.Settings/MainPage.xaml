<Page
    x:Class="WWP.LandscapeDataManager.App.Settings.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WWP.LandscapeDataManager.App.Settings">

    <ScrollViewer>
        <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="{StaticResource LimPageMargin}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Text="Settings" Style="{StaticResource LimPageTitleStyle}" />
                    <TextBlock
                        Text="One place for every LIM credential and machine-wide default. Every other LIM tool reads these instead of asking for them again — save here once per Windows user."
                        Style="{StaticResource LimPageSubtitleStyle}" />
                    <TextBlock x:Name="SettingsFileStatusText" Style="{StaticResource LimMutedTextStyle}" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1" Content="Import settings…" Click="ImportSettings_Click" Style="{StaticResource LimSecondaryButtonStyle}" VerticalAlignment="Top"
                        ToolTipService.ToolTip="Apply a .limsettings file someone sent you to this project" />
                <Button Grid.Column="2" Content="Export settings…" Click="ExportSettings_Click" Style="{StaticResource LimSecondaryButtonStyle}" VerticalAlignment="Top"
                        ToolTipService.ToolTip="Save this project's LIM settings to a .limsettings file you can send to others" />
            </Grid>

            <Border Grid.Row="1" Margin="0,16,0,0" Style="{StaticResource LimCardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="UNITS &amp; CURRENCY" Style="{StaticResource LimSectionHeaderStyle}" />
                    <TextBlock
                        Text="Project-wide display preferences: Metric/Imperial for i-Tree's Mass and Volume benefit results, and which currency to report monetary benefits in. Changing currency also rescales every already-calculated planting instance's and floor's cost-saved figures to the new currency."
                        Style="{StaticResource LimMutedTextStyle}" TextWrapping="Wrap" />
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <RadioButtons x:Name="UnitSystemBox" Header="Unit system" MaxColumns="2">
                            <RadioButton Content="Metric" />
                            <RadioButton Content="Imperial" />
                        </RadioButtons>
                        <ComboBox Grid.Column="1" x:Name="CurrencyBox" Header="Currency" HorizontalAlignment="Stretch" SelectionChanged="CurrencyBox_SelectionChanged">
                            <ComboBoxItem Content="USD" />
                            <ComboBoxItem Content="GBP" />
                            <ComboBoxItem Content="EUR" />
                            <ComboBoxItem Content="CAD" />
                            <ComboBoxItem Content="AUD" />
                            <ComboBoxItem Content="NZD" />
                        </ComboBox>
                    </Grid>
                    <CheckBox x:Name="FixedRateCheckBox" Content="Use a fixed exchange rate instead of today's market rate"
                              Checked="FixedRateCheckBox_Changed" Unchecked="FixedRateCheckBox_Changed"
                              ToolTipService.ToolTip="For reports that must be costed at a set rate (e.g. a budget or appraisal rate). Every LIM tool on this project uses it." />
                    <Grid x:Name="FixedRatePanel" ColumnSpacing="10" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="1 USD =" VerticalAlignment="Center" />
                        <NumberBox Grid.Column="1" x:Name="FixedRateBox" Minimum="0" SpinButtonPlacementMode="Hidden"
                                   AutomationProperties.Name="Fixed exchange rate per US dollar" />
                        <TextBlock Grid.Column="2" x:Name="FixedRateCurrencyText" Text="GBP" VerticalAlignment="Center" />
                        <TextBox Grid.Column="3" x:Name="FixedRateNoteBox" PlaceholderText="Note, e.g. 2026 budget rate" />
                        <Button Grid.Column="4" Content="Use today's rate" Click="UseTodaysRate_Click" Style="{StaticResource LimSecondaryButtonStyle}" />
                    </Grid>
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Content="Save" Click="SaveUnitsAndCurrency_Click" Style="{StaticResource LimPrimaryButtonStyle}" />
                        <TextBlock Grid.Column="1" x:Name="UnitsAndCurrencyStatusText" Style="{StaticResource LimMutedTextStyle}" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Margin="0,16,0,0" Style="{StaticResource LimCardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="i-TREE API KEY" Style="{StaticResource LimSectionHeaderStyle}" />
                    <TextBlock
                        Text="Used by i-Tree Calculator, i-Tree Downloader, and Refresh &amp; Audit. Use Fetch from MyTree to pull the free public key straight from the i-Tree website — no browser or login needed. For a client-billed production job, paste an org key issued by Davey instead."
                        Style="{StaticResource LimMutedTextStyle}" TextWrapping="Wrap" />
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <PasswordBox x:Name="ITreeApiKeyBox" Header="i-Tree API key" />
                        <CheckBox Grid.Column="1" x:Name="RememberITreeKeyCheckBox" Content="Remember" IsChecked="True" VerticalAlignment="Bottom" Margin="0,0,0,8" />
                    </Grid>
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Content="Save" Click="SaveITreeKey_Click" Style="{StaticResource LimPrimaryButtonStyle}" />
                        <Button Grid.Column="1" Content="Clear" Click="ClearITreeKey_Click" Style="{StaticResource LimSecondaryButtonStyle}" />
                        <Button Grid.Column="2" x:Name="FetchITreeKeyButton" Content="Fetch from MyTree" Click="FetchITreeKey_Click" Style="{StaticResource LimSecondaryButtonStyle}" />
                        <TextBlock Grid.Column="3" x:Name="ITreeStatusText" Style="{StaticResource LimMutedTextStyle}" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Row="3" Margin="0,16,0,0" Style="{StaticResource LimCardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="AIRTABLE PERSONAL ACCESS TOKEN" Style="{StaticResource LimSectionHeaderStyle}" />
                    <TextBlock
                        Text="Used by Importer, Refresh &amp; Audit, and Floor Calculator (anything reading Airtable via its REST API). Not needed for the companion app's own public-share-link workflow."
                        Style="{StaticResource LimMutedTextStyle}" TextWrapping="Wrap" />
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <PasswordBox x:Name="AirtableTokenBox" Header="Airtable personal access token" />
                        <CheckBox Grid.Column="1" x:Name="RememberAirtableTokenCheckBox" Content="Remember" IsChecked="True" VerticalAlignment="Bottom" Margin="0,0,0,8" />
                    </Grid>
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Content="Save" Click="SaveAirtableToken_Click" Style="{StaticResource LimPrimaryButtonStyle}" />
                        <Button Grid.Column="1" Content="Clear" Click="ClearAirtableToken_Click" Style="{StaticResource LimSecondaryButtonStyle}" />
                        <TextBlock Grid.Column="2" x:Name="AirtableStatusText" Style="{StaticResource LimMutedTextStyle}" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Row="4" Margin="0,16,0,0" Style="{StaticResource LimCardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="WWP LANDSCAPE DATA SHEET SOURCE" Style="{StaticResource LimSectionHeaderStyle}" />
                    <TextBlock
                        Text="The shared company Airtable base Floor Calculator syncs its coefficient table from — a company-wide default, not tied to any one project."
                        Style="{StaticResource LimMutedTextStyle}" TextWrapping="Wrap" />
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="LdsBaseIdBox" Header="Base ID" />
                        <TextBox Grid.Column="1" x:Name="LdsTableIdBox" Header="Table ID or name" />
                        <TextBox Grid.Column="2" x:Name="LdsViewIdBox" Header="View (optional)" />
                        <Button Grid.Column="3" Content="Browse..." Click="BrowseLdsSource_Click" Style="{StaticResource LimSecondaryButtonStyle}" VerticalAlignment="Bottom" />
                    </Grid>
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Content="Save" Click="SaveLdsSettings_Click" Style="{StaticResource LimPrimaryButtonStyle}" />
                        <TextBlock Grid.Column="1" x:Name="LdsStatusText" Style="{StaticResource LimMutedTextStyle}" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Row="5" Margin="0,16,0,0" Style="{StaticResource LimCardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="PLANTING DATA SOURCE (AIRTABLE)" Style="{StaticResource LimSectionHeaderStyle}" />
                    <TextBlock
                        Text="The Airtable base this project imports its planting data from — used by Excel Importer and Refresh &amp; Audit whenever Airtable is the selected source. Each project can point at its own base; there's nothing to fill in if you only ever import from Excel."
                        Style="{StaticResource LimMutedTextStyle}" TextWrapping="Wrap" />
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ImportBaseIdBox" Header="Base ID" PlaceholderText="appXXXXXXXXXXXXXX" />
                        <TextBox Grid.Column="1" x:Name="ImportTableIdBox" Header="Table name or ID" />
                        <TextBox Grid.Column="2" x:Name="ImportViewIdBox" Header="View (optional)" />
                        <Button Grid.Column="3" Content="Browse..." Click="BrowseImportSource_Click" Style="{StaticResource LimSecondaryButtonStyle}" VerticalAlignment="Bottom" />
                    </Grid>
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Content="Save" Click="SaveImportSourceSettings_Click" Style="{StaticResource LimPrimaryButtonStyle}" />
                        <TextBlock Grid.Column="1" x:Name="ImportSourceStatusText" Style="{StaticResource LimMutedTextStyle}" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Row="6" Margin="0,16,0,0" Style="{StaticResource LimCardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="SHARED PARAMETER FILE" Style="{StaticResource LimSectionHeaderStyle}" />
                    <TextBlock
                        Text="The default Revit shared parameter .txt file Shared Parameter Setup opens — it still lets you browse to a different file for one-off use, but starts from here."
                        Style="{StaticResource LimMutedTextStyle}" TextWrapping="Wrap" />
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SharedParameterFilePathBox" Header="Shared parameter file" PlaceholderText="Select the Revit shared parameter .txt file" />
                        <Button Grid.Column="1" Content="Browse..." Click="BrowseSharedParameterFile_Click" Style="{StaticResource LimSecondaryButtonStyle}" VerticalAlignment="Bottom" />
                    </Grid>
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Content="Save" Click="SaveSharedParameterFile_Click" Style="{StaticResource LimPrimaryButtonStyle}" />
                        <TextBlock Grid.Column="1" x:Name="SharedParameterFileStatusText" Style="{StaticResource LimMutedTextStyle}" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
